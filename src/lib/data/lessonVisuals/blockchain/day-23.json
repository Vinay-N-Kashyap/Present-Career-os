      "partTitle": "Minting & Modifying Concentrated Positions: modifyPosition & Tick State",
      "codeHash": "ffc08283d58042908da01325d5e25f3f7edaee842af4c154039997688405042c",
      "spec": {
        "template": "sequence",
        "title": "Minting & Modifying Concentrated Positions: modifyPosition & Tick State \u2014 Concentrated Liquidity Sequence",
        "actors": [
          "Trader / LP",
          "Position Manager",
          "Uniswap v3 Pool",
          "ERC-721 Ledger"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: LP invokes Position Manager for Minting & Modifying Concentrated",
            "activeActor": "Trader / LP",
            "messages": [
              {
                "from": "Trader / LP",
                "to": "Position Manager",
                "label": "mint(params) [Tick Boundaries Specified]",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Position Manager calls pool modifyPosition; tick liquidityNet updated",
            "activeActor": "Position Manager",
            "messages": [
              {
                "from": "Position Manager",
                "to": "Uniswap v3 Pool",
                "label": "modifyPosition(tickLower, tickUpper, deltaL) [Net Checkpoint]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Pool feeGrowthInside checkpointed and ERC-721 token minted to LP",
            "activeActor": "Uniswap v3 Pool",
            "messages": [
              {
                "from": "Uniswap v3 Pool",
                "to": "ERC-721 Ledger",
                "label": "mintNFT(tokenId, owner, tickRange) [Fee Snapshot]",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Position confirmed; NFT transferred to owner with active fee accrual",
            "activeActor": "ERC-721 Ledger",
            "messages": [
              {
                "from": "ERC-721 Ledger",
                "to": "Trader / LP",
                "label": "Transfer(0x0, owner, tokenId) [Active Yield \u2713]",
                "tone": "ok"
              }
            ]
          }
        ]
      },
