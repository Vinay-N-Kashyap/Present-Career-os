      "spec": {
        "template": "sequence",
        "title": "EIP-712 Typed Structured Data Hashing & Domain Separator Architecture \u2014 Gasless Permit Sequence",
        "actors": [
          "Token Owner",
          "Gasless Relayer",
          "EIP-2612 Token Contract",
          "Protocol Spender Vault"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Owner signs off-chain EIP-712 permit for EIP-712 Typed Structured Data Ha",
            "activeActor": "Token Owner",
            "messages": [
              {
                "from": "Token Owner",
                "to": "Gasless Relayer",
                "label": "signTypedData_v4(Permit, v, r, s)",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Relayer broadcasts permit on-chain; contract recovers signer and increments nonce",
            "activeActor": "Gasless Relayer",
            "messages": [
              {
                "from": "Gasless Relayer",
                "to": "EIP-2612 Token Contract",
                "label": "permit(owner, spender, val, dl, v, r, s) [ecrecover \u2713]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Token contract verifies deadline, consumes nonce and sets allowance",
            "activeActor": "EIP-2612 Token Contract",
            "messages": [
              {
                "from": "EIP-2612 Token Contract",
                "to": "Protocol Spender Vault",
                "label": "allowance[owner][spender] = val [nonces++]",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Vault transfers tokens atomically; relayer reimbursed with zero user ETH spent",
            "activeActor": "Protocol Spender Vault",
            "messages": [
              {
                "from": "Protocol Spender Vault",
                "to": "Token Owner",
                "label": "GaslessOperationFinalized(ZeroUserEthSpent \u2713)",
                "tone": "ok"
              }
            ]
          }
        ]
