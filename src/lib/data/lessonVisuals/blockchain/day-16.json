            "at": "example",
            "caption": "Step 3: Contract triggers onERC721Received callback; reentrancy mutex armed",
            "activeActor": "Receiver Contract Hook",
            "messages": [
              {
                "from": "SafeERC20 / ERC721 Contract",
                "to": "Receiver Contract Hook",
                "label": "onERC721Received() [TSTORE Mutex Active]",
                "tone": "alert"
              },
              {
                "from": "Receiver Contract Hook",
                "to": "SafeERC20 / ERC721 Contract",
                "label": "return(0x150b7a02) [Safe Handshake \u2713]",
                "tone": "ok"
