        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Holder initiates token transfer or mint for ERC-20 Accounting Invariants & S",
            "activeActor": "Token Holder",
            "messages": [
              {
                "from": "Token Holder",
                "to": "SafeERC20 / ERC721 Contract",
                "label": "transfer(recipient, amount) / safeMint(to, id)",
