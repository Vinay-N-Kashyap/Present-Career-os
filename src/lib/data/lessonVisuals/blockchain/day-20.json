      "spec": {
        "template": "sequence",
        "title": "Diamond Multi-Facet Proxy Architecture (EIP-2535) & diamondCut Selector Routing \u2014 Modular Diamond Protocol Sequence",
        "actors": [
          "Protocol User",
          "Diamond Proxy (Router)",
          "TokenFacet (EIP-712)",
          "LendingFacet (Debt Engine)"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: User calls Diamond Proxy for Diamond Multi-Facet Proxy Archit",
            "activeActor": "Protocol User",
            "messages": [
              {
                "from": "Protocol User",
                "to": "Diamond Proxy (Router)",
                "label": "callSelector(calldata) [Unified Address]",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Diamond fallback looks up selector and delegatecalls TokenFacet in Diamond context",
            "activeActor": "Diamond Proxy (Router)",
            "messages": [
              {
                "from": "Diamond Proxy (Router)",
                "to": "TokenFacet (EIP-712)",
                "label": "delegatecall(TokenFacet) [Shared Diamond Storage]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Cross-facet routing delegates borrow action to LendingFacet with zero external call overhead",
            "activeActor": "Diamond Proxy (Router)",
            "messages": [
              {
                "from": "Diamond Proxy (Router)",
                "to": "LendingFacet (Debt Engine)",
                "label": "delegatecall(LendingFacet) [Collateral Verified \u2713]",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Diamond returns execution result to User; modular protocol state synchronized",
            "activeActor": "Diamond Proxy (Router)",
            "messages": [
              {
                "from": "Diamond Proxy (Router)",
                "to": "Protocol User",
                "label": "ExecutionComplete(ZeroCollision \u2713)",
                "tone": "ok"
              }
            ]
          }
        ]
