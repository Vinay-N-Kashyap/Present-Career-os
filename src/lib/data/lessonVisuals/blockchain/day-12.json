      "spec": {
        "template": "sequence",
        "title": "OpenZeppelin ReentrancyGuard Architecture: Non-Zero Storage Slot Economics \u2014 Reentrancy Guard Sequence",
        "actors": [
          "Caller Transaction",
          "Reentrancy Guard",
          "EVM State Controller",
          "Security Auditor"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Caller initiates function invocation for OpenZeppelin ReentrancyGuard Arc",
            "activeActor": "Caller Transaction",
            "messages": [
              {
                "from": "Caller Transaction",
                "to": "Reentrancy Guard",
                "label": "enterProtectedFunction()",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Guard inspects slot status and acquires execution lock",
            "activeActor": "Reentrancy Guard",
            "messages": [
              {
                "from": "Reentrancy Guard",
                "to": "EVM State Controller",
                "label": "acquireLock(status = ENTERED / TSTORE)",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Untrusted callee attempts recursive re-entry and is rejected",
            "activeActor": "EVM State Controller",
            "messages": [
              {
                "from": "EVM State Controller",
                "to": "Reentrancy Guard",
                "label": "reenter() -> REVERT_ALREADY_ENTERED",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Function completes and guard resets lock to clean state",
            "activeActor": "Security Auditor",
            "messages": [
              {
                "from": "Reentrancy Guard",
                "to": "EVM State Controller",
                "label": "releaseLock(status = NOT_ENTERED / TSTORE 0)",
                "tone": "ok"
              },
              {
                "from": "EVM State Controller",
                "to": "Security Auditor",
                "label": "verifyGasOptimization(300 gas \u2713)",
                "tone": "ok"
              },
              {
                "from": "Security Auditor",
                "to": "Caller Transaction",
                "label": "ReentrancyGuardCertified(Optimal \u2713)",
                "tone": "ok"
