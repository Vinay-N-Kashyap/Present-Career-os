    {
      "partTitle": "Discrete Price Ticks, Tick Spacing & Tick-to-Price Mapping",
      "codeHash": "94e769c260579b540e855b23e37da119da061bd9fe9577644b54ff4f3c3f4b7b",
      "spec": {
        "template": "sequence",
        "title": "Discrete Price Ticks, Tick Spacing & Tick-to-Price Mapping \u2014 Concentrated Liquidity Sequence",
        "actors": [
          "Trader / LP",
          "Swap Router",
          "Uniswap v3 Pool",
          "TickBitmap Index"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Trader calls Swap Router for Discrete Price Ticks, Tick Spaci",
            "activeActor": "Trader / LP",
            "messages": [
              {
                "from": "Trader / LP",
                "to": "Swap Router",
                "label": "exactInputSingle(params) [Tick Range Verified]",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Pool queries TickBitmap to find next initialized tick in direction",
            "activeActor": "Uniswap v3 Pool",
            "messages": [
              {
                "from": "Uniswap v3 Pool",
                "to": "TickBitmap Index",
                "label": "nextInitializedTickWithinOneWord(tick, lte) [O(1) BitMath]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Pool executes swap step using Q64.96 sqrtPriceX96 and virtual liquidity L",
            "activeActor": "Uniswap v3 Pool",
            "messages": [
              {
                "from": "Uniswap v3 Pool",
                "to": "Swap Router",
                "label": "computeSwapStep(sqrtP, targetP, L, fee) [Zero-Sqrt Gas]",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Swap step settled; real reserves adjusted and output tokens transferred",
            "activeActor": "Swap Router",
            "messages": [
              {
                "from": "Swap Router",
                "to": "Trader / LP",
                "label": "TokensTransferred(ConcentratedEfficiency \u2713)",
                "tone": "ok"
              }
            ]
          }
        ]
      },
