  "entries": [
    {
      "partTitle": "Spot Price Oracles & Single-Block Liquidity Manipulation",
      "codeHash": "7c6f2fb087f02b2fbb163b5ec0ac6bb485c13d0d919365987d30b4bb6cb3d8aa",
      "spec": {
        "template": "sequence",
        "title": "Spot Price Oracles & Single-Block Liquidity Manipulation \u2014 Oracle Security Sequence",
        "actors": [
          "Lending Protocol",
          "Chainlink DON Oracle",
          "Uniswap TWAP Pool",
          "Liquidation Vault"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Protocol initiates multi-oracle price query for Spot Price Oracles & Single-Bloc",
            "activeActor": "Lending Protocol",
            "messages": [
              {
                "from": "Lending Protocol",
                "to": "Chainlink DON Oracle",
                "label": "latestRoundData()",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Chainlink nodes submit threshold-signed median price with heartbeat check",
            "activeActor": "Chainlink DON Oracle",
            "messages": [
              {
                "from": "Chainlink DON Oracle",
                "to": "Lending Protocol",
                "label": "return(roundId, answer, updatedAt) [Fresh \u2713]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Protocol samples Uniswap TWAP accumulator to cross-check deviation",
            "activeActor": "Uniswap TWAP Pool",
            "messages": [
              {
                "from": "Lending Protocol",
                "to": "Uniswap TWAP Pool",
                "label": "observe(30m_window) -> return(twapPrice)",
                "tone": "data"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Dual-oracle consensus validates spread < 200 bps; liquidations proceed safely",
            "activeActor": "Liquidation Vault",
            "messages": [
              {
                "from": "Lending Protocol",
                "to": "Liquidation Vault",
                "label": "assertDeviation(spread < 2%) [Conservative Min Price]",
                "tone": "ok"
              },
              {
                "from": "Liquidation Vault",
                "to": "Lending Protocol",
                "label": "OracleConsensusApproved(Safe \u2713)",
                "tone": "ok"
              }
            ]
          }
        ]
      },
