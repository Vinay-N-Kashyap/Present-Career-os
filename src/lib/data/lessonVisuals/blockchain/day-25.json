      "spec": {
        "template": "sequence",
        "title": "Core Pool Architecture & State Storage \u2014 Concentrated DEX Capstone Sequence",
        "actors": [
          "Liquidity Provider",
          "SwapRouter",
          "UniswapV3Pool",
          "TickBitmapManager"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Protocol initializes concentrated pool state for Core Pool Architecture & State S",
            "activeActor": "Liquidity Provider",
            "messages": [
              {
                "from": "Liquidity Provider",
                "to": "SwapRouter",
                "label": "initializePool(sqrtPriceX96, tick) [Slot0 Packed]",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Router decodes tick bitmap and sets active virtual liquidity",
            "activeActor": "SwapRouter",
            "messages": [
              {
                "from": "SwapRouter",
                "to": "TickBitmapManager",
                "label": "nextInitializedTickWithinOneWord(tick, lte) [Word Traversal]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Pool executes swap step and traverses initialized tick boundary",
            "activeActor": "UniswapV3Pool",
            "messages": [
              {
                "from": "UniswapV3Pool",
                "to": "TickBitmapManager",
                "label": "crossTick(targetTick, zeroForOne) [L \u00b1 \u0394L Transition]",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Swap settled; O(1) fee growth recorded and outputs transferred",
            "activeActor": "SwapRouter",
            "messages": [
              {
                "from": "SwapRouter",
                "to": "Liquidity Provider",
                "label": "SwapSettled(FeeInsideAccrued \u2713)",
                "tone": "ok"
              }
            ]
          }
        ]
      },
