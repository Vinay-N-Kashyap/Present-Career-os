  "entries": [
    {
      "partTitle": "Collateral Valuation, Loan-to-Value (LTV) & Health Factor Mechanics",
      "codeHash": "7c53717f5140208a5e7a5f2c5e0d0a06d6e262825357dccbbb414ff43ef645e3",
      "spec": {
        "template": "sequence",
        "title": "Collateral Valuation, Loan-to-Value (LTV) & Health Factor Mechanics \u2014 Lending & Liquidation Sequence",
        "actors": [
          "Borrower Account",
          "DeFi Lending Pool",
          "Chainlink & TWAP Oracles",
          "Liquidation Keeper"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Lending pool evaluates Health Factor for Collateral Valuation, Loan-to-Va",
            "activeActor": "Borrower Account",
            "messages": [
              {
                "from": "Borrower Account",
                "to": "DeFi Lending Pool",
                "label": "borrow(debtAmount) [LTV <= 75%]",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: Dual-oracle consensus computes conservative collateral price",
            "activeActor": "Chainlink & TWAP Oracles",
            "messages": [
              {
                "from": "DeFi Lending Pool",
                "to": "Chainlink & TWAP Oracles",
                "label": "getConservativePrice(collateral)",
                "tone": "data"
              },
              {
                "from": "Chainlink & TWAP Oracles",
                "to": "DeFi Lending Pool",
                "label": "return(min(Chainlink, TWAP)) [Fresh \u2713]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Market declines; Health Factor drops below 1.0 (HF < 1.0)",
            "activeActor": "DeFi Lending Pool",
            "messages": [
              {
                "from": "DeFi Lending Pool",
                "to": "Borrower Account",
                "label": "HealthFactorAlert(HF = 0.957 [Delinquent])",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Keeper executes atomic liquidation; transient mutex armed and keeper captures profit",
            "activeActor": "Liquidation Keeper",
            "messages": [
              {
                "from": "Liquidation Keeper",
                "to": "DeFi Lending Pool",
                "label": "liquidateBorrow(50% debt) [TSTORE Mutex 1]",
                "tone": "alert"
              },
              {
                "from": "DeFi Lending Pool",
                "to": "Liquidation Keeper",
                "label": "transferSeizedCollateral(with 10% bonus)",
                "tone": "ok"
              },
              {
                "from": "DeFi Lending Pool",
                "to": "Borrower Account",
                "label": "SolvencyRestored(HF = 1.15 \u2713) [TSTORE Mutex 0]",
                "tone": "ok"
              }
            ]
          }
        ]
      },
