      "spec": {
        "template": "sequence",
        "title": "Uniswap v3 Flash Swaps & Optimistic Execution \u2014 Concentrated DEX Routing Sequence",
        "actors": [
          "Trader / LP",
          "SwapRouter",
          "UniswapV3Pool",
          "FlashCallback"
        ],
        "steps": [
          {
            "at": "intro",
            "caption": "Step 1: Trader calls SwapRouter for Uniswap v3 Flash Swaps & Optimis",
            "activeActor": "Trader / LP",
            "messages": [
              {
                "from": "Trader / LP",
                "to": "SwapRouter",
                "label": "exactInput(path, minOut) [Packed Route Verified]",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say1",
            "caption": "Step 2: SwapRouter decodes 23-byte hop slice and routes through pool",
            "activeActor": "SwapRouter",
            "messages": [
              {
                "from": "SwapRouter",
                "to": "UniswapV3Pool",
                "label": "swap(recipient, zeroForOne, amountIn) [Zero-Padding Gas]",
                "tone": "ok"
              }
            ]
          },
          {
            "at": "example",
            "caption": "Step 3: Pool executes optimistic disbursement and verifies callback repayment",
            "activeActor": "UniswapV3Pool",
            "messages": [
              {
                "from": "UniswapV3Pool",
                "to": "FlashCallback",
                "label": "uniswapV3FlashCallback(fee0, fee1) [Solvency Invariant]",
                "tone": "alert"
              }
            ]
          },
          {
            "at": "tryIt",
            "caption": "Step 4: Multi-hop settled; output transferred with slippage defense check",
            "activeActor": "SwapRouter",
            "messages": [
              {
                "from": "SwapRouter",
                "to": "Trader / LP",
                "label": "TokensTransferred(SlippageSafe \u2713)",
                "tone": "ok"
              }
            ]
          }
        ]
