      "partTitle": "Combining scores with a harmonic mean",
      "codeHash": "81b73b9d6a3186ccb9d4fc0bd8a8fee33acb0905854caaab8a8037d0d758a80e",
      "spec": {
        "template": "compare",
        "title": "Arithmetic mean versus RAGAS harmonic mean composite penalty",
        "leftLabel": "Arithmetic Mean",
        "rightLabel": "Harmonic Mean",
        "steps": [
          {
            "at": "say1",
            "caption": "Composite metric combines individual scores into a single dashboard index.",
            "left": {
              "code": "balanced scores (0.9, 0.9, 0.9)",
              "result": {
                "text": "mean 0.90"
              },
              "tone": "ok"
            },
            "right": {
              "code": "balanced scores (0.9, 0.9, 0.9)",
              "result": {
                "text": "composite 0.90"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Harmonic mean is dragged down heavily whenever any component score is weak.",
            "left": {
              "code": "unbalanced (0.9, 0.9, 0.2)",
              "result": {
                "text": "arithmetic 0.67"
              },
              "tone": "data"
            },
            "right": {
              "code": "unbalanced (0.9, 0.9, 0.2)",
              "result": {
                "text": "harmonic 0.42"
              },
              "tone": "error"
            }
          }
        ]
