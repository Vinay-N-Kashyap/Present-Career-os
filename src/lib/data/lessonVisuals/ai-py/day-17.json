      "spec": {
        "template": "compare",
        "title": "Parsing ReAct step output into action step or final answer",
        "leftLabel": "Action Step",
        "rightLabel": "Final Answer",
        "steps": [
          {
            "at": "say1",
            "caption": "Parse ReAct step returns action step or final answer.",
            "left": {
              "code": "Thought: need weather\nAction: get_weather",
              "result": {
                "text": "ACTION_STEP"
              },
              "tone": "data"
            },
            "right": {
              "code": "Thought: done\nFinal Answer: It is 31 C in Chennai.",
              "result": {
                "text": "FINAL_ANSWER"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Trap check for action input line before action line.",
            "left": {
              "code": "Action Input: Chennai",
              "result": {
                "text": "Chennai"
              },
              "tone": "data"
            },
            "right": {
              "code": "Action: get_weather",
              "result": {
                "text": "get_weather"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Parse result type field acts on action step and stops on final answer.",
            "left": {
              "code": "step = {type: ACTION_STEP, action: get_weather}",
              "result": {
                "text": "ACTION_STEP"
              },
              "tone": "data"
            },
            "right": {
              "code": "step = {type: FINAL_ANSWER, answer: Chennai}",
              "result": {
                "text": "FINAL_ANSWER"
              },
              "tone": "ok"
            }
          }
        ]
      },
