    {
      "partTitle": "LoRA: small adapters",
      "codeHash": "97dedf6bf78684c5fb7be9e9b3846e9dcaee4c8a735fe5f89db664e80dbb54a1",
      "spec": {
        "template": "compare",
        "title": "Full parameter matrix update versus low-rank factorization",
        "leftLabel": "Full Matrix",
        "rightLabel": "LoRA Factorization",
        "steps": [
          {
            "at": "say1",
            "caption": "LoRA freezes original weights and learns two thin matrices.",
            "left": {
              "code": "full update matrix stores 4 x 4 numbers",
              "result": {
                "text": "instead of"
              },
              "tone": "data"
            },
            "right": {
              "code": "low rank factorization A x B stores 4 + 4 numbers",
              "result": {
                "text": "numbers stored:"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Product A times B is full update built from fewer numbers.",
            "left": {
              "code": "quadratic parameter explosion d x d",
              "result": {
                "text": "instead of"
              },
              "tone": "data"
            },
            "right": {
              "code": "linear parameter footprint 2 x d x r",
              "result": {
                "text": "numbers stored:"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Adapter is small file allowing one base model to swap adapters.",
            "left": {
              "code": "huge duplicate base model checkpoints",
              "result": {
                "text": "instead of"
              },
              "tone": "data"
            },
            "right": {
              "code": "tiny modular adapter weights per tenant",
              "result": {
                "text": "numbers stored:"
              },
              "tone": "ok"
            }
          }
        ]
      },
