    {
      "partTitle": "Parsing a streamed chunk",
      "codeHash": "f64ba779b85af9e4bdfa494c4ad3b8f8c1ce67f1e13c9b844eb9bb41d5725bea",
      "spec": {
        "template": "compare",
        "title": "Streamed SSE chunk payload accumulation into completed response",
        "leftLabel": "Incoming Chunk",
        "rightLabel": "Accumulated Text",
        "steps": [
          {
            "at": "say1",
            "caption": "Parse SSE chunk joins content of data lines and returns text.",
            "left": {
              "code": "data: {\"choices\":[{\"delta\":{\"content\":\"Hi\"}}]}",
              "result": {
                "text": "Hi"
              },
              "tone": "data"
            },
