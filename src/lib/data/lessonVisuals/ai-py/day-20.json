              "result": {
                "text": "data: [DONE]"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Marker data [DONE] sets done while data lines are parsed.",
            "left": {
              "code": "data: {\"choices\":[{\"delta\":{\"content\":\"partial\"}}]}",
              "result": {
                "text": "partial"
              },
              "tone": "data"
            },
            "right": {
              "code": "done = True on terminal marker",
              "result": {
                "text": "data: [DONE]"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Skip lines that are not data lines such as comments.",
            "left": {
              "code": ": ping comment keep-alive line",
              "result": {
                "text": "Hi"
              },
              "tone": "idle"
            },
            "right": {
              "code": "json.loads extracts delta content",
              "result": {
                "text": "partial"
              },
              "tone": "ok"
            }
          }
