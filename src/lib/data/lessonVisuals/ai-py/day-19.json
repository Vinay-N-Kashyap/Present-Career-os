    {
      "partTitle": "Reflection: checking your own work",
      "codeHash": "fbdc6de4e5f89aa6fe054c9a01ec2598bc8a6e7678ad7b904aef3f7d98f716ec",
      "spec": {
        "template": "compare",
        "title": "Self-reflection feedback validation before and after revision",
        "leftLabel": "Initial Draft",
        "rightLabel": "Reflected Version",
        "steps": [
          {
            "at": "say1",
            "caption": "Reflection asks the model to review output against the task.",
            "left": {
              "code": "Stay at Sea Breeze Inn in Goa, rated 4.5, near the beach.",
              "result": {
                "text": "price"
              },
              "tone": "data"
            },
            "right": {
              "code": "Stay at Sea Breeze Inn in Goa, rated 4.5, near the beach. Price: 4200 rupees.",
              "result": {
                "text": "all requirements met"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Second pass uses feedback to improve the answer and fix mistakes.",
            "left": {
              "code": "missing: price requirement",
              "result": {
                "text": "price"
              },
              "tone": "error"
            },
            "right": {
              "code": "improved draft meets all criteria",
              "result": {
                "text": "all requirements met"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Reflection works best with concrete list of requirements.",
            "left": {
              "code": "requirements = [\"price\", \"Goa\", \"rated\"]",
              "result": {
                "text": "price"
              },
              "tone": "data"
            },
            "right": {
              "code": "reflect(improved, requirements)",
              "result": {
                "text": "all requirements met"
              },
              "tone": "ok"
            }
          }
        ]
      },
