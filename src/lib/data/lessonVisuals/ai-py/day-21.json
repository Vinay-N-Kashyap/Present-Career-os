    {
      "partTitle": "Validating the report",
      "codeHash": "ee71c84a69c807e7e26ba948364752762f2c442bf66a38cee7f15e60dd8c5ecf",
      "spec": {
        "template": "compare",
        "title": "Validation of cited sources and minimum report character length",
        "leftLabel": "Short / Unsourced",
        "rightLabel": "Valid Report",
        "steps": [
          {
            "at": "say1",
            "caption": "Valid report returns True only when report string exceeds length.",
            "left": {
              "code": "report = {\"report\": \"   short  \"}",
              "result": {
                "text": "   short  "
              },
              "tone": "error"
            },
            "right": {
              "code": "report = \"Sales grew 30% in 2024 [source: report-12]\"",
              "result": {
                "text": "[source:"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Real systems check that every number has a source citation.",
            "left": {
              "code": "unsourced sentences detected by regex",
              "result": {
                "text": "   short  "
              },
              "tone": "error"
            },
            "right": {
              "code": "all numeric claims cite source tags",
              "result": {
                "text": "[source:"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Never show broken report to user as if it were success.",
            "left": {
              "code": "broken report without verified data",
              "result": {
                "text": "   short  "
              },
              "tone": "error"
            },
            "right": {
              "code": "clean verified research output delivered",
              "result": {
                "text": "[source:"
              },
              "tone": "ok"
            }
          }
        ]
      },
