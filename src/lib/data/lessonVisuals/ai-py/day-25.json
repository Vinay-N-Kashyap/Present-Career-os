      "partTitle": "PagedAttention",
      "codeHash": "fce11c2db0f346af055f19a4fb352210ef14b5b3ed7228bd73fc87c2f68c387a",
      "spec": {
        "template": "compare",
        "title": "Pre-allocated contiguous buffer versus paged virtual memory allocation",
        "leftLabel": "Traditional Buffer",
        "rightLabel": "PagedAttention",
        "steps": [
          {
            "at": "say1",
            "caption": "Traditional servers reserve one big block of memory per request.",
            "left": {
              "code": "reserved_per_request = 2048 MB",
              "result": {
                "text": "2048"
              },
              "tone": "error"
            },
            "right": {
              "code": "paged_mb = 512 MB virtual pages",
              "result": {
                "text": "512"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "PagedAttention stores KV cache in small pages like virtual memory.",
            "left": {
              "code": "contiguous pre-allocation waste",
              "result": {
                "text": "2048"
              },
              "tone": "error"
            },
            "right": {
              "code": "on-demand page allocation blocks",
              "result": {
                "text": "512"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Less wasted memory allows more requests on the same GPU raising throughput.",
            "left": {
              "code": "internal fragmentation bottlenecks",
              "result": {
                "text": "2048"
              },
              "tone": "error"
            },
            "right": {
              "code": "high batch capacity concurrency",
              "result": {
                "text": "512"
              },
              "tone": "ok"
            }
          }
        ]
      },
