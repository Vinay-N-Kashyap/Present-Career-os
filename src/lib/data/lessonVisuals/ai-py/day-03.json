        "title": "Chat interaction roles and message flows",
        "actors": [
          "user",
          "assistant"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Chat messages are organized with specific roles including system and assistant.",
            "messages": [
              {
                "from": "user",
                "to": "assistant",
                "label": "What should I see?",
                "tone": "data"
              }
            ]
          },
          {
            "at": "say5",
            "caption": "Keeping roles separate helps maintain system rules isolated from user text.",
