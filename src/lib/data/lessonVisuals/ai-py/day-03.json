    {
      "partTitle": "Structuring prompts with tags",
      "codeHash": "7cfd782c313f143affe6eadb95475a44ed6196c10692ba90577dfd2283e0d0d0",
      "spec": {
        "template": "compare",
        "title": "Unstructured plain instructions versus XML tagged prompts",
        "leftLabel": "Plain Text",
        "rightLabel": "XML Tags",
        "steps": [
          {
            "at": "say1",
            "caption": "Prompts wrapped in structured tags clearly define persona rules and contracts.",
            "left": {
              "code": "You are a tax helper. Cite section number.",
              "result": {
                "text": "unstructured text"
              },
              "tone": "data"
            },
            "right": {
              "code": "<persona>tax helper</persona>",
              "result": {
                "text": "distinct tags"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Clear tag structure makes instructions unmistakable for models reading logs.",
            "left": {
              "code": "blended instructions",
              "result": {
                "text": "ambiguous boundaries"
              },
              "tone": "error"
            },
            "right": {
              "code": "<rule>Never guess.</rule>",
              "result": {
                "text": "explicit boundaries"
              },
              "tone": "ok"
            }
          }
        ]
      },
