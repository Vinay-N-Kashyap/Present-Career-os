    {
      "partTitle": "Retry with a repair prompt",
      "codeHash": "849cd27d7a84990a67bfe7e31d4e0e1a31640b795dc23f9dfc2a66fe89436d9f",
      "spec": {
        "template": "sequence",
        "title": "Automated validation failure and repair prompting sequence",
        "actors": [
          "client",
          "model"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "When validation fails asking again with clear error messages repairs the JSON.",
            "messages": [
              {
                "from": "client",
                "to": "model",
                "label": "Extract receipt info",
                "tone": "data"
              },
              {
                "from": "model",
                "to": "client",
                "label": "{\"name\": \"Asha\"}",
                "tone": "error"
              }
            ]
          },
          {
            "at": "say6",
            "caption": "A validate and retry loop ensures reliable structured output in production.",
            "messages": [
              {
                "from": "client",
                "to": "model",
                "label": "Missing age key. Reply with corrected JSON",
                "tone": "data"
              },
              {
                "from": "model",
                "to": "client",
                "label": "{\"name\": \"Asha\", \"age\": 30}",
                "tone": "ok"
              }
            ]
          }
        ]
      },
