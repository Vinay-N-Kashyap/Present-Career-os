    {
      "partTitle": "Cleaning up the model's JSON",
      "codeHash": "a7d60581803b55580ede31732de5dc99c8b14c9fff946d0aee94813baeafe03f",
      "spec": {
        "template": "compare",
        "title": "Stripping markdown code blocks from model outputs",
        "leftLabel": "Raw Output",
        "rightLabel": "Cleaned JSON",
        "steps": [
          {
            "at": "say1",
            "caption": "Models often wrap output in markdown fences or surrounding chatter.",
            "left": {
              "code": "```json\n{\"a\": 1}\n```",
              "result": {
                "text": "markdown wrapper"
              },
              "tone": "data"
            },
            "right": {
              "code": "{\"a\": 1}",
              "result": {
                "text": "clean payload"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Stripping fences if present lets json loads parse the text cleanly.",
            "left": {
              "code": "fences present",
              "result": {
                "text": "decode syntax error"
              },
              "tone": "error"
            },
            "right": {
              "code": "strip and parse",
              "result": {
                "text": "valid dict object"
              },
              "tone": "ok"
            }
          }
        ]
      },
