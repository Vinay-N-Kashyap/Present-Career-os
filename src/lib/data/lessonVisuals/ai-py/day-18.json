      "partTitle": "Supervisor versus swarm",
      "codeHash": "6498c766154d99b2ba20694fc1b9110818515894310978ea86eaadf2efc0f504",
      "spec": {
        "template": "compare",
        "title": "Supervisor central routing versus autonomous swarm handoffs",
        "leftLabel": "Supervisor Hub",
        "rightLabel": "Swarm Mesh",
        "steps": [
          {
            "at": "say1",
            "caption": "Supervisor assigns parts to specialists with central control.",
            "left": {
              "code": "supervisor -> ResearcherAgent: collect facts",
              "result": {
                "text": "supervisor"
              },
              "tone": "ok"
            },
            "right": {
              "code": "ResearcherAgent -> WriterAgent",
              "result": {
                "text": "swarm"
              },
              "tone": "data"
            }
          },
          {
            "at": "say2",
            "caption": "Swarm agents hand work directly to each other.",
            "left": {
              "code": "supervisor central plan dispatch",
              "result": {
                "text": "supervisor"
              },
              "tone": "ok"
            },
            "right": {
              "code": "direct peer agent handover transitions",
              "result": {
                "text": "swarm"
              },
              "tone": "data"
            }
          },
          {
            "at": "say3",
            "caption": "Supervisors are easier to debug and limit in business workflows.",
            "left": {
              "code": "central budget and deterministic audit log",
              "result": {
                "text": "supervisor"
              },
              "tone": "ok"
            },
            "right": {
              "code": "flexible emergent handoff delegation",
              "result": {
                "text": "swarm"
              },
              "tone": "data"
            }
          }
        ]
      },
