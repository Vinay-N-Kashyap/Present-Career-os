      "spec": {
        "template": "sequence",
        "title": "Structured message handoff between researcher and writer agents",
        "actors": [
          "ResearcherAgent",
          "WriterAgent"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "A good hand-off message says what was found and what next agent should do.",
            "messages": [
              {
                "from": "ResearcherAgent",
                "to": "WriterAgent",
                "label": {
                  "text": "findings"
                },
                "tone": "ok"
              }
            ],
            "activeActor": "ResearcherAgent"
          },
          {
            "at": "say2",
            "caption": "Use fixed structure with task findings and constraints.",
            "messages": [
              {
                "from": "ResearcherAgent",
                "to": "WriterAgent",
                "label": {
                  "text": "task"
                },
                "tone": "ok"
              }
            ],
            "activeActor": "WriterAgent"
          },
          {
            "at": "say7",
            "caption": "If a hand-off is missing a required field reject it early.",
            "messages": [
              {
                "from": "ResearcherAgent",
                "to": "WriterAgent",
                "label": {
                  "text": "REQUIRED"
                },
                "tone": "error"
              }
            ],
            "activeActor": "WriterAgent"
          }
        ]
      },
