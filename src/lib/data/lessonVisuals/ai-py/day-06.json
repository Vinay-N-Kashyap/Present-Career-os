    {
      "partTitle": "Dispatching tool calls safely",
      "codeHash": "342ec1f6b8339944b39c3e9f1e1eb441bc8296219d1b212c61280e8cd4c2f3c8",
      "spec": {
        "template": "compare",
        "title": "Tool call dispatch routing and verification",
        "leftLabel": "Undeclared Call",
        "rightLabel": "Declared Tool",
        "steps": [
          {
            "at": "say2",
            "caption": "Dispatching checks whether the tool matches a declared handler before running.",
            "left": {
              "code": "call delete_all()",
              "result": {
                "text": "UNKNOWN_TOOL"
              },
              "tone": "error"
            },
            "right": {
              "code": "call add(x=2, y=3)",
              "result": {
                "text": "success: 5"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Only functions explicitly mapped to handlers in code are permitted to run.",
            "left": {
              "code": "unmapped name",
              "result": {
                "text": "rejected by dispatcher"
              },
              "tone": "error"
            },
            "right": {
              "code": "registered handler",
              "result": {
                "text": "safely executed"
              },
              "tone": "ok"
            }
          }
        ]
      },
