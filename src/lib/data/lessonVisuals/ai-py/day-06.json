        "title": "Tool call dispatch and execution request loop",
        "actors": [
          "model",
          "app"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "The model replies with a structured tool call request for external code.",
            "messages": [
              {
                "from": "model",
                "to": "app",
                "label": "call get_order_status(A-1042)",
