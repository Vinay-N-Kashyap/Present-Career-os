    {
      "partTitle": "Backpressure Throttling Engine with Feedback Signals",
      "codeHash": "1a658121051229c8ae776949e505aaf130b1d41107e65ca18ad07f70fa88743e",
      "spec": {
        "template": "sequence",
        "title": "BackpressureCoordinator closed-loop THROTTLED_RETRY and COMMITTED flow signals",
        "actors": [
          {
            "id": "producer",
            "label": "Producer SDK"
          },
          {
            "id": "coord",
            "label": "BackpressureCoordinator"
          },
          {
            "id": "buffer",
            "label": "Ring Buffer"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When throttled, the coordinator returns THROTTLED_RETRY with backoffMs: 20.",
            "messages": [
              {
                "from": "producer",
                "to": "coord",
                "label": "handlePublish('user-1', 'tx-1') -> COMMITTED"
              },
              {
                "from": "buffer",
                "to": "coord",
                "label": "setThrottled(true)"
              },
              {
                "from": "producer",
                "to": "coord",
                "label": "handlePublish('user-2', 'tx-2') -> THROTTLED_RETRY (20ms)"
              }
            ],
            "activeActorId": "coord"
          },
          {
            "at": "say8",
            "caption": "Once drained below Low Watermark, setThrottled(false) resumes publishing.",
            "messages": [
              {
                "from": "buffer",
                "to": "coord",
                "label": "setThrottled(false)"
              },
              {
                "from": "producer",
                "to": "coord",
                "label": "handlePublish('user-3', 'tx-3') -> COMMITTED"
              }
            ],
            "activeActorId": "producer"
          }
        ]
      },
