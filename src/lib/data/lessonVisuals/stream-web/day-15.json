    {
      "partTitle": "Bounded Ring Buffer Ingestion Pool with Watermark Signatures",
      "codeHash": "36a46576e2611e24bd0fbcd46e17edd3fb53466cb79600b623596742b81edab2",
      "spec": {
        "template": "states",
        "title": "IngestionRingPool (capacity: 10) hysteresis between 0.8 High Mark and 0.4 Low Mark",
        "states": [
          {
            "id": "normalFlow",
            "label": "Normal Ingestion (throttled: false)"
          },
          {
            "id": "highThrottled",
            "label": "Throttled at High Mark (8/10)"
          },
          {
            "id": "lowCleared",
            "label": "Cleared Below Low Mark (3/10 <= 4)"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "At 0.8 High Watermark (8 items), the pool trips its throttled state.",
            "activeState": "highThrottled",
            "transition": {
              "from": "normalFlow",
              "to": "highThrottled",
              "label": "count: 8 >= highMark"
            }
          },
          {
            "at": "say8",
            "caption": "After 5 dequeues drop occupancy to 3 (<= 0.4 Low Mark), throttling clears.",
            "activeState": "lowCleared",
            "transition": {
              "from": "highThrottled",
              "to": "lowCleared",
              "label": "count: 3 <= lowMark"
            }
          }
        ]
      },
