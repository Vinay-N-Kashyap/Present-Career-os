      "partTitle": "High-Water Mark Replication Emulation & Read Isolation",
      "codeHash": "73d48e46d4a7d528ff5874c535334c3b1c7120c16b55bdb149246a6344c46372",
      "spec": {
        "template": "states",
        "title": "ReplicatedPartitionLog High-Water Mark advancement and readCommitted isolation",
        "states": [
          {
            "id": "uncommittedLEO",
            "label": "Appended (leo: 3, hwm: -1)"
          },
          {
            "id": "quorumReplicated",
            "label": "Quorum Replicated (setHighWaterMark(1))"
          },
          {
            "id": "readIsolated",
            "label": "Consumer Reads [#0:msg-0, #1:msg-1]"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Appended records enter the log as uncommitted, advancing the Log End Offset.",
            "activeState": "uncommittedLEO"
          },
          {
            "at": "say6",
            "caption": "The read engine bounds its scan strictly to offsets within the High-Water Mark.",
            "activeState": "readIsolated",
            "transition": {
              "from": "quorumReplicated",
              "to": "readIsolated",
              "label": "offset <= hwm (1)"
            }
          }
        ]
      },
