          {
            "id": "stream",
            "label": "Temperature Stream"
          },
          {
            "id": "enricher",
            "label": "NonWindowedEnricher"
          },
          {
            "id": "table",
            "label": "sensorTable Map"
          }
        ],
        "steps": [
          {
            "at": "say6",
            "caption": "The event looks up whatever value currently resides in the table at processing.",
            "messages": [
              {
                "from": "table",
                "to": "enricher",
                "label": "updateSensor('s-1', HQ Fl 2)"
              },
              {
                "from": "stream",
                "to": "enricher",
                "label": "processReading(22.4) -> HQ - Fl 2"
              }
            ],
            "activeActorId": "enricher"
          },
          {
            "at": "say8",
            "caption": "As soon as the table updates, subsequent stream events join with the new state.",
