      "partTitle": "The Dangers of Periodic Auto-Commit (enable.auto.commit)",
      "codeHash": "1a890837a5a4a0c250c5688bb8a7195351c65649506ae644f1e0bf3450bd799e",
      "spec": {
        "template": "bars",
        "title": "AutoCommitHazardSimulator silent data loss on mid-batch worker crash",
        "steps": [
          {
            "at": "say2",
            "caption": "The client library automatically commits the highest offset on a fixed timer.",
            "bars": [
              {
                "label": "Batch Fetched",
                "value": {
                  "text": "10"
                },
                "tone": "data"
              },
              {
                "label": "Auto-Committed Offset",
                "value": {
                  "text": "9"
                },
                "tone": "data"
              }
            ]
          },
          {
            "at": "say8",
            "caption": "Unprocessed messages in the batch are permanently skipped and silently lost.",
            "bars": [
              {
                "label": "Actually Processed",
                "value": {
                  "text": "4"
                },
                "tone": "ok"
              },
              {
                "label": "Silently Lost",
                "value": {
                  "text": "6"
                },
                "tone": "error"
              }
            ]
