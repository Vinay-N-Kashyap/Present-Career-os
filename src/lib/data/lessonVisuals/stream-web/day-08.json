    {
      "partTitle": "Synchronous Commits (commitSync) & Latency Trade-Offs",
      "codeHash": "a43feac4b6c6b2b89d96cb65275457c11dcecad0353573690440d85ff7d8bc1e",
      "spec": {
        "template": "sequence",
        "title": "SynchronousCommitter blocking commitSync network round-trip (15ms)",
        "actors": [
          {
            "id": "consumer",
            "label": "Consumer Thread"
          },
          {
            "id": "broker",
            "label": "Broker Coordinator"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "The commitSync method blocks the thread until the broker acknowledges commit.",
            "messages": [
              {
                "from": "consumer",
                "to": "broker",
                "label": "commitSync(offset: 100) [Thread Blocked]"
              }
            ],
            "activeActorId": "broker"
          },
          {
            "at": "say8",
            "caption": "Synchronous blocking forces the consumer thread to sit idle waiting on network.",
            "messages": [
              {
                "from": "broker",
                "to": "consumer",
                "label": "ACK Offset 100 (simulatedRttMs: 15ms)"
              }
            ],
            "activeActorId": "consumer"
          }
        ]
      },
