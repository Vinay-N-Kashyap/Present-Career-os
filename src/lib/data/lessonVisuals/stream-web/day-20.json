    {
      "partTitle": "Periodic vs Punctuated Watermark Generators",
      "codeHash": "a2a4694cd892cb98b8e226e851ea85a98b9cc0e264c914d6cea2f2c24dc94f52",
      "spec": {
        "template": "sequence",
        "title": "PeriodicWatermarkGenerator(100) vs PunctuatedWatermarkGenerator emission triggers",
        "actors": [
          {
            "id": "stream",
            "label": "Event Stream"
          },
          {
            "id": "periodicGen",
            "label": "Periodic Generator"
          },
          {
            "id": "punctuatedGen",
            "label": "Punctuated Generator"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Bounded-out-of-orderness watermarks emit max(eventTime) minus allowedLateness.",
            "messages": [
              {
                "from": "stream",
                "to": "periodicGen",
                "label": "onEvent(500), onEvent(650)"
              },
              {
                "from": "periodicGen",
                "to": "periodicGen",
                "label": "onPeriodicEmit() -> WM: 550 (650 - 100)"
              }
            ],
            "activeActorId": "periodicGen"
          },
          {
            "at": "say7",
            "caption": "When an event contains a milestone marker, a watermark is emitted immediately.",
            "messages": [
              {
                "from": "stream",
                "to": "punctuatedGen",
                "label": "id:3 (700, marker:undefined) -> null"
              },
              {
                "from": "stream",
                "to": "punctuatedGen",
                "label": "id:4 (700, isMilestoneMarker:true) -> WM: 700"
              }
            ],
            "activeActorId": "punctuatedGen"
          }
        ]
      },
