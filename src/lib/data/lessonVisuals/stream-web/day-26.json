      "partTitle": "The Schema Registry Wire Protocol: Magic Byte & Schema IDs",
      "codeHash": "5242c438e59cf7d34bdca9ba73c38c3b05ea2d43219770432c0681f830a73a53",
      "spec": {
        "template": "cells",
        "title": "encodeWireProtocol and decodeWireProtocol 5-byte Schema Registry wire frame layout",
        "steps": [
          {
            "at": "say4",
            "caption": "Byte 0 is the Magic Byte fixed to value 0 indicating Schema Registry framing.",
            "items": [
              {
                "text": "Byte 0: Magic=0"
              },
              {
                "text": "Bytes 1..4: ID=142"
              },
              {
                "text": "Byte 5+: Payload"
              }
            ],
            "pointers": [
              {
                "name": "magic:0",
                "index": 0,
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say5",
            "caption": "Bytes 1 through 4 hold the 32-bit Schema ID (142), followed by binary payload.",
            "items": [
              {
                "text": "Valid (magic:0, id:142)"
              },
              {
                "text": "Corrupt (magic:99 -> -1)"
              }
            ],
            "pointers": [
              {
                "name": "valid:true",
                "index": 0,
                "tone": "ok"
              },
              {
                "name": "valid:false",
                "index": 1,
                "tone": "error"
              }
            ]
          }
        ]
