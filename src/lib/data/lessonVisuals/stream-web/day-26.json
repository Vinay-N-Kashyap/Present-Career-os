      "partTitle": "In-Memory Schema Registry Mock & Dynamic ID Resolution",
      "codeHash": "89a6b5108e4275dd61e2aa4c366b98598e5a6e929aaed9ddc33180ffd1687be0",
      "spec": {
        "template": "sequence",
        "title": "InMemorySchemaRegistry registering user-value v1/v2 and resolving getById(1)",
        "actors": [
          {
            "id": "producer",
            "label": "Producer"
          },
          {
            "id": "registry",
            "label": "InMemorySchemaRegistry"
          },
          {
            "id": "consumer",
            "label": "Consumer"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When registering a new schema, the registry allocates an incremented ID.",
            "messages": [
              {
                "from": "producer",
                "to": "registry",
                "label": "register('user-value', v1) -> id: 1, version: 1"
              },
              {
                "from": "producer",
                "to": "registry",
                "label": "register('user-value', v2) -> id: 2, version: 2"
              }
            ],
            "activeActorId": "registry"
          },
          {
            "at": "say6",
            "caption": "Consumers use the registry to resolve Schema IDs dynamically on decode.",
            "messages": [
              {
                "from": "consumer",
                "to": "registry",
                "label": "getById(1) -> schemaJson v1"
              },
              {
                "from": "consumer",
                "to": "registry",
                "label": "getLatestVersion('user-value') -> version: 2"
              }
            ],
            "activeActorId": "consumer"
          }
        ]
      },
