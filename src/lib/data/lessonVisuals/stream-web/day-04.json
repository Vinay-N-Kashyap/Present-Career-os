    {
      "partTitle": "Detecting Sequence Gaps and Out-of-Order Anomalies in Consumers",
      "codeHash": "1c670fee099064e60a834b9a0fbb0c1017c94db63e04cb145393083654c3f4a6",
      "spec": {
        "template": "states",
        "title": "Consumer sequence gap detection and resequencing buffer drain",
        "states": [
          {
            "id": "seqProcessed",
            "label": "PROCESSED (seq: 1)"
          },
          {
            "id": "bufferedGap",
            "label": "BUFFERED_GAP (seq: 3 > 2)"
          },
          {
            "id": "gapFilled",
            "label": "Gap Filled (seq: 2 Arrives)"
          },
          {
            "id": "drainedReady",
            "label": "Ready ['step-2', 'step-3']"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When incoming sequence exceeds expected, the consumer detects a missing gap.",
            "activeState": "bufferedGap",
            "transition": {
              "from": "seqProcessed",
              "to": "bufferedGap",
              "label": "seq 3 > expected 2"
            }
          },
          {
            "at": "say8",
            "caption": "Resequencing queues hold future events until the prerequisite event arrives.",
            "activeState": "drainedReady",
            "transition": {
              "from": "gapFilled",
              "to": "drainedReady",
              "label": "Drain ['step-2', 'step-3']"
            }
          }
        ]
      },
