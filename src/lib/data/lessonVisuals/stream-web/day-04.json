    {
      "partTitle": "Out-of-Order Delivery Risks: Retries, Max-In-Flight Requests, and Pipeline Hazards",
      "codeHash": "0c13396c0e482266ae94852027bb330073098704a5933093de18b9b997c68c3e",
      "spec": {
        "template": "sequence",
        "title": "In-flight batch retry reordering when Batch 1 drops and Batch 2 commits first",
        "actors": [
          {
            "id": "producer",
            "label": "In-Flight Producer"
          },
          {
            "id": "broker",
            "label": "Broker Partition Log"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "A transient network glitch causes the first batch to fail on the wire.",
            "messages": [
              {
                "from": "producer",
                "to": "broker",
                "label": "Send Batch 1 ['msg-1', 'msg-2'] -> DROPPED"
              },
              {
                "from": "producer",
                "to": "broker",
                "label": "Send Batch 2 ['msg-3', 'msg-4'] -> COMMITTED First"
              }
            ],
            "activeActorId": "broker"
          },
          {
            "at": "say7",
            "caption": "When the producer retries the failed batch, the broker inverts message order.",
            "messages": [
              {
                "from": "producer",
                "to": "broker",
                "label": "Retry Batch 1 (attempt 2) -> Appended After Batch 2"
              }
            ],
            "activeActorId": "broker"
          }
        ]
      },
