            "label": "Replay Mode Check",
            "sublabel": "isReplayMode flag",
            "tappable": false
          },
          {
            "id": "n3",
            "label": "DB UPSERT Sink",
            "sublabel": "dbUpdated: true (always)",
            "tappable": false
          },
          {
            "id": "n4",
            "label": "Email Dispatch Gate",
            "sublabel": "Suppressed if isReplayMode",
            "tappable": false
          }
        ],
        "edges": [
          {
            "from": "n1",
            "to": "n2",
            "label": "processOrder"
