            "label": "idempotent set"
          },
          {
            "from": "n2",
            "to": "n4",
            "label": "!isReplayMode"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "During replay mode, output sink adapters disable external email mutations.",
            "activeNodes": [
              "n1",
              "n2",
              "n4"
