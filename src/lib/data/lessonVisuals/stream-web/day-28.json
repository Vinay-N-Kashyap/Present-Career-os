    {
      "partTitle": "Zero-Downtime Reprocessing with Fresh Consumer Groups",
      "codeHash": "1edcd1e7fa8f2ab7447daf09cc21b0ed4e1a2945091b7a487ee74e2765dc86cc",
      "spec": {
        "template": "states",
        "title": "Blue-Green Consumer Group Switchover Plan",
        "subtitle": "Reprocessing payment-consumer-v2 in parallel without halting live v1",
        "states": [
          {
            "id": "s1",
            "label": "1. Start payment-consumer-v2 (earliest)"
          },
          {
            "id": "s2",
            "label": "2. Drain v2 Lag to Zero [0,1,2]"
          },
          {
            "id": "s3",
            "label": "3. Blue-Green Router Cutover to v2"
          },
          {
            "id": "s4",
            "label": "4. Decommission Legacy Group v1"
          }
        ],
        "transitions": [
          {
            "from": "s1",
            "to": "s2",
            "label": "backfill"
          },
          {
            "from": "s2",
            "to": "s3",
            "label": "caught up"
          },
          {
            "from": "s3",
            "to": "s4",
            "label": "stop v1"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Deploy a fresh Consumer Group with a distinct Group ID for parallel replay.",
            "current": "s1",
            "visited": []
          },
