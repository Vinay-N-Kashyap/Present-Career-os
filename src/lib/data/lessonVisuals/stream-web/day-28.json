      "spec": {
        "template": "flow",
        "title": "SafeReplayExecutionEngine Side-Effect Guard",
        "subtitle": "Updating DB state idempotently while suppressing duplicate emails in replay mode",
        "nodes": [
          {
            "id": "n1",
            "label": "Order Event (ord-1)",
            "sublabel": "amount: 100",
            "tappable": false
          },
