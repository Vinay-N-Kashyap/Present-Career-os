      "partTitle": "Partition Assignment Cardinality: Single-Consumer Invariant",
      "codeHash": "ca8461ef748fe7af04e2555f8e8ece90df9ccf226d8a4f38550913825dddaa9f",
      "spec": {
        "template": "states",
        "title": "PartitionAssignmentValidator enforcing single-consumer cardinality invariant",
        "states": [
          {
            "id": "candidatePlan",
            "label": "Candidate Assignment Plan"
          },
          {
            "id": "conflictRejected",
            "label": "INVALID (Conflict on Partition 1)"
          },
          {
            "id": "validSerial",
            "label": "VALID (A:[0,1], B:[2])"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Each partition can be assigned to at most one consumer worker instance.",
            "activeState": "conflictRejected",
            "transition": {
              "from": "candidatePlan",
              "to": "conflictRejected",
              "label": "conflictPartition: 1"
            }
          },
          {
            "at": "say7",
            "caption": "Enforcing one active consumer per group preserves strict serial processing.",
            "activeState": "validSerial",
            "transition": {
              "from": "candidatePlan",
              "to": "validSerial",
              "label": "isValid: true"
            }
          }
        ]
      },
