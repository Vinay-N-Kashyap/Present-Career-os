    {
      "partTitle": "Dynamically Reassigning Partitions upon Worker Addition",
      "codeHash": "f1d5a27d82247d8e2b4e637f33e4d07bd164ecc9785d5e54a3e4c62100b2b711",
      "spec": {
        "template": "sequence",
        "title": "Dynamic partition migration when worker-3 joins existing workers [worker-1, worker-2]",
        "actors": [
          {
            "id": "worker3",
            "label": "New Worker (worker-3)"
          },
          {
            "id": "coordinator",
            "label": "Group Coordinator"
          },
          {
            "id": "existing",
            "label": "worker-1 & worker-2"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "When an autoscaler boots a container, the worker sends a JoinGroup request.",
            "messages": [
              {
                "from": "worker3",
                "to": "coordinator",
                "label": "JoinGroup (Expand Fleet to 3 Workers)"
              },
              {
                "from": "coordinator",
                "to": "existing",
                "label": "Revoke Partition 2 from worker-1"
              }
            ],
            "activeActorId": "coordinator"
          },
          {
            "at": "say7",
            "caption": "Once the rebalance concludes, the new consumer polls from the committed offset.",
            "messages": [
              {
                "from": "coordinator",
                "to": "worker3",
                "label": "Assign Partition 2 to worker-3"
              },
              {
                "from": "worker3",
                "to": "coordinator",
                "label": "Fetch Committed Offset & Resume Poll"
              }
            ],
            "activeActorId": "worker3"
          }
        ]
      },
