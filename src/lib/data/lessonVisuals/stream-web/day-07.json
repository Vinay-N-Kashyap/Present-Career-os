    {
      "partTitle": "Session Timeouts vs Max Poll Interval Timeouts",
      "codeHash": "3047f781cde36a0ba67b93cdeb461f4cc7bb2d9db3d73699bbe3eb8178226136",
      "spec": {
        "template": "states",
        "title": "ConsumerHealthWatchdog detecting processing thread starvation at t=350",
        "states": [
          {
            "id": "healthyPoll",
            "label": "recordPoll(100) Healthy"
          },
          {
            "id": "bgHeartbeat",
            "label": "Background Heartbeat (t=250)"
          },
          {
            "id": "pollStarved",
            "label": "Processing Starved (350 - 100 > 200)"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "A worker process can keep sending heartbeats when its business loop deadlocks.",
            "activeState": "bgHeartbeat",
            "transition": {
              "from": "healthyPoll",
              "to": "bgHeartbeat",
              "label": "recordBackgroundHeartbeat(250)"
            }
          },
          {
            "at": "say7",
            "caption": "When time between poll invocations exceeds the interval, starvation is detected.",
            "activeState": "pollStarved",
            "transition": {
              "from": "bgHeartbeat",
              "to": "pollStarved",
              "label": "exceeded max.poll.interval"
            }
          }
        ]
      },
