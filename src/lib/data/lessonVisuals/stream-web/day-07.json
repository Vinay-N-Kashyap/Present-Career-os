      "partTitle": "The Group Coordinator & Heartbeat Health Probes",
      "codeHash": "5f0c5f62455d5f45e9fa3c1161519cd563f91864690bcc4c93a5ab39cdf62083",
      "spec": {
        "template": "sequence",
        "title": "GroupCoordinator heartbeat probes and sessionTimeoutMs=50 eviction",
        "actors": [
          {
            "id": "worker1",
            "label": "worker-1 (Healthy)"
          },
          {
            "id": "worker2",
            "label": "worker-2 (Crashed)"
          },
          {
            "id": "coordinator",
            "label": "GroupCoordinator"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When the coordinator receives heartbeats, it considers the consumer healthy.",
            "messages": [
              {
                "from": "worker1",
                "to": "coordinator",
                "label": "sendHeartbeat('worker-1', 130)"
              }
            ],
            "activeActorId": "coordinator"
          },
          {
            "at": "say8",
            "caption": "Once the session timeout expires, the coordinator evicts the failed consumer.",
            "messages": [
              {
                "from": "coordinator",
                "to": "worker2",
                "label": "checkLiveness(160): Evict 'worker-2' (160 - 100 > 50)"
              }
            ],
            "activeActorId": "coordinator"
          }
        ]
      },
