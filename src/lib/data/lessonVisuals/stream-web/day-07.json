    {
      "partTitle": "Partition Revocation Callbacks & In-Flight State Flushing",
      "codeHash": "2d81721b7dda9f23b111a4d8c70a8d04949785f26aaeb322ffa420be48d9fa03",
      "spec": {
        "template": "flow",
        "title": "ResilientConsumer onPartitionsRevoked in-flight buffer flush and offset commit",
        "nodes": [
          {
            "id": "revokeHook",
            "label": "onPartitionsRevoked([1])",
            "tappable": false
          },
          {
            "id": "filterBuffer",
            "label": "Filter In-Flight Partition 1",
            "tappable": false
          },
          {
            "id": "commitOffset",
            "label": "Commit Offset 45 (order-B)",
            "tappable": false
          },
          {
            "id": "yieldPartition",
            "label": "Relinquish Partition Ownership",
            "tappable": false
          }
        ],
        "edges": [
          {
            "from": "revokeHook",
            "to": "filterBuffer",
            "label": "Intercept"
          },
          {
            "from": "filterBuffer",
            "to": "commitOffset",
            "label": "Flush State"
          },
          {
            "from": "commitOffset",
            "to": "yieldPartition",
            "label": "Clean Handoff"
          }
        ],
        "steps": [
          {
            "at": "say6",
            "caption": "The onPartitionsRevoked hook is invoked before the consumer yields ownership.",
            "activeNodes": [
              "revokeHook",
              "filterBuffer"
            ],
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Inside this hook, the application flushes caches and commits offsets.",
            "activeNodes": [
              "commitOffset",
              "yieldPartition"
            ],
            "statusBadge": "completed"
          }
        ]
      },
