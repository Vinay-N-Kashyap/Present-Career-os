        "title": "AtMostOnceConsumer pre-processing commit and permanent loss on crash at offset 2",
        "steps": [
          {
            "at": "say2",
            "caption": "When poll returns a batch, the consumer immediately commits the highest offset.",
            "items": [
              {
                "text": "0: DONE"
              },
              {
                "text": "1: DONE"
              },
              {
                "text": "2: PENDING"
              },
              {
                "text": "3: PENDING"
              },
              {
                "text": "4: COMMITTED"
