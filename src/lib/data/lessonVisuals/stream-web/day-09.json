    {
      "partTitle": "At-Least-Once Delivery: Zero Data Loss with Duplicate Ingestion",
      "codeHash": "dd97147c51ad62d52a915ed6111eacb038faa0fbde5639a0a15fe32053aed896",
      "spec": {
        "template": "sequence",
        "title": "AtLeastOnceConsumer post-processing commit and replay after Worker 1 crash",
        "actors": [
          {
            "id": "worker1",
            "label": "Worker 1 (Crashes)"
          },
          {
            "id": "broker",
            "label": "Event Broker"
          },
          {
            "id": "worker2",
            "label": "Worker 2 (Replacement)"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Only when all records in the batch are written does the consumer commit.",
            "messages": [
              {
                "from": "broker",
                "to": "worker1",
                "label": "Deliver Batch [0: $50, 1: $30, 2: $20]"
              },
              {
                "from": "worker1",
                "to": "worker1",
                "label": "Applies 0 & 1, Crashes at 2 (Committed: -1)"
              }
            ],
            "activeActorId": "worker1"
          },
          {
            "at": "say5",
            "caption": "The replacement consumer reads the previous offset and retrieves the batch.",
            "messages": [
              {
                "from": "broker",
                "to": "worker2",
                "label": "Replay Batch from Offset 0 (Zero Data Lost)"
              },
              {
                "from": "worker2",
                "to": "broker",
                "label": "Process All 3 & Commit Offset 2"
              }
            ],
            "activeActorId": "worker2"
          }
        ]
      },
