      "partTitle": "Data Compression in High-Throughput Distributed Streaming",
      "codeHash": "9011a2c5e66c1b126dc3e609bf3a68e0ae9004d29bf37c2d867c98f76f214079",
      "spec": {
        "template": "sequence",
        "title": "End-to-end producer compression, zero-decompression broker storage, and consumer decode",
        "actors": [
          {
            "id": "producer",
            "label": "Streaming Producer"
          },
          {
            "id": "broker",
            "label": "Broker Disk Segments"
          },
          {
            "id": "consumer",
            "label": "Consumer Worker"
          }
        ],
        "steps": [
          {
            "at": "say6",
            "caption": "By applying data compression, producers shrink payloads before transmission.",
            "messages": [
              {
                "from": "producer",
                "to": "broker",
                "label": "Transmit Compressed Batch (65% Byte Reduction)"
              }
            ],
            "activeActorId": "producer"
          },
          {
            "at": "say7",
            "caption": "The broker writes compressed bytes directly to disk without decompressing.",
            "messages": [
              {
                "from": "broker",
                "to": "broker",
                "label": "Append Compressed Bytes Directly to Disk"
              },
              {
                "from": "broker",
                "to": "consumer",
                "label": "Deliver Compressed Batch -> Decompress in RAM"
              }
            ],
            "activeActorId": "consumer"
          }
        ]
      },
