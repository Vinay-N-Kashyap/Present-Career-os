    {
      "partTitle": "Simulating Node Crashes & Chaos Engineering",
      "codeHash": "47d3e825923ee47682f9cf1b8db93566cdad0b1f38a532e0c7dfb5f3671b6a94",
      "spec": {
        "template": "states",
        "title": "CrashableNode chaos injection wiping volatile memoryState on crashAndWipe()",
        "states": [
          {
            "id": "aliveActive",
            "label": "isAlive: true (A:100, B:250)"
          },
          {
            "id": "sigkillWiped",
            "label": "isAlive: false (memoryState: {})"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "We ingest a stream of records into memory before terminating the instance.",
            "activeState": "aliveActive"
          },
          {
            "at": "say5",
            "caption": "When the process terminates, all volatile RAM state is wiped clean.",
            "activeState": "sigkillWiped",
            "transition": {
              "from": "aliveActive",
              "to": "sigkillWiped",
              "label": "crashAndWipe()"
            }
          }
        ]
      },
