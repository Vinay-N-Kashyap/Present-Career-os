    {
      "partTitle": "The Periodic Checkpointing Protocol",
      "codeHash": "dcbe12bc57fa7dd83987080d841bbafe7b4ec9a63099031614b55fb98117b78c",
      "spec": {
        "template": "sequence",
        "title": "CheckpointManager(2) triggering cp-1 snapshot and committing offset 11",
        "actors": [
          {
            "id": "stream",
            "label": "Stream Records"
          },
          {
            "id": "cpManager",
            "label": "CheckpointManager"
          },
          {
            "id": "blobStore",
            "label": "Durable Storage"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "The checkpointing protocol executes periodically every 2 processed records.",
            "messages": [
              {
                "from": "stream",
                "to": "cpManager",
                "label": "process(10, 'k1', 50) -> triggered: false"
              },
              {
                "from": "stream",
                "to": "cpManager",
                "label": "process(11, 'k2', 30) -> triggered: true"
              }
            ],
            "activeActorId": "cpManager"
          },
          {
            "at": "say8",
            "caption": "Atomically pairing the snapshot with committed offset 11 guides recovery.",
            "messages": [
              {
                "from": "cpManager",
                "to": "blobStore",
                "label": "createCheckpoint(11) -> cp-1 {k1:50, k2:30}"
              }
            ],
            "activeActorId": "blobStore"
          }
        ]
      },
