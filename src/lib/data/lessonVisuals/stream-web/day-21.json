    {
      "partTitle": "Changelog Topic Backing: Replicating State Mutations",
      "codeHash": "10448885819716e1067ecf85336e8df39ea98f0a69d1f7d67bfe08e195a77c95",
      "spec": {
        "template": "sequence",
        "title": "ChangelogReplicationEngine writing state mutations to localState and changelogTopic",
        "actors": [
          {
            "id": "worker",
            "label": "Stream Worker"
          },
          {
            "id": "localMap",
            "label": "localState Map"
          },
          {
            "id": "changelog",
            "label": "Changelog Topic"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "Whenever a worker performs a mutation, it writes to local store and changelog.",
            "messages": [
              {
                "from": "worker",
                "to": "localMap",
                "label": "set('account-A', 'ACTIVE')"
              },
              {
                "from": "worker",
                "to": "changelog",
                "label": "append offset #0: account-A -> ACTIVE"
              }
            ],
            "activeActorId": "worker"
          },
          {
            "at": "say7",
            "caption": "Every changelog entry captures the record key, mutated value, and offset.",
            "messages": [
              {
                "from": "worker",
                "to": "changelog",
                "label": "append offset #1: account-B -> PENDING"
              },
              {
                "from": "worker",
                "to": "changelog",
                "label": "append offset #2: account-A -> SUSPENDED"
              }
            ],
            "activeActorId": "changelog"
          }
        ]
      },
