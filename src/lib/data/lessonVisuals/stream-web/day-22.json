        "states": [
          {
            "id": "deposited",
            "label": "UPDATED (acc-1: 100, acc-2: 50)"
          },
          {
            "id": "debited",
            "label": "UPDATED (acc-1: 60 after -40)"
          },
          {
            "id": "closedZero",
            "label": "CLOSED (acc-2: 0 deleted)"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "The stream-to-table reducer accumulates deltas into current account balances.",
            "activeState": "debited",
            "transition": {
