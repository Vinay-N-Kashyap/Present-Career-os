            "at": "say4",
            "caption": "When acc-2 balance reaches 0, the ledger prunes the key to save memory.",
            "activeState": "closedZero",
            "transition": {
              "from": "debited",
              "to": "closedZero",
              "label": "acc-2 delta: -50 -> 0"
            }
          }
        ]
      },
