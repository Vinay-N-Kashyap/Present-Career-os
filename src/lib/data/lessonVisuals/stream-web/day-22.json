    {
      "partTitle": "Interactive Queries on Materialized Views",
      "codeHash": "1abac7bc18286d94bf16366c72d0c4a0fb0069cd8a0630c852ee92be2887c2a0",
      "spec": {
        "template": "sequence",
        "title": "MaterializedViewEngine serving interactive point lookups and tier queries from RAM",
        "actors": [
          {
            "id": "stream",
            "label": "Event Stream"
          },
          {
            "id": "viewEngine",
            "label": "MaterializedViewEngine"
          },
          {
            "id": "httpClient",
            "label": "HTTP Query API"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "The stream processor maintains an up-to-date KTable in local memory.",
            "messages": [
              {
                "from": "stream",
                "to": "viewEngine",
                "label": "updateState(u-10: GOLD, 850)"
              },
              {
                "from": "stream",
                "to": "viewEngine",
                "label": "updateState(u-20: SILVER, 250)"
              }
            ],
            "activeActorId": "viewEngine"
          },
          {
            "at": "say5",
            "caption": "Web servers query the stream processor local KTable directly for user state.",
            "messages": [
              {
                "from": "httpClient",
                "to": "viewEngine",
                "label": "queryUser('u-10') -> { found: true, Carol }"
              },
              {
                "from": "httpClient",
                "to": "viewEngine",
                "label": "queryByTier('GOLD') -> ['Carol']"
              }
            ],
            "activeActorId": "httpClient"
          }
        ]
      },
