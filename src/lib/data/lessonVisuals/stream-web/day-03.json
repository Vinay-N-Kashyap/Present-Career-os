    {
      "partTitle": "Flow Control: Pause, Resume, and Backpressure Mitigation in Consumers",
      "codeHash": "473c85809414cfdbe27b04f55ece817d4bb38c1096ab22172afae9b526359ed7",
      "spec": {
        "template": "states",
        "title": "Consumer backpressure flow control between highWatermark=4 and lowWatermark=1",
        "states": [
          {
            "id": "activePolling",
            "label": "Active Polling (depth: 3)"
          },
          {
            "id": "pausedState",
            "label": "Paused Polling (depth >= 4)"
          },
          {
            "id": "drainingQueue",
            "label": "Draining Buffer"
          },
          {
            "id": "resumedPolling",
            "label": "Resumed Polling (depth <= 1)"
          }
        ],
        "steps": [
          {
            "at": "say6",
            "caption": "When the processing buffer reaches threshold, the consumer calls pause.",
            "activeState": "pausedState",
            "transition": {
              "from": "activePolling",
              "to": "pausedState",
              "label": "depth 5 >= 4"
            }
          },
          {
            "at": "say9",
            "caption": "Once internal queues drain below low-water mark, the consumer invokes resume.",
            "activeState": "resumedPolling",
            "transition": {
              "from": "drainingQueue",
              "to": "resumedPolling",
              "label": "depth 1 <= 1"
            }
          }
        ]
      },
