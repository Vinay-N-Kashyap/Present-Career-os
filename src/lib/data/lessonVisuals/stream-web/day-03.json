      "partTitle": "Pull vs Push Architecture in Distributed Stream Consumption",
      "codeHash": "c10b8ff9e90b1e5fa85df455265d7b2a5a8f6dd381aa0373b752b095c871f227",
      "spec": {
        "template": "sequence",
        "title": "Pull-based consumer batch polling and self-throttled backpressure",
        "actors": [
          {
            "id": "consumer",
            "label": "PullConsumer"
          },
          {
            "id": "broker",
            "label": "Event Broker"
          }
        ],
        "steps": [
          {
            "at": "say7",
            "caption": "The consumer explicitly requests batches of records from the broker.",
            "messages": [
              {
                "from": "consumer",
                "to": "broker",
                "label": "pollBatch(batchSize: 5)"
              },
              {
                "from": "broker",
                "to": "consumer",
                "label": "Return ['evt-1', 'evt-2', 'evt-3'] (Depth: 3)"
              }
            ],
            "activeActorId": "consumer"
          },
          {
            "at": "say9",
            "caption": "Client-driven flow control prevents consumer saturation across the stream.",
            "messages": [
              {
                "from": "consumer",
                "to": "consumer",
                "label": "processOne() -> 'evt-1' (Remaining Depth: 2)"
              }
            ],
            "activeActorId": "consumer"
          }
        ]
      },
