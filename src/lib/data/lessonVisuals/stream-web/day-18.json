        "title": "PruningSlidingEngine(100, 50) watermark expiration and Map deletion at 100ms",
        "states": [
          {
            "id": "threeActive",
            "label": "3 Active Windows ([0,100), [50,150), [100,200))"
          },
          {
            "id": "expiredCheck",
            "label": "Watermark 100ms (windowEnd <= 100)"
          },
          {
            "id": "twoRetained",
            "label": "Evicted [0,100) -> 2 Active Windows"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Any window whose end boundary is less than or equal to watermark 100 expires.",
            "activeState": "expiredCheck",
            "transition": {
