    {
      "partTitle": "Modulo Partition Assignment & Handling Negative Hashes",
      "codeHash": "4e6c2271c46007e9be432b1a5006aa2b275edd3de37340020bf06adafbaa3c27",
      "spec": {
        "template": "sequence",
        "title": "Sign-bit masking with 0x7fffffff before modulo partition assignment",
        "actors": [
          {
            "id": "hasher",
            "label": "32-Bit Signed Hash"
          },
          {
            "id": "masker",
            "label": "Sign-Bit Mask (0x7fffffff)"
          },
          {
            "id": "router",
            "label": "Modulo Partitioner"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Executing hash modulo on a negative integer yields a negative partition index.",
            "messages": [
              {
                "from": "hasher",
                "to": "masker",
                "label": "Signed 32-Bit Hash (Potentially Negative)"
              }
            ],
            "activeActorId": "masker"
          },
          {
            "at": "say6",
            "caption": "The algorithm masks the sign bit using bitwise AND with 0x7fffffff first.",
            "messages": [
              {
                "from": "masker",
                "to": "router",
                "label": "positiveHash = hash & 0x7fffffff"
              },
              {
                "from": "router",
                "to": "hasher",
                "label": "Valid Index [0..2] (positiveHash % 3)"
              }
            ],
            "activeActorId": "router"
          }
        ]
      },
