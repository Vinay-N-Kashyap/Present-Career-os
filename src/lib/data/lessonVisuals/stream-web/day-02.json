    {
      "partTitle": "Implementing MurmurHash3 in Pure TypeScript",
      "codeHash": "e89dfe3c918052d44c5074c41903850242e1bb61753ac1f1488a92fe4cf2d451",
      "spec": {
        "template": "states",
        "title": "MurmurHash3 4-byte chunk mixing and final avalanche cascade",
        "states": [
          {
            "id": "chunkRead",
            "label": "4-Byte Chunk Read"
          },
          {
            "id": "rotlMix",
            "label": "Bitwise Rotate & Multiply"
          },
          {
            "id": "tailMix",
            "label": "Remainder Tail XOR"
          },
          {
            "id": "finalAvalanche",
            "label": "Final Avalanche Digest"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "It processes key byte buffers applying bitwise rotations and multipliers.",
            "activeState": "rotlMix",
            "transition": {
              "from": "chunkRead",
              "to": "rotlMix",
              "label": "imul(0xcc9e2d51)"
            }
          },
          {
            "at": "say7",
            "caption": "Uniform bit distribution prevents partition skew across available partitions.",
            "activeState": "finalAvalanche",
            "transition": {
              "from": "tailMix",
              "to": "finalAvalanche",
              "label": "h >>> 0"
            }
          }
        ]
      },
