    {
      "partTitle": "Transactional Outbox Pattern: Dual-Write Elimination",
      "codeHash": "f166529ac6c0028a6f8fb967b7a05aee98cce66f4dc94af41416a0b3c39cfee0",
      "spec": {
        "template": "flow",
