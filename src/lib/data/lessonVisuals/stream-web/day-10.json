            "at": "say7",
            "caption": "The coordinator writes a COMMIT marker to all affected partitions atomically.",
            "activeState": "committedTx",
            "transition": {
              "from": "bufferedTx",
              "to": "committedTx",
              "label": "COMMIT Marker"
            }
          }
