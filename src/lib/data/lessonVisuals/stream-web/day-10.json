        "template": "states",
        "title": "TransactionCoordinator lifecycle for tx-100 (committed) and tx-200 (aborted)",
        "states": [
          {
            "id": "beginTx",
            "label": "beginTransaction('tx-100')"
          },
          {
            "id": "bufferedTx",
            "label": "sendInTransaction (Unvisible)"
          },
          {
            "id": "committedTx",
            "label": "commitTransaction -> Visible (2)"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "The read-process-write loop executes within an atomic transaction boundary.",
            "activeState": "bufferedTx",
