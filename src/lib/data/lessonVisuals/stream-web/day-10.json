    {
      "partTitle": "Idempotent Producer Architecture: PID & Sequence Tracking",
      "codeHash": "6feaf81d2503bb97e1e30cd552e407a10f2fa35f4af93fb9095fb64677534c2e",
      "spec": {
        "template": "sequence",
        "title": "BrokerSequenceDeduplicator PID (pid-1) and sequence number validation",
        "actors": [
          {
            "id": "producer",
            "label": "Idempotent Producer (pid-1)"
          },
          {
            "id": "broker",
            "label": "BrokerSequenceDeduplicator"
          }
        ],
        "steps": [
          {
            "at": "say6",
            "caption": "When incoming sequence equals lastSequence + 1, the broker appends records.",
            "messages": [
              {
                "from": "producer",
                "to": "broker",
                "label": "append(pid-1, seq: 0, 'tx-0') -> COMMITTED"
              },
              {
                "from": "producer",
                "to": "broker",
                "label": "append(pid-1, seq: 1, 'tx-1') -> COMMITTED"
              }
            ],
            "activeActorId": "broker"
          },
          {
            "at": "say7",
            "caption": "When incoming sequence is less than or equal, the broker drops duplicates.",
            "messages": [
              {
                "from": "producer",
                "to": "broker",
                "label": "Retry append(pid-1, seq: 1, 'tx-1')"
              },
              {
                "from": "broker",
                "to": "producer",
                "label": "DUPLICATE_DROPPED (seq 1 <= lastSeq 1)"
              }
            ],
            "activeActorId": "broker"
          }
        ]
      },
