    {
      "partTitle": "Operating System Page Cache & Sequential Disk I/O Throughput",
      "codeHash": "ddc9efddb4eb1821c1d4483d9c2630d3bb50ceef76d8ced62152c1a87e21df3b",
      "spec": {
        "template": "sequence",
        "title": "OS kernel page cache write caching and zero-copy consumer retrieval",
        "actors": [
          {
            "id": "producer",
            "label": "Event Producer"
          },
          {
            "id": "pageCache",
            "label": "OS Kernel Page Cache"
          },
          {
            "id": "consumer",
            "label": "Real-Time Consumer"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "The operating system caches sequential dirty pages in available memory.",
            "messages": [
              {
                "from": "producer",
                "to": "pageCache",
                "label": "writeBlock(0) & writeBlock(1) (Dirty RAM Pages)"
              }
            ],
            "activeActorId": "pageCache"
          },
          {
            "at": "say6",
            "caption": "Streaming engines leverage zero-copy calls to transfer page cache buffers.",
            "messages": [
              {
                "from": "consumer",
                "to": "pageCache",
                "label": "readBlock(0) -> PAGE_CACHE_HIT (0.02ms)"
              },
              {
                "from": "pageCache",
                "to": "consumer",
                "label": "Zero-Copy sendfile Socket Transfer"
              }
            ],
            "activeActorId": "consumer"
          }
        ]
      },
