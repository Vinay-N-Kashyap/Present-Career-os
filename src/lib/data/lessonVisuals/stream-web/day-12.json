    {
      "partTitle": "Linger Time (linger.ms) & Batch Accumulation Mechanics",
      "codeHash": "3ffe3689804049c139ab7551afcbf051875aaefbbc2e8937941b94c1a6354914",
      "spec": {
        "template": "states",
        "title": "LingerBatchAccumulator (maxCapacity: 4, lingerMs: 20) timer evaluation",
        "states": [
          {
            "id": "batchStart",
            "label": "Batch Started (t=100, 2 Records)"
          },
          {
            "id": "waitingMore",
            "label": "WAITING_FOR_MORE (t=110, 10ms < 20ms)"
          },
          {
            "id": "lingerDispatched",
            "label": "LINGER_TIMEOUT Dispatched (t=125)"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Linger time instructs the producer to pause and wait before sending a batch.",
            "activeState": "waitingMore",
            "transition": {
              "from": "batchStart",
              "to": "waitingMore",
              "label": "evaluate(110)"
            }
          },
          {
            "at": "say7",
            "caption": "Under low load, the linger timer ensures partially filled batches dispatch.",
            "activeState": "lingerDispatched",
            "transition": {
              "from": "waitingMore",
              "to": "lingerDispatched",
              "label": "25ms >= 20ms"
            }
          }
        ]
      },
