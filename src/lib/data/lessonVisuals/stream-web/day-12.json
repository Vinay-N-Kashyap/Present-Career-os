    {
      "partTitle": "Immediate Flush Triggers: Memory Limits vs Linger Timeouts",
      "codeHash": "ba91c1510bec0e2c9988d453ab70e1585f5648b919326317a5c02e47e0dfdd66",
      "spec": {
        "template": "flow",
        "title": "MultiTriggerBatchEngine evaluation pipeline for explicit and size-limit flushes",
        "nodes": [
          {
            "id": "appendRec",
            "label": "append(bytesCount, now)",
            "tappable": false
          },
          {
            "id": "checkExplicit",
            "label": "EXPLICIT_FLUSH Check",
            "tappable": false
          },
          {
            "id": "checkSize",
            "label": "SIZE_LIMIT (110 >= 100)",
            "tappable": false
          },
          {
            "id": "flushNet",
            "label": "Dispatch Batch to Network",
            "tappable": false
          }
        ],
        "edges": [
          {
            "from": "appendRec",
            "to": "checkExplicit",
            "label": "evaluate()"
          },
          {
            "from": "checkExplicit",
            "to": "checkSize",
            "label": "Check Bytes"
          },
          {
            "from": "checkSize",
            "to": "flushNet",
            "label": "shouldFlush: true"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "When the addition of a record crosses batch.size, the batch closes immediately.",
            "activeNodes": [
              "appendRec",
              "checkSize",
              "flushNet"
            ],
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Applications can issue an explicit flush call forcing batches to dispatch.",
            "activeNodes": [
