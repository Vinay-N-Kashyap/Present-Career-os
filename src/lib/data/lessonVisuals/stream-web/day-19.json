        "states": [
          {
            "id": "s1New",
            "label": "NEW_SESSION (100ms: home)"
          },
          {
            "id": "s1Ext",
            "label": "EXTENDED (250ms: home, pricing)"
          },
          {
            "id": "s2New",
            "label": "NEW_SESSION (650ms: checkout)"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When no active session exists, a new session state record is allocated.",
            "activeState": "s1New"
          },
          {
            "at": "say6",
            "caption": "When timestamp minus lastSeen is within gapMs (300ms), the session is extended.",
            "activeState": "s1Ext",
            "transition": {
              "from": "s1New",
              "to": "s1Ext",
              "label": "delta: 150ms <= 300ms"
            }
          }
