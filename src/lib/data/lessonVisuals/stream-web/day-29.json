    {
      "partTitle": "Lag Velocity & Backlog Time-to-Recover (TTR) Mathematics",
      "codeHash": "951525821d8bf3bd71d64a5ee6b6fd8a8b4ec550d3b89745b8d01c1db2a03ab4",
      "spec": {
        "template": "table",
        "title": "Net Drain Velocity & Time-to-Recover (TTR) Matrix",
        "subtitle": "Net Drain = Consumption Rate - Production Rate; TTR = ceil(Lag / Net Drain)",
        "columns": ["Scenario", "Current Lag", "Net Drain (msg/s)", "Predicted TTR"],
        "rows": [
          ["Scenario A (Catching Up)", "10,000", "+500/s (1500 - 1000)", "20s (willRecover: true)"],
          ["Scenario B (Falling Behind)", "5,000", "-200/s (800 - 1000)", "null (willRecover: false)"],
          ["Scenario C (Zero Lag)", "0", "+500/s (1000 - 500)", "0s (willRecover: true)"]
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When Net Drain Rate is negative, the consumer backlog grows without catching up.",
            "highlightRows": [1]
          },
          {
            "at": "say6",
            "caption": "Positive Net Drain Rate means the consumer outpaces ingestion and drains lag.",
            "highlightRows": [0, 2]
          }
        ]
