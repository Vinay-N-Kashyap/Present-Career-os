      "spec": {
        "template": "compare",
        "title": "Blaming Culture versus Blameless Postmortem Practice",
        "left": {
          "title": "Blaming Culture",
          "items": [
            "Attributes failure to personal human error",
            "Creates fear of punishment and embarrassment",
            "Causes teams to conceal defects and near-misses",
            "Leaves systemic architectural holes unaddressed"
          ]
        },
        "right": {
          "title": "Blameless Practice",
          "items": [
            "Assumes good faith with current information",
            "Fosters psychological safety and transparency",
            "Treats incidents as valuable learning investments",
            "Builds automated systemic guardrails and linting"
          ]
        },
