    {
      "partTitle": "Span Attributes, Semantic Conventions & Error Statuses",
      "codeHash": "b38c683530ec9055f235c8223efe6aeef67fa8db57aed48a3afa371538265974",
      "spec": {
        "template": "compare",
        "title": "Semantic convention metadata attributes versus execution status codes",
        "left": {
          "title": "OpenTelemetry Semantic Attributes",
          "items": [
            "Standardized keys (http.method, db.system)",
            "Consistent queryability across services",
            "Powers automated service dependency maps",
            "Eliminates ad-hoc variable fragmentation"
          ]
        },
        "right": {
          "title": "Span Status Lifecycle",
          "items": [
            "UNSET represents normal initial execution",
            "OK explicitly affirms successful completion",
            "ERROR flags unhandled failures and exceptions",
            "Highlights failing spans in waterfall charts"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Semantic conventions mandate standard attribute keys across microservices.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Unhandled exceptions set span status to ERROR and attach error descriptions.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "OpenTelemetry Semantic Attributes",
        "rightLabel": "Span Status Lifecycle"
      },
