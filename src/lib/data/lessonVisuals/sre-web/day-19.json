      "partTitle": "W3C Trace Context: The traceparent Standard Format",
      "codeHash": "30acc79d3feef434312856938b5b518b9c6c5faed4e61cc8aa801be16ab95857",
      "spec": {
        "template": "sequence",
        "title": "W3C traceparent header serialization and context propagation",
        "actors": [
          "Client Ingress",
          "Edge Gateway",
          "Order Microservice"
        ],
        "messages": [
          {
            "from": "Client Ingress",
            "to": "Edge Gateway",
            "label": "HTTP GET request without trace header"
          },
          {
            "from": "Edge Gateway",
            "to": "Edge Gateway",
            "label": "Generate 00-traceId-spanId-01"
          },
          {
            "from": "Edge Gateway",
            "to": "Order Microservice",
            "label": "Forward request with traceparent"
          },
          {
            "from": "Order Microservice",
            "to": "Order Microservice",
            "label": "Extract traceId and link child span"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "The traceparent header encapsulates version, trace ID, parent ID, and flags.",
            "activeMessages": [
              0,
              1
            ]
