    {
      "partTitle": "Resource Pool Partitioning: Semaphore & Queue Bulkheads",
      "codeHash": "091376d8594539f1d045f68280417472e3d594abd2605aa50c4f3408f40236be",
      "spec": {
        "template": "compare",
        "title": "Semaphore permit counters versus dedicated thread queue bulkheads",
        "left": {
          "title": "Semaphore Bulkhead",
          "items": [
            "Atomic concurrency permit counter",
            "Zero thread context switching overhead",
            "Ideal for non-blocking asynchronous runtimes",
            "Rejects immediately on permit exhaustion"
          ]
        },
        "right": {
          "title": "Thread Queue Bulkhead",
          "items": [
            "Dedicated thread pool per dependency",
            "Bounded FIFO task queue buffering",
            "Strong OS-level CPU core isolation",
            "Higher memory footprint for thread stacks"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Semaphore bulkheads introduce zero context switching penalties in async runs.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Thread bulkheads provide CPU isolation and queueing with higher memory usage.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
