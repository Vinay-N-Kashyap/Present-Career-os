            "to": "breaker",
            "label": "Permit Granted"
          },
          {
            "from": "breaker",
            "to": "retry",
            "label": "Circuit CLOSED"
          },
          {
            "from": "retry",
            "to": "backend",
            "label": "Execute Call"
          }
