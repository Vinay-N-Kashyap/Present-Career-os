          },
          {
            "from": "Fencing Coordinator",
            "to": "Application Client",
            "label": "Issue Token with Epoch 2"
          },
          {
            "from": "Application Client",
            "to": "Regional Storage",
            "label": "Execute write with Epoch 2"
          },
