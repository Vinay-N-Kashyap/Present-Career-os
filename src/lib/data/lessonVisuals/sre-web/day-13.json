    {
      "partTitle": "Equal Jitter vs Decorrelated Jitter Strategies",
      "codeHash": "4b0c529a2c8afff1142468f57f4a06f0ec6fda03baea313ae311c61a34af507b",
      "spec": {
        "template": "compare",
        "title": "Equal jitter floor guarantees versus decorrelated prior delay scaling",
        "left": {
          "title": "Equal Jitter Strategy",
          "items": [
            "Guarantees half ceiling deterministic floor",
            "Randomizes remaining half duration",
            "Prevents premature backoff attempts",
            "Provides predictable floor delays"
          ]
        },
        "right": {
          "title": "Decorrelated Jitter Strategy",
          "items": [
            "Scales based on previous sleep delay",
            "No explicit attempt counter required",
            "Smoothly scales with queue pressure",
            "Prevents multi-client synchronization"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Engineers use Equal Jitter to guarantee a minimum sleep floor duration.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Decorrelated Jitter computes random delays scaling from previous sleep times.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
