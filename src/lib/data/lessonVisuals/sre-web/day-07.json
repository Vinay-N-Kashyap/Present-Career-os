      "partTitle": "The Problem of Infrastructure Drift in Modern Cloud",
      "codeHash": "fe4297095a9734a4c726ce26b7de75cb05609207549ef5661ea88f6c110fb82d",
      "spec": {
        "template": "compare",
        "title": "Declared version controlled state versus live drifted cloud reality",
        "left": {
          "title": "Declared Git State",
          "items": [
            "Disciplined version-controlled code",
            "Security group port 443 on internal CIDR",
            "Database class db.t3.large",
            "Single source of truth"
          ]
        },
        "right": {
          "title": "Live Cloud Reality (Drifted)",
          "items": [
            "Manual out-of-band console edits",
            "Security group opened to 0.0.0.0/0",
            "Database resized to db.m5.2xlarge",
            "Invalidates reproducible deploys"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "All cloud infrastructure changes should pass through disciplined Git pipelines.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "When live infrastructure diverges from declared code the system enters drift.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Declared Git State",
        "rightLabel": "Live Cloud Reality (Drifted)"
      },
