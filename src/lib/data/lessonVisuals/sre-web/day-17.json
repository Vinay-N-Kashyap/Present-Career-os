    {
      "partTitle": "Why Averages Lie: The Mathematics of Tail Latency",
      "codeHash": "baf49d6d609c695c3c997e08a42855bb4643913cc76837ce456a7015e615d825",
      "spec": {
        "template": "compare",
        "title": "Arithmetic average distortion versus tail percentile precision",
        "left": {
          "title": "Arithmetic Average (Mean)",
          "items": [
            "Sums observations divided by total count",
            "Dilutes severe latency spikes",
            "Masks tail outages behind low numbers",
            "Assumes normal Gaussian distribution"
          ]
        },
        "right": {
          "title": "Tail Percentiles (p95, p99)",
          "items": [
            "Isolates slowest tail observations",
            "Reveals database lock timeouts",
            "Measures true worst-case experience",
            "Accurately reflects Pareto distributions"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Arithmetic mean sums observations and treats every request with equal weight.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say9",
            "caption": "Relying on percentiles rather than averages establishes honest customer SLOs.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
