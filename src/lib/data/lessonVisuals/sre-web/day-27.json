          },
          {
            "id": "green",
            "label": "Green Idle Env"
          },
          {
            "id": "router",
            "label": "Traffic Router"
          },
          {
            "id": "blue",
            "label": "Blue Live Env"
          }
        ],
        "messages": [
          {
            "from": "ci",
            "to": "green",
            "label": "Deploy v2.0.0 & verify probes"
          },
          {
