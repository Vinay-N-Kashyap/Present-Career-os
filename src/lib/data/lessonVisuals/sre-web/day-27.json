      "partTitle": "Automated Rollback Mechanics & Safety Circuit Breakers",
      "codeHash": "1a1a4cf3c382f5538ed2a1019d126d88259b0b6990fe75b04bf233e642c0e482",
      "spec": {
        "template": "workflow",
        "title": "Automated Deployment Rollback and Pipeline Circuit Breaker",
        "nodes": [
          {
            "id": "monitor",
            "label": "Telemetry Monitor",
            "description": "Watches error rate, latency, and crashes"
          },
          {
            "id": "trip",
            "label": "Trigger Tripped",
            "description": "Detects error spike above limit"
          },
          {
            "id": "rollback",
            "label": "Automated Rollback",
            "description": "Routes traffic back to baseline"
          },
          {
            "id": "lock",
            "label": "Safety Breaker",
            "description": "Locks pipeline against retry loops"
          }
        ],
        "edges": [
          {
            "from": "monitor",
            "to": "trip",
            "label": "Breach"
          },
          {
            "from": "trip",
            "to": "rollback",
            "label": "Abort"
          },
          {
            "from": "rollback",
            "to": "lock",
            "label": "Lock Pipeline"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Controllers watch for error rate spikes, latency, and crash loops.",
