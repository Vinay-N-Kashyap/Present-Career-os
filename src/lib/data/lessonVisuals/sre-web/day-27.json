    {
      "partTitle": "Rolling Updates with maxSurge & maxUnavailable",
      "codeHash": "ff1e4563ce9c66eb230fa16732cef0bf153ecf2643ae138a71718ffb362f1896",
      "spec": {
        "template": "compare",
        "title": "Rolling Update Parameters: maxSurge versus maxUnavailable",
        "left": {
          "title": "maxSurge Parameter",
          "items": [
            "Specifies extra pods added above desired count",
            "Provisions new v2.0 replicas before deleting old",
            "Preserves full cluster throughput during rollout",
            "Requires readiness probe pass before cutover"
          ]
        },
        "right": {
          "title": "maxUnavailable Parameter",
          "items": [
            "Specifies max pods taken offline simultaneously",
            "Setting to 0% prevents capacity reduction",
            "Protects in-flight traffic during pod replacement",
            "Halts rollout if new pod fails readiness check"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Surge settings specify how many additional pods provision during rollout.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Orchestrators wait for new pods to pass readiness probes before deletion.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
