    {
      "partTitle": "Cross-Telemetry Trace & Structured Log Correlation Engine",
      "codeHash": "f58600c5235481886a62627c06259a614db88725423e2ee53a8f6f53bffda7d0",
      "spec": {
        "template": "sequence",
        "title": "Cross-Telemetry Correlation: Traces Propagated to Structured Logs",
        "actors": [
          {
            "id": "client",
            "label": "Client Ingress"
          },
          {
            "id": "gateway",
            "label": "API Gateway"
          },
          {
            "id": "payment",
            "label": "Payment Service"
          },
          {
            "id": "bus",
            "label": "Correlation Bus"
          }
        ],
        "messages": [
          {
            "from": "client",
            "to": "gateway",
            "label": "POST /checkout (Inject Trace)"
          },
          {
            "from": "gateway",
            "to": "payment",
            "label": "ChargeCard (Propagate Trace)"
          },
          {
            "from": "payment",
            "to": "bus",
            "label": "Emit error log with Trace ID"
          },
          {
            "from": "bus",
            "to": "gateway",
            "label": "Correlated trace trail returned"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "The correlation bus connects metrics to traces and structured JSON logs.",
            "highlightMessage": 0,
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Clicking a single trace ID retrieves distributed waterfalls and log streams.",
