    {
      "partTitle": "Multi-Window SLO Burn Rate & Inhibition Alerting Pipeline",
      "codeHash": "6f4875fcfe87e8fae9aacd73de7f04ec00afe393e144e9d1c3173b515bfdf603",
      "spec": {
        "template": "compare",
        "title": "Multi-Window Burn Alerting versus Upstream Alert Inhibition",
        "left": {
          "title": "Multi-Window Burn Alerting",
          "items": [
            "Evaluates short window alongside long window",
            "14.4x burn rate triggers immediate emergency page",
            "Eliminates false alarms from momentary spikes",
            "Catches rapid 2% error budget depletion accurately"
          ]
        },
        "right": {
          "title": "Upstream Alert Inhibition",
          "items": [
            "Registers root cause when primary database fails",
            "Suppresses 50+ cascading downstream timeout alerts",
            "Prevents notification storms and paging fatigue",
            "Keeps on-call focus on single root-cause system"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "High burn rates across dual observation windows trigger critical pages.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Alert inhibition mutes cascading downstream alerts during database failures.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
