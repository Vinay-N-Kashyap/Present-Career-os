            "caption": "Readiness probes determine whether containers are prepared to service requests.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Liveness probes verify whether running processes are healthy and progressing.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
