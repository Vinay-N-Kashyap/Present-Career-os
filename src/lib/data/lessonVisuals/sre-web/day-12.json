      "partTitle": "The Three Tiers of Container Health Probes",
      "codeHash": "20408de5f61e7b5494b10d429f1728c660e18226701f2bf6ce9b607fba367a02",
      "spec": {
        "template": "compare",
        "title": "Readiness traffic gating versus liveness container restart tiers",
        "left": {
          "title": "Readiness Probe Gating",
          "items": [
            "Inspects external dependencies",
            "Detaches from load balancer",
            "Suppresses user error cascades",
            "Preserves container process state"
          ]
        },
        "right": {
          "title": "Liveness Probe Restart",
          "items": [
            "Monitors internal heartbeat",
            "Detects deadlock starvation",
            "Restarts frozen containers",
            "Ignores external dependencies"
          ]
        },
        "steps": [
