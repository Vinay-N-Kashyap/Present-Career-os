      "partTitle": "Decision Tree Modeling for Automated Triage & Root Cause Isolation",
      "codeHash": "f35a743cb213b2d2b451db035b7a9b9d334800ff2f8ac762be310610a33ee324",
      "spec": {
        "template": "workflow",
        "title": "Diagnostic Decision Tree for Automated Triage",
        "nodes": [
          {
            "id": "cpu",
            "label": "Check High CPU",
            "description": "Evaluates host processor saturation"
          },
          {
            "id": "zombie",
            "label": "Check Zombie",
            "description": "Inspects runaway process state"
          },
          {
            "id": "kill",
            "label": "Kill Zombie",
            "description": "Terminates stuck process cleanly"
          },
          {
            "id": "escalate",
            "label": "Escalate to Dev",
            "description": "Pages engineer when CPU nominal"
          }
        ],
        "edges": [
          {
            "from": "cpu",
            "to": "zombie",
            "label": "highCpu = true"
          },
          {
            "from": "zombie",
            "to": "kill",
            "label": "zombie = true"
          },
          {
            "from": "cpu",
            "to": "escalate",
            "label": "highCpu = false"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Diagnostic logic is codified as a binary tree of condition nodes.",
            "activeNode": "cpu",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Traversal terminates at a leaf node that resolves or escalates.",
            "activeNode": "kill",
            "statusBadge": "completed"
          }
        ]
