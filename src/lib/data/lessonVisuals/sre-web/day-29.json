      "partTitle": "From Static Wikis to Executable Runbooks as Code",
      "codeHash": "5fb43931ea2d6ab85c5ed60c42c25adbb708a7b7ae0c866511a6eb3272b3586e",
      "spec": {
        "template": "compare",
        "title": "Static Wiki Documentation versus Executable Runbooks as Code",
        "left": {
          "title": "Static Wiki Documentation",
          "items": [
            "Drifts out of date with deprecated CLI flags",
            "Requires manual execution at 3 AM under panic",
            "Introduces human copy-paste operator errors",
            "Slow recovery extending outage duration"
          ]
        },
        "right": {
          "title": "Executable Runbooks as Code",
          "items": [
            "Version-controlled in Git and CI validated",
            "Defines explicit input and output verification",
            "Executes deterministically in milliseconds",
            "Eliminates manual panic and operator errors"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Manual execution of static runbooks introduces severe human error.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Runbooks as code are version-controlled in git and tested in pipelines.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
