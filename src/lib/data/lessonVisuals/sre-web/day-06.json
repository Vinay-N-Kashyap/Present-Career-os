      "partTitle": "The Infrastructure as Data Paradigm & Declarative State",
      "codeHash": "9ee4300f66b973e602624d4eded4de1de6830e35bda617606aa608bc7b833600",
      "spec": {
        "template": "compare",
        "title": "Imperative scripting workflows versus declarative infrastructure as data",
        "left": {
          "title": "Imperative Provisioning",
          "items": [
            "Step-by-step bash procedures",
            "Prone to non-idempotent errors",
            "Hidden side effects on failure",
            "Difficult to audit in Git"
          ]
        },
        "right": {
          "title": "Declarative Infrastructure",
          "items": [
            "Specifies target desired state",
            "Strictly typed immutable data",
            "Versionable in Git history",
            "Predictable automated drift diffing"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Imperative scripts describe the operational sequence required to reach states.",
            "highlightSide": "left",
            "statusBadge": "active"
