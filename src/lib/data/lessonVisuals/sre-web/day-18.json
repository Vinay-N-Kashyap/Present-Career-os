    {
      "partTitle": "The Perils of Unstructured Print Statements vs Structured JSON",
      "codeHash": "2dd18fbb8442173c226fa4ebe4deb9da24da457413b0f55022164c9c84d540b4",
      "spec": {
        "template": "compare",
        "title": "Unstructured plain text logs versus queryable structured JSON documents",
        "left": {
          "title": "Unstructured Plain Text",
          "items": [
            "Brittle regular expression parsing",
            "Breaks on arbitrary wording changes",
            "Slow full-text scans across gigabytes",
            "Opaque terminal strings without schema"
          ]
        },
        "right": {
          "title": "Structured JSON Document",
          "items": [
            "Discrete machine-parseable key-value fields",
            "Automatic indexing in log engines",
            "Sub-millisecond algebraic queries",
            "Standardized severity and timestamps"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Parsing plain text requires brittle regular expressions that break easily.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Structured logging emits machine parseable JSON documents for indexing.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
