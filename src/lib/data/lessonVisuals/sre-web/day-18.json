        "title": "Distributed transaction trace propagation via correlation identifiers",
        "actors": [
          "Client Ingress",
          "API Gateway",
          "Order Service",
          "Payment Service"
        ],
        "messages": [
          {
            "from": "Client Ingress",
            "to": "API Gateway",
            "label": "POST /checkout (No Correlation ID)"
