        "title": "Targeting 100 percent uptime versus pragmatic service level objectives",
        "leftLabel": "Targeting 100% Uptime",
        "rightLabel": "Targeting Pragmatic SLO",
        "leftItems": [
          "Unrealistic engineering expectation",
          "Exponential infrastructure expense",
          "Halts product feature deployment velocity",
          "Exceeds client device network reliability"
        ],
        "rightItems": [
          "Pragmatic boundary of user satisfaction",
          "Permits controlled feature release velocity",
          "Defines explicit error budget allocation",
          "Matches realistic customer network stability"
        ],
        "steps": [
