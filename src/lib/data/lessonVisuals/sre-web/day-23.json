      "partTitle": "M/M/c Multi-Server Queues & Service Rate Math",
      "codeHash": "13e43eb1f6650267ed127d6101736c0d1c2c52e51727cf855969647231299eeb",
      "spec": {
        "template": "compare",
        "title": "Isolated Single Queue versus Pooled Multi-Server Cluster",
        "left": {
          "title": "Isolated Single Queue",
          "items": [
            "Head-of-line blocking stalls all requests",
            "Single instance saturation causes hard drops",
            "Zero pooling advantage across worker nodes",
            "High variance in request wait times"
          ]
        },
        "right": {
          "title": "Pooled M/M/c Cluster Queue",
          "items": [
            "Shared queue feeds parallel worker instances",
            "Significantly shorter average wait times",
            "Survives individual node failures smoothly",
            "Scales aggregate capacity to match arrival rate"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Multi-server architectures are modeled formally as multi-server queues.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Shared queues feeding worker nodes experience shorter average wait times.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
