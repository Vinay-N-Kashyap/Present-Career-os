      "partTitle": "Histograms & Percentile Approximations (p50, p90, p99)",
      "codeHash": "f818f166a54f6e8e2a3a10e7740c77735b36100a77af5f71c87abdc18e0d8dc4",
      "spec": {
        "template": "workflow",
        "title": "Histogram request duration observation and percentile estimation",
        "nodes": [
          {
            "id": "request",
            "label": "Request Duration Sample"
          },
          {
            "id": "bucket1",
            "label": "Fast Bucket (<=20ms)"
          },
          {
            "id": "bucket2",
            "label": "Median Bucket (<=100ms)"
          },
          {
            "id": "bucket3",
            "label": "Tail Bucket (<=500ms)"
          },
          {
            "id": "percentile",
            "label": "Compute Tail Latency"
