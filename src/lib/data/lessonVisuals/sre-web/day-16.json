    {
      "partTitle": "Monotonic Counters: Rates, Deltas & Reset Handling",
      "codeHash": "84e9124932ae3115d933676f34cf08a925d84fedbadac36893e82ad0f9e3519d",
      "spec": {
        "template": "sequence",
        "title": "Counter rate calculation and process restart reset handling",
        "actors": [
          "Prometheus Scraper",
          "Counter Engine",
          "Time Series Store"
        ],
        "messages": [
          {
            "from": "Prometheus Scraper",
            "to": "Counter Engine",
            "label": "Scrape sample 1 at t=0s"
          },
          {
            "from": "Counter Engine",
            "to": "Time Series Store",
            "label": "Record counter value 100"
          },
          {
            "from": "Prometheus Scraper",
            "to": "Counter Engine",
            "label": "Scrape sample 2 at t=10s"
          },
          {
            "from": "Counter Engine",
            "to": "Time Series Store",
            "label": "Compute delta rate 50 req/s"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "Per second rates are computed by dividing counter deltas by elapsed time.",
            "activeMessages": [
              0,
              1
            ]
          },
          {
            "at": "say9",
            "caption": "Engines treat counter resets as new baselines preventing negative spikes.",
            "activeMessages": [
              2,
              3
            ]
          }
        ]
      },
