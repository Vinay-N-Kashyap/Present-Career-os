    {
      "partTitle": "Exponential and Linear Bucket Boundaries",
      "codeHash": "6abcf1950413b31e6722b0074a005889569f9c32c97150882633a1b648aea25f",
      "spec": {
        "template": "compare",
        "title": "Linear fixed step boundaries versus exponential scaling buckets",
        "left": {
          "title": "Linear Bucket Generator",
          "items": [
            "Fixed step size between boundaries",
            "Uniform granularity across entire range",
            "Ideal for tightly bounded operations",
            "Inefficient across orders of magnitude"
          ]
        },
        "right": {
          "title": "Exponential Bucket Generator",
          "items": [
            "Multiplies boundary by constant factor",
            "Fine granularity at low latencies",
            "Spans multiple orders of magnitude",
            "Standard pattern for web request tracing"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Linear buckets use fixed step sizes between boundaries for narrow ranges.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Exponential buckets provide fine resolution across orders of magnitude.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
