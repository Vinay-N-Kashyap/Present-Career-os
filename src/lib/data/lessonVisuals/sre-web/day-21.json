      "partTitle": "Measuring Operational Health: MTTD & MTTA Math",
      "codeHash": "492d11cbeef042928dae2a2caa79d0b59c901e340291862ef0ad1ee84cf38bcc",
      "spec": {
        "template": "compare",
        "title": "Mean Time to Detect versus Mean Time to Acknowledge",
        "left": {
          "title": "Mean Time to Detect (MTTD)",
          "items": [
            "Measures gap from incident start to alert trigger",
            "Reflects observability fidelity and coverage",
            "High values expose telemetry blind spots",
            "Shortened by proactive SLO burn alerts"
          ]
        },
        "right": {
          "title": "Mean Time to Acknowledge (MTTA)",
          "items": [
            "Measures elapsed time until engineer responds",
            "Reflects on-call discipline and paging policies",
            "High values indicate paging gaps or alert fatigue",
            "Shortened by automated escalation paths"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Mean time to detect measures elapsed duration before alert dispatch fires.",
