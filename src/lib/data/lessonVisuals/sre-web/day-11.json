      "partTitle": "Layer 4 vs Layer 7 Load Balancing Architecture",
      "codeHash": "e11351028b85d0bb04deb8beaf89a28f0cf6cf6b76d8a4dec6c1ced87728cb18",
      "spec": {
        "template": "compare",
        "title": "Layer 4 transport balancing versus layer 7 application proxy routing",
        "left": {
          "title": "Layer 4 Transport Balancer",
          "items": [
            "Operates at TCP and UDP layer",
            "Routes strictly by IP and port",
            "Ultra-low packet transit latency",
            "Does not decrypt TLS payloads"
          ]
        },
        "right": {
          "title": "Layer 7 Application Balancer",
          "items": [
            "Terminates HTTP and HTTPS connections",
            "Inspects headers, paths, cookies",
            "Enables canary and JWT routing",
            "Higher CPU cycles for decryption"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Transport layer balancing operates without inspecting payload contents.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Application layer balancing inspects headers and terminating connections.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Layer 4 Transport Balancer",
        "rightLabel": "Layer 7 Application Balancer"
      },
