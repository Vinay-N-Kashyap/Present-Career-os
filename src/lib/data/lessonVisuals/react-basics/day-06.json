    {
      "partTitle": "Spread with arrays: copying and adding",
      "codeHash": "f67a18fc6a841d1f96af670738537efdb7a90e5051ee7b32fe67116ce775dfd7",
      "spec": {
        "template": "compare",
        "title": "Array reference assignment versus spread cloning",
        "leftLabel": "Direct Reference",
        "rightLabel": "Spread Clone",
        "steps": [
          {
            "at": "say1",
            "caption": "Assigning an array creates a reference rather than copy.",
            "left": {
              "code": "const b = a;",
              "result": {
                "text": "b"
              },
              "tone": "warn"
            },
            "right": {
              "code": "const c = [...a];",
              "result": {
                "text": "c"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Spread operator copies items into an entirely new array.",
            "left": {
              "code": "const b = a;",
              "result": {
                "text": "b"
              },
              "tone": "warn"
            },
            "right": {
              "code": "const moreJobs = [...jobs, \"Designer\"];",
              "result": {
                "text": "\"Designer\""
              },
              "tone": "ok"
            }
          }
        ]
      },
