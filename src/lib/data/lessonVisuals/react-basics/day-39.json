    {
      "partTitle": "useDeferredValue vs setTimeout Debounce: Architectural Benchmarks",
      "codeHash": "e077ac696981d5c81773386295de4c4a53b41e8b86721c10ff6e0812c2879765",
      "spec": {
        "template": "compare",
        "title": "Fixed 300ms Debounce vs Adaptive useDeferredValue",
        "leftLabel": "Fixed 300ms setTimeout Debounce",
        "rightLabel": "Adaptive useDeferredValue",
        "steps": [
          {
            "at": "say1",
            "caption": "Fixed debounce forces 300ms of dead idle wait time even on high-end desktop hardware.",
            "left": {
              "code": "setTimeout(fn, 300); // 308ms total",
              "result": {
                "text": "\"300ms Idle Delay\""
              },
              "tone": "error"
            },
            "right": {
              "code": "useDeferredValue(query); // 9ms total",
              "result": {
                "text": "\"Instant (< 1ms delay)\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "On fast hardware, useDeferredValue delivers results over 34x faster than fixed debouncing.",
            "left": {
              "code": "console.log(speedup);",
              "result": {
                "text": "\"Baseline\""
              },
              "tone": "data"
            },
            "right": {
              "code": "console.log(speedup);",
              "result": {
                "text": "\"34.2x Faster\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "On slow mobile phones, debouncing still freezes the thread when the timer expires.",
            "left": {
              "code": "console.log(uiFreeze);",
              "result": {
                "text": "\"80ms Thread Lock\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(uiFreeze);",
              "result": {
                "text": "\"0ms (5ms Slices)\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "useDeferredValue adapts dynamically to device capability without arbitrary timer constants.",
            "left": {
              "code": "console.log(adaptability);",
              "result": {
                "text": "\"Rigid Timer\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(adaptability);",
              "result": {
                "text": "\"Fully Adaptive\""
              },
              "tone": "ok"
            }
          }
        ]
      },
