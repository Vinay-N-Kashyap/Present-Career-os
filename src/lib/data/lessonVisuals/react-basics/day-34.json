          },
          {
            "id": "t2",
            "label": "FETCHING (Token N)"
          },
          {
            "id": "t3",
            "label": "SUCCESS (Token N)"
          },
          {
            "id": "t4",
            "label": "DISCARDED (Token Stale)"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Machine starts in IDLE state with monotonic token counter initialized to zero.",
            "activeId": "t1",
            "tone": "idle"
          },
