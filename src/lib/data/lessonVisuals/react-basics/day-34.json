    {
      "partTitle": "The Boolean Explosion Problem: Why Multiple useState Flags Cause Corrupted UI",
      "codeHash": "d583ce87342ced84a22869bbbd5d38a3fe73c7a78acfa0f54786548a6d533edd",
      "spec": {
        "template": "compare",
        "title": "Boolean Explosion vs Deterministic Finite State Machine",
        "leftLabel": "Boolean Explosion (Multiple useStates)",
        "rightLabel": "Finite State Machine (useReducer)",
        "steps": [
          {
            "at": "say1",
            "caption": "Independent booleans allow 2^N state combinations, creating impossible UI states.",
            "left": {
              "code": "isLoading && isError && data",
              "result": {
                "text": "\"true && true && data (BUG!)\""
              },
              "tone": "error"
            },
            "right": {
              "code": "state.status === 'ERROR'",
              "result": {
                "text": "\"Single active state\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Adding features with boolean flags exponentially increases branching complexity.",
            "left": {
              "code": "if (isSubmitting && !isValid && isDirty)",
              "result": {
                "text": "\"Fragile condition soup\""
              },
              "tone": "error"
            },
            "right": {
              "code": "switch(action.type)",
              "result": {
                "text": "\"Exhaustive transitions\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "FSM encodes exact legal transitions, ignoring invalid actions during conflicting phases.",
            "left": {
              "code": "fetchAgain(); // races with abort",
              "result": {
                "text": "\"Race conditions!\""
              },
              "tone": "error"
            },
            "right": {
              "code": "case 'FETCH': if (status !== 'IDLE')",
              "result": {
                "text": "\"Safely ignored\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "TypeScript discriminated unions enforce type safety across distinct state variants.",
            "left": {
              "code": "state.data?.items?.[0]",
              "result": {
                "text": "\"Unsafe optional chaining\""
              },
              "tone": "data"
            },
            "right": {
              "code": "state.status === 'SUCCESS' && state.data",
              "result": {
                "text": "\"Strictly typed payload\""
              },
              "tone": "ok"
            }
          }
        ]
      },
