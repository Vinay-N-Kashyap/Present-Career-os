    {
      "partTitle": "The setTimeout Clamping Hazard: Why Browsers Enforce 4ms Minimums on Nested Timers",
      "codeHash": "af405f6e0b723d53835928f9d85e832efdaa492c43bfcae78cd64e97f9d56765",
      "spec": {
        "template": "compare",
        "title": "HTML5 Timer Clamping: setTimeout vs Macro-Task Slicing",
        "leftLabel": "Nested setTimeout (> 5 levels)",
        "rightLabel": "Zero-Latency Macro-Tasks",
        "steps": [
          {
            "at": "say1",
            "caption": "HTML5 mandates a 4ms minimum delay once setTimeout nests deeper than 5 consecutive levels.",
            "left": {
              "code": "setTimeout(fn, 0); // clamped to 4ms",
              "result": {
                "text": "\"4ms Clamped\""
              },
              "tone": "error"
            },
            "right": {
              "code": "channel.port2.postMessage(null);",
              "result": {
                "text": "\"0ms Delay\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "In a 20-slice computation, 4ms clamping introduces 60ms of dead idle time with zero CPU utilization.",
            "left": {
              "code": "console.log(wastedClampTime);",
              "result": {
                "text": "\"60ms Dead Time\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(wastedClampTime);",
              "result": {
                "text": "\"0ms Dead Time\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "MessageChannel fires as a top-priority macro-task without any artificial timer penalties.",
            "left": {
              "code": "console.log(idleOverhead);",
              "result": {
                "text": "\"60% Overhead\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(idleOverhead);",
              "result": {
                "text": "\"0% Overhead\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "React Scheduler relies on MessageChannel to guarantee instantaneous cooperative re-entry.",
            "left": {
              "code": "console.log(userExperience);",
              "result": {
                "text": "\"Laggy\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(userExperience);",
              "result": {
                "text": "\"Silky Smooth\""
              },
              "tone": "ok"
            }
          }
        ]
      },
