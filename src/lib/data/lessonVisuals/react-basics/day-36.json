    {
      "partTitle": "Building a Production MessageChannel Cooperative Task Scheduler in JavaScript",
      "codeHash": "6ec90faf6a25b2b11c4506ebf3a9aebecce10ba0f3f332febf6a443f6d73e8ce",
      "spec": {
        "template": "wireframe",
        "title": "Chrome DevTools Performance Timeline: Monolithic vs Sliced",
        "wireframe": {
          "header": "Chrome DevTools Performance Profiler",
          "controls": [
            "Total Blocking Time: 0ms",
            "Frame Rate: 60 FPS",
            "Interaction: Responsive"
          ],
          "viewport": {
            "totalHeightPx": 240,
            "renderedRange": "Main Thread: 5ms Slices [||||] (Zero Red Hatched Long Tasks)",
            "opacity": 1.0
          }
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Traditional monolithic tasks display red-hatched long task warnings exceeding 50ms.",
            "values": {
              "timeline": {
                "text": "\"Long Task: 150ms (FAIL)\""
              }
            },
            "tones": {
              "timeline": "error"
            }
          },
          {
            "at": "say2",
            "caption": "Cooperative scheduler segments execution into uniform 5ms macro-tasks.",
            "values": {
              "timeline": {
                "text": "\"5ms Slices: [||||]\""
              }
            },
            "tones": {
              "timeline": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Chrome DevTools reports Total Blocking Time (TBT) drops to exactly 0 milliseconds.",
            "values": {
              "tbt": {
                "text": "\"TBT: 0ms (PASS)\""
              }
            },
            "tones": {
              "tbt": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Interaction to Next Paint (INP) achieves top-tier score, certifying production web performance.",
            "values": {
              "inp": {
                "text": "\"INP: < 16ms (GOOD)\""
              }
