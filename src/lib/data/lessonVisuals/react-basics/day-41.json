      "partTitle": "The Server-Client Dichotomy: Why Client-Side Bundles Exploded and the Architectural Evolution of React Server Components",
      "codeHash": "be6e703ba4681684ebc950fad8abce1262c0dd45896b0d08b6fed387f12bac6d",
      "spec": {
        "template": "compare",
        "title": "Architectural Comparison: Traditional SSR vs React Server Components",
        "left": {
          "label": "Traditional SSR",
          "items": [
            "Ships 100% component code to browser",
            "Client hydrates entire DOM tree",
            "Heavy dependencies bloat bundle",
            "Double execution penalty"
          ]
        },
        "right": {
          "label": "React Server Components",
          "items": [
            "0 KB server component client bundle",
            "Only interactive islands hydrate",
            "Heavy libraries stay on Node.js",
            "Direct database & backend access"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Traditional SSR ships all component code to the client, causing severe bundle bloat and hydration delays.",
            "values": {
              "left": {
                "items": [
                  "100% Code Shipped",
                  "Mandatory Hydration",
                  "Heavy Bundles",
                  "Double Execution"
                ]
              },
              "right": {
                "items": [
                  "0 KB Server Bundle",
                  "Selective Hydration",
                  "Zero-Bundle Deps",
                  "Direct DB Access"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Server Components execute strictly on the server and are never bundled into client JavaScript.",
            "values": {
              "left": {
                "items": [
                  "Client-Side Overhead",
                  "DOM Traversal Tax",
                  "3MB Vendor Bundle",
                  "Slow TTI"
                ]
              },
              "right": {
                "items": [
                  "Zero Client Bytes",
                  "Fast Streaming",
                  "Offloaded AST",
                  "Instant TTI"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Server components access backend databases and microservices directly over high-speed internal networks.",
            "values": {
              "left": {
                "items": [
                  "REST API Boilerplate",
                  "Network Waterfalls",
                  "Manual Endpoints",
                  "Double Fetch"
                ]
              },
              "right": {
                "items": [
                  "Direct SQL / ORM",
                  "Sub-1ms Data Bus",
                  "Zero Endpoints",
                  "Single Response"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
