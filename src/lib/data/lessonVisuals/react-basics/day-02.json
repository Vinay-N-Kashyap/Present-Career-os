      "partTitle": "Changing values, and const for values that stay the same",
      "codeHash": "0dcc33047638c53ef762d4b9c8436848e217de4f79271ae1acbd15d4a1000777",
      "spec": {
        "template": "compare",
        "title": "let versus const variable reassignment",
        "leftLabel": "const (Locked)",
        "rightLabel": "let (Changeable)",
        "steps": [
          {
            "at": "say1",
            "caption": "const creates a locked variable that cannot be reassigned.",
            "left": {
              "code": "const appName = \"Job Tracker\";",
              "result": {
                "text": "\"Job Tracker\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "let jobsApplied = 2;",
              "result": {
                "text": "2"
              },
              "tone": "idle"
            }
          },
          {
            "at": "say2",
            "caption": "let allows changing values later when the application updates.",
            "left": {
              "code": "const appName = \"Job Tracker\";",
              "result": {
                "text": "\"Job Tracker\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "jobsApplied = 3;",
              "result": {
                "text": "3"
              },
              "tone": "data"
            }
          }
        ]
      },
