      "spec": {
        "template": "compare",
        "title": "Urgent Input Keystroke Lane vs Transition Filtering Lane",
        "leftLabel": "Urgent Lane (Keystroke)",
        "rightLabel": "Transition Lane (10k Rows)",
        "steps": [
          {
            "at": "say1",
            "caption": "Urgent updates echo character inputs immediately at 60 FPS without delay.",
            "left": {
              "code": "setSearchText('A');",
              "result": {
                "text": "\"Echo 'A' (0ms)\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "startTransition(() => filter(10000));",
              "result": {
                "text": "\"Scheduled\""
              },
              "tone": "idle"
            }
          },
          {
            "at": "say2",
            "caption": "Transition updates execute in the background with lower CPU priority.",
            "left": {
              "code": "console.log(urgentInput);",
              "result": {
                "text": "\"'A' rendered\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(isPending);",
              "result": {
                "text": "\"true (computing)\""
              },
              "tone": "data"
            }
          },
          {
            "at": "say3",
            "caption": "A second keystroke 'Al' arrives before the filter completes and interrupts it.",
            "left": {
              "code": "setSearchText('Al');",
              "result": {
                "text": "\"Echo 'Al' (0ms)\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log('Preempted');",
              "result": {
                "text": "\"Job Aborted\""
              },
              "tone": "data"
            }
          },
          {
            "at": "say4",
            "caption": "The background lane smoothly restarts with 'Al' and commits the final result.",
            "left": {
              "code": "console.log(urgentInput);",
              "result": {
                "text": "\"'Al' synced\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(isPending);",
              "result": {
                "text": "\"false (2500 rows)\""
              },
              "tone": "ok"
            }
          }
        ]
      },
