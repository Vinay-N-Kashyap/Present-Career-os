      "spec": {
        "template": "compare",
        "title": "Traditional SSR Waterfall vs Streaming SSR with Suspense",
        "left": {
          "label": "Traditional Blocking SSR",
          "items": [
            "All-or-nothing HTML generation",
            "TTFB blocked by slowest database query",
            "Server buffers full HTML string in RAM",
            "Delayed asset discovery & blank screen"
          ]
        },
        "right": {
          "label": "Streaming SSR with Suspense",
          "items": [
            "Immediate shell & head flush (<50ms)",
            "Decouples TTFB from slow queries",
            "Constant bounded server memory",
            "Early CSS/Font preloading & instant FCP"
          ]
        },
        "steps": [
          {
