      "partTitle": "Out-of-Order Chunk Streaming with Suspense: Boundary Placeholders and Inline Script Swapping ($RC)",
      "codeHash": "c24914c14da6d15055ac51af968d91ea2355625173d1308f9e09f9ebffd59ff4",
      "spec": {
        "template": "states",
        "title": "Out-of-Order Suspense Streaming & $RC Swapping",
        "states": [
          {
            "id": "s_fallback",
            "label": "Template Placeholder (B:0)",
            "desc": "Initial shell renders template tag and fallback skeleton."
          },
          {
            "id": "s_pending",
            "label": "Background Promise Resolution",
            "desc": "Server queries reviews database in parallel."
          },
          {
            "id": "s_chunk",
            "label": "Hidden Chunk Arrival (S:0)",
            "desc": "Resolved HTML emitted at bottom of stream with $RC script."
          },
          {
            "id": "s_swapped",
            "label": "DOM Replacement Executed",
            "desc": "$RC swaps B:0 skeleton with S:0 live reviews seamlessly."
          }
        ],
