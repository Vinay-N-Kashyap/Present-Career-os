    {
      "partTitle": "Beyond Boolean Flag Spaghetti: Why Complex Multi-Step UIs Demand Deterministic State Transition Tables",
      "codeHash": "41bc00181094ec1e1a560fc52c2113b246513efc1707592145d5f8fcd0e45788",
      "spec": {
        "template": "compare",
        "title": "Boolean Flag Spaghetti vs Deterministic Finite State Automata",
        "left": {
          "label": "Scattered Boolean Flags",
          "items": [
            "2^N exponential combinatorial explosion",
            "Impossible states (isLoading && isError)",
            "Silent edge-case bugs in production",
            "Unmaintainable cascading if-else statements"
          ]
        },
        "right": {
          "label": "Finite State Machine (FSM)",
          "items": [
            "Strict mutually exclusive state set",
            "Mathematical impossibility of invalid states",
            "Deterministic state transition matrix",
            "Self-documenting architectural clarity"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Boolean state management creates 2^N potential states, inviting impossible combinations.",
            "values": {
              "left": {
                "items": [
                  "8 Flags = 256 States",
                  "Hidden Combinations",
                  "Spaghetti Conditionals",
                  "Race Conditions"
                ]
              },
              "right": {
                "items": [
                  "4 Explicit States",
                  "Zero Hidden Modes",
                  "Declarative Transitions",
                  "100% Predictable"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Stale network responses can set isSuccess and isError to true at the exact same time.",
            "values": {
              "left": {
                "items": [
                  "isSuccess = true",
                  "isError = true",
                  "Broken UI Spinner",
                  "Angry User Tickets"
                ]
              },
              "right": {
                "items": [
                  "State: SUCCESS",
                  "Ignores Stale Errors",
                  "Clean Consistent UI",
                  "Rock-Solid UX"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "FSM transition guards structurally block invalid actions based on mathematical logic.",
            "values": {
              "left": {
                "items": [
                  "Unvalidated Actions",
                  "Duplicate Submissions",
                  "Ghost Mutations",
                  "Corrupted DB"
                ]
              },
              "right": {
                "items": [
                  "Guarded Transitions",
                  "Blocked Double Clicks",
                  "Clean Event Audit",
                  "Protected Database"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Statecharts reduce production edge-case bug reports by over 90% in enterprise apps.",
            "values": {
              "left": {
                "items": [
                  "High Bug Churn",
                  "Fragile Hotfixes",
                  "Fear of Refactoring",
                  "Flaky Test Suite"
                ]
              },
              "right": {
                "items": [
                  "Zero State Bugs",
                  "Robust Refactoring",
                  "High Confidence",
                  "Deterministic Tests"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          }
        ]
      }
