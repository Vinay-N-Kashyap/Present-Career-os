      "partTitle": "Urgent vs Non-Urgent Updates: The Anatomy of Main-Thread UI Freezes",
      "codeHash": "5f69fe88ec45914af4d8fe0a980a3edcb9a3ecae526b5a2a2c19499b2a22edda",
      "spec": {
        "template": "compare",
        "title": "Synchronous Blocking setState vs Dual-Priority useTransition",
        "leftLabel": "Legacy Synchronous setState",
        "rightLabel": "useTransition Dual Priority",
        "steps": [
          {
            "at": "say1",
            "caption": "Legacy React treats all state updates as urgent, locking the main thread during heavy renders.",
            "left": {
              "code": "setQuery(text); // Locks thread for 150ms",
              "result": {
                "text": "\"150ms UI Freeze\""
              },
              "tone": "error"
            },
            "right": {
              "code": "startTransition(() => setQuery(text));",
              "result": {
                "text": "\"Non-blocking\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Typing drops multiple frames in synchronous updates; useTransition preserves 60 FPS typing.",
            "left": {
              "code": "console.log(droppedFrames);",
              "result": {
                "text": "\"6 Dropped Frames\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(droppedFrames);",
              "result": {
                "text": "\"0 Dropped Frames\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "useTransition splits updates: text updates instantly in SyncLane, filter runs in TransitionLane.",
            "left": {
              "code": "console.log(lanes);",
              "result": {
                "text": "\"Single Urgent Lane\""
              },
              "tone": "data"
            },
            "right": {
              "code": "console.log(lanes);",
              "result": {
                "text": "\"SyncLane + TransLane\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "The application achieves flawless Core Web Vitals INP scores under heavy computational loads.",
            "left": {
              "code": "console.log(inpScore);",
              "result": {
                "text": "\"Poor (> 200ms)\""
