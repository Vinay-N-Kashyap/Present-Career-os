    {
      "partTitle": "Safe Zero-Eval Block Formula Engine & DAG Dependency Resolution",
      "codeHash": "20aeae60f5d329249d409b25af7949e68950d7fdaaabea2a6076065456270460",
      "spec": {
        "template": "states",
        "title": "Formula Evaluation DAG Dependency States",
        "states": [
          {
            "id": "clean",
            "label": "CELL_CLEAN",
            "desc": "Calculated value matches current dependencies",
            "active": true
          },
          {
            "id": "dirty",
            "label": "CELL_DIRTY",
            "desc": "Upstream cell changed; flagged for recalculation",
            "active": false
          },
          {
            "id": "evaluating",
            "label": "EVALUATING",
            "desc": "Executing sandboxed topological formula pass",
            "active": false
          },
          {
            "id": "resolved",
            "label": "RESOLVED",
            "desc": "New numeric result cached in LRU table",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "clean",
            "to": "dirty",
            "label": "UPSTREAM_MUTATED"
          },
          {
            "from": "dirty",
            "to": "evaluating",
            "label": "DAG_SORT_TRIGGER"
          },
          {
            "from": "evaluating",
            "to": "resolved",
            "label": "CALCULATION_DONE"
          },
          {
            "from": "resolved",
            "to": "clean",
            "label": "CACHE_STORED"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Formula cells rest in CELL_CLEAN state with cached results.",
            "values": {
              "clean": {
                "active": true
              },
              "dirty": {
                "active": false
              },
              "evaluating": {
                "active": false
              },
              "resolved": {
                "active": false
              }
            },
            "tones": {
              "clean": "ok",
              "dirty": "idle",
              "evaluating": "idle",
              "resolved": "idle"
            }
          },
          {
            "at": "say2",
            "caption": "Mutating an input value transitions downstream dependent cells to CELL_DIRTY.",
            "values": {
              "clean": {
                "active": false
              },
              "dirty": {
                "active": true
              },
              "evaluating": {
                "active": false
              },
              "resolved": {
                "active": false
              }
            },
            "tones": {
              "clean": "idle",
              "dirty": "warn",
              "evaluating": "idle",
              "resolved": "idle"
            }
          },
          {
            "at": "say3",
            "caption": "Topological sort evaluates cells in strict acyclic order within 1.5ms.",
            "values": {
              "clean": {
                "active": false
              },
              "dirty": {
                "active": false
              },
              "evaluating": {
                "active": true
              },
              "resolved": {
                "active": false
              }
            },
            "tones": {
              "clean": "idle",
              "dirty": "idle",
              "evaluating": "data",
              "resolved": "idle"
            }
          },
          {
            "at": "say4",
            "caption": "Calculated values resolve and cache, returning all cells to CELL_CLEAN.",
            "values": {
              "clean": {
                "active": true
              },
              "dirty": {
                "active": false
              },
              "evaluating": {
                "active": false
              },
              "resolved": {
                "active": true
              }
            },
            "tones": {
              "clean": "ok",
              "dirty": "idle",
              "evaluating": "idle",
              "resolved": "ok"
            }
          }
        ]
      }
    },
