    {
      "partTitle": "Building a Production 31-Bit Bitmask Lane Scheduler in Pure JavaScript",
      "codeHash": "e758ad37826445e2200aa2a09a8807a543e5e1bdc6adf4ceff25666e5c3c3aa9",
      "spec": {
        "template": "wireframe",
        "title": "31-Bit Bitmask Lane Scheduler Register Monitor",
        "wireframe": {
          "header": "Fiber Root Lane Registers",
          "controls": [
            "pendingLanes: [0b00010101]",
            "expiredLanes: [0b00000000]",
            "Active: SyncLane (Bit 0)"
          ],
          "viewport": {
            "totalHeightPx": 200,
            "renderedRange": "Priority: SyncLane preempting DefaultLane and TransitionLane",
            "opacity": 1.0
          }
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Fiber root tracks pending updates in a 31-bit integer register pendingLanes.",
            "values": {
              "registers": {
                "text": "\"pending: 0b00010100\""
              }
            },
            "tones": {
              "registers": "data"
            }
          },
          {
            "at": "say2",
            "caption": "Urgent SyncLane arrives; bitwise OR sets bit 0 (pending becomes 0b00010101).",
            "values": {
              "registers": {
                "text": "\"pending: 0b00010101\""
              }
            },
            "tones": {
              "registers": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "lanes & -lanes isolates bit 0; SyncLane preempts all background rendering.",
            "values": {
              "preemption": {
                "text": "\"Preempted to Bit 0\""
              }
            },
            "tones": {
              "preemption": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Upon commit, bitwise AND with NOT clears bit 0, restoring background lanes.",
            "values": {
              "registers": {
                "text": "\"pending: 0b00010100\""
              }
            },
            "tones": {
              "registers": "data"
            }
