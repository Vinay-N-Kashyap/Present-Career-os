    {
      "partTitle": "From Numeric Priorities to Bitmasks: The Limitations of Integer Priority Levels",
      "codeHash": "0691df8160239138fcb8c879770b63ca0c7ef5800cd732d32329d5802e107bec",
      "spec": {
        "template": "compare",
        "title": "Priority Models: Scalar Integers vs 31-bit Bitmask Lanes",
        "leftLabel": "Scalar Integer Priorities (1-5)",
        "rightLabel": "31-Bit Bitmask Lanes (React 18)",
        "steps": [
          {
            "at": "say1",
            "caption": "Scalar integers cannot represent multi-priority sets without allocating dynamic Heap objects.",
            "left": {
              "code": "const taskSet = new Set([2, 3]);",
              "result": {
                "text": "\"Heap Allocated\""
              },
              "tone": "error"
            },
            "right": {
              "code": "const taskLanes = 0b0110;",
              "result": {
                "text": "\"Small Integer (SMI)\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Bitmask lanes merge multiple priority categories in a single CPU clock cycle using bitwise OR.",
            "left": {
              "code": "taskSet.add(4);",
              "result": {
                "text": "\"O(1) Set Mutation\""
              },
              "tone": "data"
            },
            "right": {
              "code": "lanes |= 0b1000;",
              "result": {
                "text": "\"1 CPU Instruction\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Testing lane membership executes instantly with bitwise AND, zero memory allocation.",
            "left": {
              "code": "taskSet.has(target);",
              "result": {
                "text": "\"Function Call\""
              },
              "tone": "data"
            },
            "right": {
              "code": "(lanes & target) !== 0;",
              "result": {
                "text": "\"TEST EAX, EBX\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "31-bit bitmasks completely eliminate garbage collection churn in the hot reconciliation loop.",
            "left": {
              "code": "console.log(gcPauses);",
              "result": {
                "text": "\"GC Overhead\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(gcPauses);",
              "result": {
                "text": "\"Zero Allocations\""
              },
              "tone": "ok"
            }
          }
        ]
      },
