      "partTitle": "Never change state directly",
      "codeHash": "cf9c60cada1385e3c5d7965de210d02e85fcc5291a0f51f9159bf4c1ec360c50",
      "spec": {
        "template": "compare",
        "title": "Direct array mutation versus new array reference",
        "leftLabel": "Mutation (Ignored)",
        "rightLabel": "New Array Copy",
        "steps": [
          {
            "at": "say1",
            "caption": "Never mutate state directly because React cannot detect the modification.",
            "left": {
              "code": "sameArray.push(\"Tester\");",
              "result": {
                "text": "true"
              },
              "tone": "warn"
            },
            "right": {
              "code": "const newArray = [...jobs, \"Designer\"];",
              "result": {
                "text": "false"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Spread creates a new array reference that tells React state changed.",
            "left": {
              "code": "console.log(sameArray === jobs);",
              "result": {
                "text": "true"
              },
              "tone": "warn"
            },
            "right": {
              "code": "console.log(newArray === jobs);",
              "result": {
                "text": "false"
              },
              "tone": "ok"
            }
          }
        ]
      },
