    {
      "partTitle": "Double Buffering: Current vs Work-in-Progress Trees and Atomic DOM Commit",
      "codeHash": "a6a5df0e3c7259be34b906b0965bcf83ad7c579ad2c12dd2ac8ba45f9e8e4397",
      "spec": {
        "template": "compare",
        "title": "Dual-Buffering: current Tree vs workInProgress Tree",
        "leftLabel": "Current Tree (Screen)",
        "rightLabel": "WorkInProgress Tree (Memory)",
        "steps": [
          {
            "at": "say1",
            "caption": "The current tree represents what is physically visible on screen.",
            "left": {
              "code": "console.log(current.stateNode);",
              "result": {
                "text": "\"Mounted DOM\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(workInProgress);",
              "result": {
                "text": "\"null\""
              },
              "tone": "idle"
            }
          },
          {
            "at": "say2",
            "caption": "Updates construct alternate fiber clones in memory without touching the live screen.",
            "left": {
              "code": "console.log(current.stateNode);",
              "result": {
                "text": "\"Mounted DOM\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(workInProgress.state);",
              "result": {
                "text": "\"Drafting v2\""
              },
              "tone": "data"
            }
          },
          {
            "at": "say3",
            "caption": "Fiber nodes reuse unchanged subtrees through alternate pointers to prevent GC thrashing.",
            "left": {
              "code": "console.log(current.memoizedProps);",
              "result": {
                "text": "\"Props v1\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(workInProgress.memoizedProps);",
              "result": {
                "text": "\"Props v2\""
              },
              "tone": "data"
            }
          },
          {
            "at": "say4",
            "caption": "Upon completion, React flips the root pointer to swap workInProgress into current instantly.",
            "left": {
              "code": "console.log(root.current);",
              "result": {
                "text": "\"Swapped to v2\""
              },
              "tone": "idle"
            },
            "right": {
              "code": "console.log(root.current);",
              "result": {
                "text": "\"Now Active\""
              },
              "tone": "ok"
            }
          }
        ]
      },
