    {
      "partTitle": "Distributed Token-Bucket Rate Limiting & Abuse Prevention with Sliding Windows",
      "codeHash": "28ccdab0c29fb7a34c276d3e257cd624f5bc4833da5e5ca90c047b7c04b4b439",
      "spec": {
        "template": "states",
        "title": "Sliding Token Bucket Rate Limiter State Machine",
        "states": [
          {
            "id": "normal_flow",
            "label": "NORMAL_FLOW (Tokens > 50%)"
          },
          {
            "id": "burst_drain",
            "label": "BURST_DRAIN (Tokens < 20%)"
          },
          {
            "id": "blocked_429",
            "label": "BLOCKED_429 (Tokens = 0)"
          },
          {
            "id": "replenished",
            "label": "REPLENISHED (Tokens = Max)"
          }
        ],
        "transitions": [
          {
            "from": "normal_flow",
            "to": "burst_drain",
            "label": "High request volume"
          },
          {
            "from": "burst_drain",
            "to": "blocked_429",
            "label": "Bucket exhausted"
          },
          {
            "from": "blocked_429",
            "to": "replenished",
            "label": "Window expires & refills"
          },
          {
            "from": "replenished",
            "to": "normal_flow",
            "label": "Steady state restored"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Rate limiter starts in NORMAL_FLOW with full token capacity available.",
            "values": {
              "normal_flow": {
                "status": "ACTIVE"
              },
              "burst_drain": {
                "status": "INACTIVE"
              },
              "blocked_429": {
                "status": "INACTIVE"
              },
              "replenished": {
                "status": "INACTIVE"
              }
            },
            "tones": {
              "normal_flow": "ok",
              "burst_drain": "idle",
              "blocked_429": "idle",
              "replenished": "idle"
            }
          },
          {
            "at": "say2",
            "caption": "A sudden burst of user actions rapidly consumes tokens from the edge bucket.",
            "values": {
              "normal_flow": {
                "status": "INACTIVE"
              },
              "burst_drain": {
                "status": "ACTIVE (12 Tokens Left)"
              },
              "blocked_429": {
                "status": "INACTIVE"
              },
              "replenished": {
                "status": "INACTIVE"
              }
            },
            "tones": {
              "normal_flow": "idle",
              "burst_drain": "error",
              "blocked_429": "idle",
              "replenished": "idle"
            }
          },
          {
            "at": "say3",
            "caption": "When the bucket empties, edge immediately returns HTTP 429 with Retry-After header.",
            "values": {
              "normal_flow": {
                "status": "INACTIVE"
              },
              "burst_drain": {
                "status": "INACTIVE"
              },
              "blocked_429": {
                "status": "ACTIVE (HTTP 429 Issued)"
              },
              "replenished": {
                "status": "INACTIVE"
              }
            },
            "tones": {
              "normal_flow": "idle",
              "burst_drain": "idle",
              "blocked_429": "error",
              "replenished": "idle"
            }
          },
          {
            "at": "say4",
            "caption": "Tokens replenish automatically over time, restoring normal routing without server reboot.",
            "values": {
              "normal_flow": {
                "status": "ACTIVE (Restored)"
              },
              "burst_drain": {
                "status": "INACTIVE"
              },
              "blocked_429": {
                "status": "INACTIVE"
              },
              "replenished": {
                "status": "100% Capacity"
              }
            },
            "tones": {
              "normal_flow": "ok",
              "burst_drain": "idle",
              "blocked_429": "idle",
              "replenished": "ok"
            }
          }
        ]
      }
