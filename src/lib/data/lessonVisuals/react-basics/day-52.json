      "spec": {
        "template": "compare",
        "title": "Serverless Node.js Container vs Edge Runtime V8 Isolate",
        "left": {
          "label": "Node.js Serverless Container (AWS Lambda)",
          "items": [
            "Heavy container cold start (250ms - 1,200ms)",
            "Requires centralized origin VPC routing",
            "Node native C++ bindings supported",
            "High memory footprint (128MB - 1GB)"
          ]
        },
        "right": {
          "label": "Edge Runtime V8 Isolate (Vercel / Cloudflare)",
          "items": [
            "Sub-millisecond cold start (< 2ms)",
            "Runs on 300+ edge Points of Presence",
            "Strict Web Standard APIs (Fetch, Web Crypto)",
            "Ultra-lean memory footprint (4MB - 16MB)"
          ]
        },
