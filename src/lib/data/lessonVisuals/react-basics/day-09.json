    {
      "partTitle": "Passing props",
      "codeHash": "9656184d080a06eb50c2ab0b798743b2b27d0ec7651cf7f69146041af5f47ddb",
      "spec": {
        "template": "compare",
        "title": "String attributes versus numeric expression props",
        "leftLabel": "String Prop",
        "rightLabel": "Numeric Prop",
        "steps": [
          {
            "at": "say1",
            "caption": "Props accept strings in quotes and expressions in curly braces.",
            "left": {
              "code": "const props = { title: \"Tester\", salary: \"300000\" };",
              "result": {
                "text": "\"300000\""
              },
              "tone": "warn"
            },
            "right": {
              "code": "const fixed = { title: \"Tester\", salary: 300000 };",
              "result": {
                "text": "300000"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Passing a string in quotes causes unexpected maths instead of numbers.",
            "left": {
              "code": "console.log(props.salary + 50000);",
              "result": {
                "text": "\"300000\""
              },
              "tone": "warn"
            },
            "right": {
              "code": "console.log(fixed.salary + 50000);",
              "result": {
                "text": "300000"
              },
              "tone": "ok"
            }
          }
        ]
      },
