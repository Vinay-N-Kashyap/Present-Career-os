    {
      "partTitle": "useDeferredValue vs Debounce and Throttle: Adaptive Scheduling vs Arbitrary Milliseconds",
      "codeHash": "c48384572a7c9bc36aabe2d34b77e108d46e0cc57fc30369894857324e042936",
      "spec": {
        "template": "compare",
        "title": "useDeferredValue vs Timer-Based Debounce & Throttle",
        "leftLabel": "Timer-Based Debounce",
        "rightLabel": "React useDeferredValue",
        "steps": [
          {
            "at": "say1",
            "caption": "Debounce introduces fixed artificial delays regardless of whether the CPU is idle.",
            "left": {
              "code": "setTimeout(filter, 300);",
              "result": {
                "text": "\"Always waits 300ms\""
              },
              "tone": "idle"
            },
            "right": {
              "code": "const def = useDeferredValue(q);",
              "result": {
                "text": "\"Adapts to device CPU\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "On fast devices, useDeferredValue re-renders almost immediately without 300ms dead time.",
            "left": {
              "code": "console.log(latency);",
              "result": {
                "text": "\"Laggy feel\""
              },
              "tone": "data"
            },
            "right": {
              "code": "console.log(latency);",
              "result": {
                "text": "\"Near instant\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "On slow devices, useDeferredValue yields cooperatively to keep user input responsive.",
            "left": {
              "code": "console.log(freeze);",
              "result": {
                "text": "\"Can still freeze UI\""
              },
              "tone": "error"
            },
            "right": {
              "code": "console.log(freeze);",
              "result": {
                "text": "\"No freeze (interruptible)\""
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "useDeferredValue requires zero timer cleanup logic, eliminating memory leaks.",
            "left": {
              "code": "clearTimeout(timerId);",
              "result": {
                "text": "\"Manual cleanup\""
              },
              "tone": "idle"
            },
            "right": {
              "code": "// Handled by React",
              "result": {
                "text": "\"Automatic GC\""
              },
              "tone": "ok"
            }
          }
        ]
      },
