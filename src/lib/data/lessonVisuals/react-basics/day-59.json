    {
      "partTitle": "Reliability, Disaster Recovery & Multi-Region Fallback Router",
      "codeHash": "2f1deb59be21be81537f0d902804ab9a2c85a9ccbfa6cd401e8d2d133a0164dc",
      "spec": {
        "template": "states",
        "title": "Edge Circuit Breaker Finite State Machine",
        "states": [
          {
            "id": "closed",
            "label": "CIRCUIT_CLOSED",
            "desc": "Normal operation; traffic routes to primary origin",
            "active": true
          },
          {
            "id": "tripping",
            "label": "FAILURE_BURST",
            "desc": "Consecutive error threshold exceeded (>=2)",
            "active": false
          },
          {
            "id": "open",
            "label": "CIRCUIT_OPEN",
            "desc": "Primary origin bypassed; traffic routes to failover region",
            "active": false
          },
          {
            "id": "half_open",
            "label": "HALF_OPEN",
            "desc": "Canary probing to verify primary recovery",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "closed",
            "to": "tripping",
            "label": "ERROR_503"
          },
          {
            "from": "tripping",
            "to": "open",
            "label": "THRESHOLD_MET"
          },
          {
            "from": "open",
            "to": "half_open",
            "label": "PROBE_TIMER"
          },
          {
            "from": "half_open",
            "to": "closed",
            "label": "CANARY_SUCCESS"
          }
        ],
        "steps": [
          {
            "at": "say1",
