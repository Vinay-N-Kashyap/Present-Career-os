        "template": "compare",
        "title": "Logical AND short circuit evaluation in JSX",
        "leftLabel": "Boolean Condition",
        "rightLabel": "Numeric Falsy Trap",
        "steps": [
          {
            "at": "say1",
            "caption": "Use logical AND to show an extra piece like a badge.",
            "left": {
              "code": "console.log(true && \"Offer!\");",
              "result": {
                "text": "\"Offer!\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(false && \"Offer!\");",
              "result": {
                "text": "false"
              },
              "tone": "idle"
            }
          },
          {
            "at": "say3",
            "caption": "Using zero with logical AND displays zero instead of hiding content.",
            "left": {
              "code": "console.log(0 && \"You have jobs\");",
              "result": {
                "text": "0"
              },
              "tone": "warn"
            },
            "right": {
              "code": "console.log(0 > 0 && \"You have jobs\");",
              "result": {
                "text": "false"
              },
              "tone": "ok"
            }
          }
        ]
