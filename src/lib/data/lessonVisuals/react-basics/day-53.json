      "partTitle": "The Rendering Spectrum: Static Site Generation (SSG), SSR, ISR vs Partial Prerendering (PPR)",
      "codeHash": "4a0468769bbd29fea04eed288cce58456373aae3ebb08533635271ff2ede4bae",
      "spec": {
        "template": "compare",
        "title": "Standard SSR vs Partial Prerendering (PPR) Streaming Architecture",
        "left": {
          "label": "Standard SSR (Blocking Server)",
          "items": [
            "Server waits for slowest database query",
            "High Time to First Byte (TTFB 800ms+)",
            "Users stare at blank white screen",
            "Complete re-render of static navigation chrome"
          ]
        },
        "right": {
          "label": "Partial Prerendering (PPR) with Static Shell",
          "items": [
            "Instant static shell served from edge (< 20ms)",
            "Immediate First Contentful Paint (FCP)",
            "Dynamic holes stream concurrently via Suspense",
            "Cumulative Layout Shift (CLS) = 0.000"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Standard SSR delays the entire response until the slowest dynamic query resolves.",
            "values": {
