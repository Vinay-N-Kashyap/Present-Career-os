      "spec": {
        "template": "compare",
        "title": "Isolating invalid inputs with regression assertions",
        "leftLabel": "Valid Format",
        "rightLabel": "Malformed Input",
        "steps": [
          {
            "at": "say1",
            "caption": "Good tests focus on cases that are easy to get wrong like empty text.",
            "left": {
              "code": "console.log(isValidEmail(\"asha@mail.com\"));",
              "result": {
                "text": "\"asha@mail.com\""
              },
              "tone": "ok"
            },
            "right": {
              "code": "console.log(isValidEmail(\"asha.mail.com\"));",
              "result": {
                "text": "\"asha.mail.com\""
              },
              "tone": "err"
            }
          },
          {
