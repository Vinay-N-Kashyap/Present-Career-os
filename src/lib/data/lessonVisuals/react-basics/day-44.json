      "partTitle": "The Evolution of React Mutations: From Imperative Fetch Handlers and Redux Thunks to Declarative Server Actions",
      "codeHash": "368623c8d9dd2824a022758dbedc17d0f787ec8a8b8eda342cd2cb91e74ef7d0",
      "spec": {
        "template": "compare",
        "title": "Mutation Paradigms: Classical REST APIs vs React Server Actions",
        "left": {
          "label": "Classical REST Mutations",
          "items": [
            "Manual onSubmit preventDefault",
            "Custom fetch POST & JSON serialization",
            "Dedicated API route & middleware",
            "Double round trip (Mutate + Re-fetch)"
          ]
        },
        "right": {
          "label": "React Server Actions ('use server')",
          "items": [
            "Direct <form action={fn}> binding",
            "Native FormData & zero serialization",
            "Zero API endpoints or routing tables",
            "Single round trip (Mutate + RSC Revalidate)"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Classical REST requires extensive boilerplate: event handlers, fetch wrappers, and API controllers.",
            "values": {
              "left": {
                "items": [
                  "24 Lines Boilerplate",
                  "Manual JSON",
                  "Custom Endpoints",
                  "Double Fetch"
                ]
              },
              "right": {
                "items": [
                  "3 Lines Code",
                  "Native FormData",
                  "Zero Endpoints",
                  "Single Response"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Server Actions eliminate manual endpoints: asynchronous server functions are called directly from JSX.",
            "values": {
              "left": {
                "items": [
                  "API Drift",
                  "Manual Types",
                  "Broken Scripts",
                  "No Fallback"
                ]
              },
              "right": {
                "items": [
                  "Inferred Types",
                  "100% Type-Safe",
                  "Automatic RPC",
                  "Zero-JS Ready"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Server Actions integrate with RSC cache revalidation, updating the UI in a single network round trip.",
            "values": {
              "left": {
                "items": [
                  "Two Round Trips",
                  "Stale UI Caches",
                  "Manual Query Keys",
                  "Race Conditions"
                ]
              },
              "right": {
                "items": [
                  "One Round Trip",
                  "revalidatePath()",
                  "Server Authority",
                  "Atomic Update"
                ]
              }
            },
            "tones": {
              "left": "error",
              "right": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Server Actions reduce mutation boilerplate by 88% while providing automated CSRF protection.",
            "values": {
              "left": {
                "items": [
                  "18ms Overhead",
                  "Complex Auth",
                  "Redux Sagas",
                  "High Friction"
                ]
              },
              "right": {
                "items": [
                  "2ms Overhead",
