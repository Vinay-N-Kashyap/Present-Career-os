    {
      "partTitle": "Idempotent Consumer & Deduplication Engine: Processing with State Consistency",
      "codeHash": "67e507b4482f1d1d52fe147618394c8b07c64caaa5bece1a40f2e3f6242f2d85",
      "spec": {
        "template": "states",
        "title": "Idempotent Consumer Deduplication State Machine",
        "states": [
          {
            "id": "new_msg",
            "label": "New Message (execute mutation & save key)"
          },
          {
            "id": "dupe_msg",
            "label": "Duplicate Detected (skip execution, commit offset)"
          },
          {
            "id": "committed",
            "label": "Offset Committed Cleanly"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "executeIdempotentConsumer receives incoming message batch.",
            "values": {
              "new_msg": {
                "active": true
              },
              "dupe_msg": {
                "active": false
              },
              "committed": {
                "active": false
              }
            }
          },
          {
            "at": "say3",
            "caption": "Message with duplicate key key_001 is intercepted by deduplication store.",
            "values": {
              "new_msg": {
                "active": false
              },
              "dupe_msg": {
                "active": true
              },
              "committed": {
                "active": false
              }
            }
          },
          {
            "at": "say5",
            "caption": "Duplicate business execution bypassed while offset commit succeeds.",
            "values": {
              "new_msg": {
                "active": false
              },
              "dupe_msg": {
                "active": true
              },
              "committed": {
                "active": true
              }
            }
          },
          {
            "at": "say7",
            "caption": "New keys key_002 and key_003 execute mutations and store keys atomically.",
            "values": {
              "new_msg": {
                "active": true
              },
              "dupe_msg": {
                "active": false
              },
              "committed": {
                "active": true
              }
            }
          }
        ]
      }
