                "status": "Active"
              },
              "healthy": {
                "status": "Idle"
              },
              "dlq": {
                "status": "Empty"
              }
            }
          },
          {
            "at": "say3",
            "caption": "Malformed record m3 triggers fatal corruption and bypasses further retries.",
            "values": {
              "ingress": {
                "status": "Active"
              },
              "eval": {
                "status": "Corrupted"
              },
              "healthy": {
                "status": "Idle"
              },
              "dlq": {
                "status": "Receiving"
              }
            }
          },
          {
            "at": "say5",
            "caption": "Message m2 exceeding max retry threshold diverts immediately to DLQ.",
            "values": {
              "ingress": {
                "status": "Active"
              },
              "eval": {
                "status": "Exceeded"
              },
              "healthy": {
                "status": "Active"
              },
              "dlq": {
                "status": "Quarantining"
              }
            }
          },
          {
            "at": "say7",
            "caption": "Healthy message m1 continues processing unimpeded without partition stalls.",
            "values": {
              "ingress": {
                "status": "Complete"
              },
              "eval": {
                "status": "Complete"
              },
              "healthy": {
                "status": "Processed"
              },
              "dlq": {
                "status": "Quarantined"
              }
            }
          }
        ]
      }
