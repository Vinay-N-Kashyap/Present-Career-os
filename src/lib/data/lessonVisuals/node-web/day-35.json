    {
      "partTitle": "Distributed Dead-Letter Routing & Poison Pill Recovery Engine",
      "codeHash": "3e3b100aa1610f72e7615fbdb2d64ac6b0a2e5ea951eac73526d640d721cb59e",
      "spec": {
        "template": "flow",
        "title": "Dead-Letter Quarantine & Poison Pill Isolation",
        "nodes": [
          {
            "id": "ingress",
            "label": "Ingress Stream",
            "sub": "3 Messages Inspected",
            "status": "ok"
          },
          {
            "id": "eval",
            "label": "Retry & Schema Evaluator",
            "sub": "Max Retries: 3",
            "status": "ok"
          },
          {
            "id": "healthy",
            "label": "Healthy Pipeline",
            "sub": "Processed Successfully",
            "status": "ok"
          },
          {
            "id": "dlq",
            "label": "Dead-Letter Quarantine",
            "sub": "orders.dlq (Diagnostic Headers)",
            "status": "fail"
          }
        ],
        "edges": [
          {
            "from": "ingress",
            "to": "eval",
            "label": "Inspect"
          },
          {
            "from": "eval",
            "to": "healthy",
            "label": "Pass"
          },
          {
            "from": "eval",
            "to": "dlq",
            "label": "Exceeded / Corrupt"
          }
        ],
        "steps": [
          {
