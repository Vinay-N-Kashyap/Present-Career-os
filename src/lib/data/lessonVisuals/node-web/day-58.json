    {
      "partTitle": "Choreography-Based Sagas: Domain Event Chains & Distributed Deadlocks",
      "codeHash": "5bcc02fd92ee49f22d0576f51be6c58eaa80a731ed91a4dd9a8c2259dc0751c3",
      "spec": {
        "template": "compare",
        "title": "Saga Architectures: Choreography vs Orchestration",
        "left": {
          "title": "Choreography (Decentralized Events)",
          "points": [
            "Services coordinate autonomously via domain events",
            "No central point of failure coordinator",
            "Suffers from distributed spaghetti at scale",
            "Prone to cyclic deadlocks and poor observability"
          ]
        },
        "right": {
          "title": "Orchestration (Central State Machine)",
          "points": [
            "Central state machine commands participants",
            "Explicit end-to-end workflow visibility",
            "Participants remain decoupled from saga logic",
            "Straightforward state querying and timeout management"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Choreography works well for simple linear flows between 2 services.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Orchestration centralizes workflow definitions in a single state machine.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Orchestrators track timeouts, retries, and compensation stacks durably.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Enterprise systems mandate orchestration for complex business workflows.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
