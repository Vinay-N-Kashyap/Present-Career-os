    {
      "partTitle": "Cryptographic Token Verification: Asymmetric RSA/ECDSA Signatures, Key ID (kid) & JWKS Key Rotation",
      "codeHash": "16089a19051967e5f9e3dc52a93c1f6e8af51417489cd2a07d7f9776ed0ef27c",
      "spec": {
        "template": "compare",
        "title": "Stateless Token Verification: Symmetric Secret vs Asymmetric JWKS",
        "left": {
          "title": "Symmetric HS256 Signing",
          "points": [
            "Shared secret key stored on auth server and all microservices",
            "Single compromised service allows rogue token forging everywhere",
            "Key rotation requires synchronized restart across all services",
            "Architectural anti-pattern for zero-trust microservice meshes"
          ]
        },
        "right": {
          "title": "Asymmetric RS256/ES256 & JWKS",
          "points": [
            "Auth server signs with private key; services verify with public key",
            "Compromised microservice cannot forge tokens for other services",
            "Standardized Key ID (kid) enables automated live key rotation",
            "Public keys retrieved dynamically from /.well-known/jwks.json"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Symmetric signing exposes all services if a single secret leaks.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Asymmetric JWKS decouples signing private keys from verification public keys.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Gateways cache public keys in memory and rotate keys via 'kid' lookup.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Guarantees cryptographic zero-trust identity isolation across microservices.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
