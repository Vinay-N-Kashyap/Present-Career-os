      "partTitle": "Network Flakiness and The Danger of Non-Idempotent Retries",
      "codeHash": "491cf027d8cb6138c57c6e91a63ac4f1a5bfda7ae31073266a1a8a48a164888e",
      "spec": {
        "template": "boxes",
