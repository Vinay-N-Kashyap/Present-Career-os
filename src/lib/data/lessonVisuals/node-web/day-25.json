          {
            "id": "id",
            "label": "id"
          },
          {
            "id": "amount",
            "label": "amount"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "When network drops occur client devices cannot verify server outcomes.",
            "values": {
              "id": {
                "text": "tx_1"
              },
              "amount": {
                "text": "100"
              }
            },
            "tones": {
              "id": "data",
              "amount": "idle"
            }
          },
          {
            "at": "say5",
            "caption": "Because HTTP POST is non idempotent retries duplicate mutations.",
            "values": {
