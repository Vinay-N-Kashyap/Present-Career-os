    {
      "partTitle": "Backpressure Engineering: HighWaterMark Tuning, Drain Events & Zero-Leak Buffer Pipelines",
      "codeHash": "c9fcb8c4eda83d39064a9fa177f961164901a86e6de8d9f270dad2ae21523930",
      "spec": {
        "template": "states",
        "title": "Stream Backpressure Flow Control State Machine",
        "states": [
          {
            "id": "flowing",
            "label": "Flowing State (Pumping Chunks)"
          },
          {
            "id": "paused",
            "label": "Paused State (High-Water Mark Tripped)"
          },
          {
            "id": "draining",
            "label": "Draining State (Buffer Flushed)"
          }
        ],
        "transitions": [
          {
            "from": "flowing",
            "to": "paused",
            "label": "write() returns false"
          },
          {
            "from": "paused",
            "to": "draining",
            "label": "Kernel buffer drains"
          },
          {
            "from": "draining",
            "to": "flowing",
            "label": "Emit 'drain' event"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Producer writes chunks rapidly until internal buffer reaches highWaterMark.",
            "values": {
              "activeState": "flowing"
            }
          },
          {
            "at": "say3",
            "caption": "Writable stream returns false; producer pauses upstream read stream.",
            "values": {
              "activeState": "paused"
            }
          },
          {
            "at": "say5",
            "caption": "Operating system socket flushes queued bytes to downstream consumer.",
            "values": {
              "activeState": "draining"
            }
          },
          {
            "at": "say7",
            "caption": "Stream emits 'drain'; producer resumes high-speed chunk transmission.",
            "values": {
              "activeState": "flowing"
            }
          }
        ]
      }
    },
    {
      "partTitle": "Object Mode vs Binary Serialization: Stream Chunking, Framing & JSON/Protobuf Stream Parsers",
      "codeHash": "827d4125dca32fee233a43616c12906009979231105a01aadb088403ecb59148",
      "spec": {
        "template": "compare",
        "title": "Streaming Serialization: Object Mode vs Length-Prefixed Binary",
        "left": {
          "title": "Object Mode Streams",
          "points": [
            "Buffers discrete JavaScript objects by item count",
            "highWaterMark counts individual objects (e.g., 16 items)",
            "Ideal for internal application pipelines and ETL workflows",
            "Higher per-item V8 pointer and GC overhead"
          ]
        },
        "right": {
          "title": "Length-Prefixed Binary Framing",
          "points": [
            "Packs variable-length records into raw binary Buffers",
            "Prefixed with 4-byte big-endian payload length header",
            "Eliminates delimiter scanning and JSON serialization overhead",
            "Sub-millisecond wire deserialization and constant memory bounds"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Object Mode streams buffer discrete JavaScript objects in memory.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Binary framing packs length-prefixed bytes for maximum wire throughput.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Framed parser extracts complete records from TCP chunk fragments.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Zero data truncation across streaming chunk boundaries.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
