    {
      "partTitle": "Client-Side Load Balancing Algorithms: Round-Robin, Weighted Response Time & Peak-EWMA in Node.js",
      "codeHash": "8b7557ebb6f7cfed69c4633d0cb87d0fa3b6fcda7d9bedf72ce004f9668a7086",
      "spec": {
        "template": "compare",
        "title": "Round-Robin vs Peak-EWMA Load Balancing",
        "left": {
          "title": "Naive Round-Robin Routing",
          "points": [
            "Sends requests sequentially without considering instance latency",
            "Dumps traffic onto slow, degraded, or garbage-collecting nodes",
            "Higher tail latencies (P99) under heterogeneous workloads"
          ]
        },
        "right": {
          "title": "Peak-EWMA Adaptive Routing",
          "points": [
            "Calculates cost = EWMA latency * (InFlight Requests + 1)",
            "Steers traffic away from overloaded or paused instances",
            "Reduces P99 latency by up to 60% in multi-tenant environments"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Round-robin routes blindly into slow or stalling backends.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Peak-EWMA tracks moving average latencies and in-flight requests.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Adaptive load balancing prioritizes fastest available instances.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Tail latency percentiles improve dramatically across clusters.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
