    {
      "partTitle": "Service Discovery Topologies: Server-Side Proxies vs Client-Side Discovery & Service Registries",
      "codeHash": "edcaed051601d1680019422247be7d657fee1ed2af6017ef2e918178111b6fcd",
      "spec": {
        "template": "compare",
        "title": "Server-Side vs Client-Side Service Discovery",
        "left": {
          "title": "Server-Side Load Balancer",
          "points": [
            "Single point of failure and centralized network bottleneck",
            "Extra network hop adds latency to every internal RPC call",
            "Hard to implement advanced application-aware routing algorithms"
          ]
        },
        "right": {
          "title": "Client-Side Dynamic Discovery",
          "points": [
            "Clients query service registry and cache instance topology locally",
            "Direct client-to-instance connections with zero extra hops",
            "Enables smart routing (Peak-EWMA, Power of Two Choices, Canaries)"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Centralized load balancers introduce latency and scaling limits.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Client-side discovery enables direct zero-hop RPC routing.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Local caches protect clients against registry outages.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Client-side routing unlocks adaptive, latency-aware balancing.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
