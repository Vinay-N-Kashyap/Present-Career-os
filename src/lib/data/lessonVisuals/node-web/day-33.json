    {
      "partTitle": "AMQP Model & RabbitMQ Topology: Exchanges, Queues & Bindings",
      "codeHash": "06440cd2aa7b22a4a8f65cefc927a63ac29888aa2ce303c5b7c2e073d9965235",
      "spec": {
        "template": "flow",
        "title": "AMQP Exchange-to-Queue Routing Architecture",
        "nodes": [
          {
            "id": "pub",
            "label": "Publisher",
            "sub": "Routing Key: order.created",
            "status": "ok"
          },
          {
            "id": "ex",
            "label": "Topic Exchange",
            "sub": "order.events",
            "status": "ok"
          },
          {
            "id": "q1",
            "label": "Fulfillment Queue",
            "sub": "Binding: order.*",
            "status": "ok"
          },
          {
            "id": "q2",
            "label": "Audit Log Queue",
            "sub": "Binding: #",
            "status": "ok"
          }
        ],
        "edges": [
          {
            "from": "pub",
            "to": "ex",
            "label": "Publish"
          },
          {
            "from": "ex",
            "to": "q1",
            "label": "Pattern Match"
          },
          {
            "from": "ex",
            "to": "q2",
            "label": "Wildcard Match"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "simulateRabbitMqExchange inspects AMQP exchange bindings.",
            "values": {
              "pub": {
                "status": "Ready"
              },
              "ex": {
                "status": "Configured"
              },
              "q1": {
                "status": "Bound"
              },
              "q2": {
                "status": "Bound"
              }
            }
          },
          {
            "at": "say3",
            "caption": "Publisher routes message with routing key 'order.created'.",
            "values": {
              "pub": {
                "status": "Publishing"
              },
              "ex": {
                "status": "Evaluating"
              },
              "q1": {
                "status": "Waiting"
              },
              "q2": {
                "status": "Waiting"
              }
            }
          },
          {
            "at": "say5",
            "caption": "Topic exchange evaluates pattern matches against bound queues.",
            "values": {
              "pub": {
                "status": "Idle"
              },
              "ex": {
                "status": "Dispatched"
              },
              "q1": {
                "status": "Enqueued"
              },
              "q2": {
                "status": "Enqueued"
              }
            }
          },
          {
