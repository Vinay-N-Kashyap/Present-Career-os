    {
      "partTitle": "Routing Patterns: Direct, Fanout & Topic Wildcard Matching",
      "codeHash": "60b9890f25b85b986d6c7ccc742ec65fa31a83123da6e171b198feecdc6b23f2",
      "spec": {
        "template": "states",
        "title": "RabbitMQ Publisher Confirmation State Machine",
        "states": [
          {
            "id": "unconfirmed",
            "label": "Unconfirmed In-Flight"
          },
          {
            "id": "ack",
            "label": "Broker ACK (disk persisted)"
          },
          {
            "id": "nack",
            "label": "Broker NACK (queue full / reject)"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "simulatePublisherConfirms activates channel confirmation mode.",
            "values": {
              "unconfirmed": {
                "active": true
              },
              "ack": {
                "active": false
              },
              "nack": {
                "active": false
              }
            }
          },
          {
            "at": "say3",
            "caption": "Broker flushes message to disk and replicates to quorum members.",
            "values": {
              "unconfirmed": {
                "active": true
              },
              "ack": {
                "active": false
              },
              "nack": {
                "active": false
              }
            }
          },
          {
            "at": "say5",
            "caption": "Broker returns positive basic.ack with message delivery tag.",
            "values": {
              "unconfirmed": {
                "active": false
              },
              "ack": {
                "active": true
              },
              "nack": {
                "active": false
              }
            }
          },
          {
            "at": "say7",
            "caption": "If disk fails or queue limit hit, basic.nack triggers publisher retry.",
            "values": {
              "unconfirmed": {
                "active": false
              },
              "ack": {
                "active": false
              },
              "nack": {
                "active": true
              }
            }
          }
        ]
      }
    },
    {
      "partTitle": "Consumer Prefetch Limits & Channel Flow Control (QoS Backpressure)",
      "codeHash": "6051465a65e3529c4b3c792e8172cf40f5b23740a4d09901b8a1d8e885c6b4b3",
      "spec": {
        "template": "flow",
        "title": "Dead-Letter Exchange (DLX) Fault Recovery Pipeline",
        "nodes": [
          {
            "id": "pri",
            "label": "Primary Queue",
            "sub": "x-dead-letter-exchange",
            "status": "ok"
          },
          {
            "id": "worker",
            "label": "Consumer Worker",
            "sub": "basic.reject(requeue=false)",
            "status": "ok"
          },
          {
            "id": "dlx",
            "label": "DLX Exchange",
            "sub": "Direct Routing",
            "status": "ok"
          },
          {
            "id": "dlq",
            "label": "Quarantine DLQ",
            "sub": "Persisted for Inspection",
            "status": "ok"
          }
        ],
        "edges": [
          {
            "from": "pri",
            "to": "worker",
            "label": "Deliver"
          },
          {
            "from": "worker",
            "to": "dlx",
            "label": "Reject / Expire"
          },
          {
            "from": "dlx",
            "to": "dlq",
            "label": "Quarantine"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "simulateDeadLetterRouting configures primary queue with DLX headers.",
            "values": {
              "pri": {
                "status": "Configured"
              },
              "worker": {
                "status": "Ready"
              },
              "dlx": {
                "status": "Listening"
              },
              "dlq": {
                "status": "Empty"
              }
            }
          },
          {
            "at": "say3",
            "caption": "Corrupted message fails parsing and worker rejects with requeue=false.",
            "values": {
              "pri": {
                "status": "Delivered"
              },
              "worker": {
                "status": "Rejecting"
              },
              "dlx": {
                "status": "Listening"
              },
              "dlq": {
                "status": "Empty"
              }
            }
          },
          {
            "at": "say5",
            "caption": "RabbitMQ routes rejected message to dead-letter exchange automatically.",
            "values": {
              "pri": {
                "status": "Evicted"
              },
              "worker": {
                "status": "Idle"
              },
              "dlx": {
                "status": "Routing"
              },
              "dlq": {
                "status": "Receiving"
              }
            }
          },
          {
            "at": "say7",
            "caption": "Quarantine DLQ preserves message and headers for engineer audit.",
            "values": {
              "pri": {
                "status": "Idle"
              },
              "worker": {
                "status": "Ready"
              },
              "dlx": {
                "status": "Idle"
              },
              "dlq": {
                "status": "Quarantined"
              }
            }
          }
        ]
      }
    },
