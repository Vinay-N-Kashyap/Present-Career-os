            "id": "prod",
            "label": "Kafka Producer",
            "sub": "Partition Key: user-401",
            "status": "ok"
          },
          {
            "id": "b1",
            "label": "Broker Leader (P0)",
            "sub": "In-Sync Replicas: 3",
            "status": "ok"
          },
          {
            "id": "b2",
            "label": "Broker Follower (P1)",
            "sub": "Replicating Log",
            "status": "ok"
          },
          {
            "id": "cg",
            "label": "Consumer Group",
            "sub": "3 Active Worker Pods",
            "status": "ok"
          }
        ],
        "edges": [
          {
            "from": "prod",
            "to": "b1",
            "label": "acks=all"
          },
          {
            "from": "b1",
            "to": "b2",
            "label": "ISR Sync"
          },
          {
            "from": "b1",
            "to": "cg",
            "label": "Fetch Batch"
          }
