            "at": "say7",
            "caption": "All partitions re-assigned and workers resume processing smoothly.",
            "values": {
              "stable": {
                "active": true
              },
              "preparing": {
                "active": false
              },
              "syncing": {
                "active": false
              }
            }
          }
        ]
