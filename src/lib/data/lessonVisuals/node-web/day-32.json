    {
      "partTitle": "Consumer Groups & Scalable Parallelism: Partition Assignment & Rebalance Protocols",
      "codeHash": "e87194c1f9fe2bbfa344647be9dd23a01f2020b63f86af7609ad87929e92977e",
      "spec": {
        "template": "states",
        "title": "Consumer Group Rebalance Protocol State Machine",
        "states": [
          {
            "id": "stable",
            "label": "Stable Consumption"
          },
          {
            "id": "preparing",
            "label": "Preparing Rebalance (heartbeat missed)"
          },
          {
            "id": "syncing",
            "label": "SyncGroup (cooperative assignment)"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "simulateConsumerRebalance monitors worker pod membership.",
            "values": {
              "stable": {
                "active": true
              },
              "preparing": {
                "active": false
              },
              "syncing": {
                "active": false
              }
            }
          },
          {
            "at": "say3",
            "caption": "Worker crash triggers coordinator rebalance notification.",
            "values": {
              "stable": {
                "active": false
              },
              "preparing": {
                "active": true
              },
              "syncing": {
                "active": false
              }
            }
          },
