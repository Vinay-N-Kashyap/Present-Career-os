    {
      "partTitle": "Kafka Cluster Topology: Brokers, Topics, Partitions & Replication Factor",
      "codeHash": "f14afc20877563c92679d3b83019733814a9a20525af34e38f98f8e4cac87e11",
      "spec": {
        "template": "flow",
        "title": "Apache Kafka Commit Log & Partition Ingestion Topology",
