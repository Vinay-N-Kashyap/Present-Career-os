                "status": "Ready"
              },
              "b1": {
                "status": "Active"
              },
              "b2": {
                "status": "Syncing"
              },
              "cg": {
                "status": "Idle"
              }
            }
          },
          {
            "at": "say3",
            "caption": "Producers route records to partition leaders based on MurmurHash2 keys.",
            "values": {
              "prod": {
                "status": "Publishing"
              },
              "b1": {
                "status": "Active"
              },
              "b2": {
                "status": "Syncing"
              },
              "cg": {
                "status": "Idle"
              }
            }
          },
          {
            "at": "say5",
            "caption": "Leader writes message to append-only disk commit log at next offset.",
