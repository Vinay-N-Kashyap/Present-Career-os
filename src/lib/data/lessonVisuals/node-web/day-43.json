    {
      "partTitle": "The Text Serialization Tax: CPU Overhead of JSON.stringify & JSON.parse at Scale",
      "codeHash": "09852523c06d667a9f92fbbbd004fdf202e79c4e44f6afc1b9ed1720f02565ab",
      "spec": {
        "template": "compare",
        "title": "Textual JSON vs Binary Protocols: Latency & CPU Overhead",
        "left": {
          "title": "JSON Textual Serialization",
          "points": [
            "Requires string parsing, character escaping, and property key transmission",
            "Allocates millions of short-lived young generation strings in V8",
            "High wire bandwidth overhead due to repeated metadata keys"
          ]
        },
        "right": {
          "title": "Binary Serialization (Protobuf/MsgPack)",
          "points": [
            "Compact Tag-Length-Value encoding without transmitting property names",
            "Zero string parsing overhead; direct binary decoding via bitwise ops",
            "Reduces wire payload size by 60% to 80% and cuts CPU usage by 70%"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "JSON format redundantly repeats key strings for every single record on the wire.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Binary protocols encode schema fields as compact integer tags and type markers.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "V8 decodes binary payloads directly into typed memory structures.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Binary streaming drastically cuts wire bandwidth and garbage collection pauses.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
