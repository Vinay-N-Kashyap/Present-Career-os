    {
      "partTitle": "Lease Extensions & Asynchronous Watchdog Timers: Preventing Premature Expiration",
      "codeHash": "d18c5f19c5ec0cbb5ed7373958bf09e91734c0dfb4fa4ad0929f07cd33e178b7",
      "spec": {
        "template": "states",
        "title": "The Kleppmann Dilemma: GC Pause Lock Invalidation Hazard",
        "states": [
          {
            "id": "LOCKED",
            "label": "Client 1 Active",
            "active": false
          },
          {
            "id": "PAUSED",
            "label": "GC Pause (15s)",
            "active": false
          },
          {
            "id": "EXPIRED",
            "label": "Lock Expired in Redis",
            "active": false
          },
          {
            "id": "CORRUPT",
            "label": "Unsafe Stale Write",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "LOCKED",
            "to": "PAUSED",
            "label": "Process Freeze"
          },
          {
            "from": "PAUSED",
            "to": "EXPIRED",
            "label": "TTL Elapsed"
          },
          {
            "from": "EXPIRED",
            "to": "CORRUPT",
            "label": "Out-of-Order Write"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Client 1 acquires distributed lock with 10-second expiration lease.",
            "values": {
              "activeState": "LOCKED"
            }
          },
          {
            "at": "say3",
            "caption": "Client 1 suffers long garbage collection pause, freezing execution thread.",
            "values": {
              "activeState": "PAUSED"
            }
          },
          {
            "at": "say5",
            "caption": "Redis lock lease expires, allowing Client 2 to acquire the lock and write.",
            "values": {
              "activeState": "EXPIRED"
            }
          },
          {
            "at": "say7",
            "caption": "Client 1 wakes up and blindly writes to storage, corrupting data without fencing.",
            "values": {
              "activeState": "CORRUPT"
            }
          }
        ]
      }
    },
