      "partTitle": "Single-Instance Mutex Locking: Atomic SET NX PX & Safe Lua Release",
      "codeHash": "552e3462f2cf9016edc51c7da17b7b673848f4aa97ab62d03fcca9866a73e4a5",
      "spec": {
        "template": "compare",
        "title": "Distributed Locking: Single-Instance vs Multi-Node Redlock",
        "left": {
          "title": "Single-Instance Redis Lock",
          "points": [
            "SET key uuid NX PX 10000",
            "Fast sub-millisecond acquisition",
            "Vulnerable to master crash before replication"
          ]
        },
        "right": {
          "title": "Multi-Node Redlock Quorum",
          "points": [
            "Acquires lock across N independent masters",
            "Requires majority quorum (floor(N/2)+1)",
            "Resilient against node crashes and split-brain failures"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Single-instance locks fail silently if master crashes before asynchronous replication.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Redlock contacts 5 independent Redis masters sequentially with short timeouts.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Quorum is achieved when at least 3 out of 5 nodes grant the lock.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Client computes validity time subtracting elapsed acquisition latency from lease TTL.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
