    {
      "partTitle": "Memory Eviction Policies: LRU vs LFU & maxmemory-policy Ceilings",
      "codeHash": "5c5e2b12d6ec20da8c084325bfd9940d261032dec4e9905fde2553800bb8ed9b",
      "spec": {
        "template": "states",
        "title": "Redis Cluster Master-Replica Failover State Transition",
        "states": [
          {
            "id": "HEALTHY",
            "label": "Primary Active",
            "active": false
          },
          {
            "id": "PFAIL",
            "label": "Possible Fail Detected",
            "active": false
          },
          {
            "id": "FAIL",
            "label": "Epoch Quorum Consensus",
            "active": false
          },
          {
            "id": "PROMOTED",
            "label": "Replica Promoted",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "HEALTHY",
            "to": "PFAIL",
            "label": "Missed PING"
          },
          {
            "from": "PFAIL",
            "to": "FAIL",
            "label": "Majority Gossip"
          },
          {
            "from": "FAIL",
            "to": "PROMOTED",
            "label": "Replica Election"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Cluster nodes periodically heartbeat via gossip protocol over bus port.",
            "values": {
              "activeState": "HEALTHY"
            }
          },
          {
            "at": "say3",
            "caption": "Node flags unresponsive peer with PFAIL flag after timeout threshold.",
            "values": {
              "activeState": "PFAIL"
            }
          },
          {
            "at": "say5",
            "caption": "Majority of cluster masters confirm failure and broadcast authoritative FAIL message.",
            "values": {
              "activeState": "FAIL"
            }
          },
          {
            "at": "say7",
            "caption": "Assigned replica initiates election, assumes master status, and broadcasts new slot ownership.",
            "values": {
              "activeState": "PROMOTED"
            }
          }
        ]
      }
    },
    {
      "partTitle": "High-Throughput Pipeline Batching: Multiplexing Commands & RTT Reduction",
      "codeHash": "5a1476026ed38c1aefcb2c0a45a253dd05f6f5a2faa07ef5bdd57fd906827928",
      "spec": {
        "template": "compare",
        "title": "Redis Memory Eviction Policies: allkeys-lru vs volatile-lfu",
        "left": {
          "title": "LRU (Least Recently Used)",
          "points": [
            "Tracks timestamp of last access",
            "Evicts keys with oldest idle duration",
            "Ideal for general-purpose application caches"
          ]
        },
        "right": {
          "title": "LFU (Least Frequently Used)",
          "points": [
            "Tracks frequency logarithmic counter",
            "Protects hot persistent keys from temporary burst eviction",
            "Ideal for long-tail access patterns"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Redis checks maxmemory limit before writing new cache entries.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "LRU identifies keys with the longest idle duration across sample pool.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "LFU preserves frequently accessed historical keys even after brief lulls.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Engineers select eviction policy based on workload burstiness and memory footprint.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
    {
      "partTitle": "Cache Invalidation Patterns: Cache-Aside & Stampede Mitigation with Mutex Locks",
      "codeHash": "0748a8ac9e2a84004157f238d7a1b2685a1e3a3547c934b2619afcdae26696ae",
      "spec": {
        "template": "compare",
        "title": "Pipeline Batching vs MGET: Round-Trip Latency Reduction",
        "left": {
          "title": "Unpipelined Execution",
          "points": [
            "1 command per network RTT",
            "10 commands = 10ms network penalty",
            "High socket write syscall overhead"
          ]
        },
        "right": {
          "title": "Pipeline Batching",
          "points": [
            "10 commands in 1 network RTT",
            "10 commands = 1ms total latency",
            "Single socket flush buffering multiple commands"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Client accumulates commands in memory buffer before flushing to socket.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Redis server processes all queued commands in succession on primary thread.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "All responses return in a single consolidated network packet.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Pipeline batching achieves 10x throughput improvement across distributed networks.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
