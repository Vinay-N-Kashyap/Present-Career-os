    {
      "partTitle": "The Three Classical Node.js Memory Leaks: Forgotten Closures, Lingering Event Listeners & Caches",
      "codeHash": "ff2018105c1bb2665c983f8138efc0a2b4f3a47095e2dcd5357212df542f0038",
      "spec": {
        "template": "compare",
        "title": "Generational Garbage Collection: Young Scavenge vs Old Mark-Sweep",
        "left": {
          "title": "Scavenge GC (Young Gen)",
          "points": [
            "Runs frequently on Eden and Semi-space buffers (sub-millisecond)",
            "Uses Cheney copying algorithm between To and From spaces",
            "Extremely fast with minor CPU overhead"
          ]
        },
        "right": {
          "title": "Mark-Sweep-Compact (Old Gen)",
          "points": [
            "Runs periodically on Tenured space when memory pressure spikes",
            "Traverses entire object graph from GC roots to identify live objects",
            "Introduces Stop-The-World latency pauses under high heap sizes"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Scavenger rapidly copies surviving young objects between semi-spaces.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Surviving objects are promoted to the old generation space.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Mark-Sweep marks all reachable roots across the old generation heap.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Compaction eliminates heap fragmentation to preserve contiguous memory.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
