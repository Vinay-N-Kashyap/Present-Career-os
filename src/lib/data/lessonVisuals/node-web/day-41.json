    {
      "partTitle": "The Asynchronous Context Problem: Propagating State Without Argument Drilling",
      "codeHash": "24b5882dfeda237db59e9c66e6d586f06f41be9afebc4bfb7a0d3ae2259769dc",
      "spec": {
        "template": "compare",
        "title": "Context Drilling vs Continuation-Local Storage",
        "left": {
          "title": "Explicit Context Drilling",
          "points": [
            "Requires passing ctx parameter through every function signature",
            "Violates separation of concerns across clean architecture layers",
            "High refactoring friction when adding new telemetry fields"
          ]
        },
        "right": {
          "title": "Continuation-Local Storage (ALS)",
          "points": [
            "Zero parameter drilling: ambient context access via getStore()",
            "Preserves clean function signatures across nested tiers",
            "Seamless integration with async/await and Promise chains"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Traditional architectures pass request context as an explicit parameter through every helper.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "AsyncLocalStorage binds context to the active continuation without modifying function signatures.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Nested domain services retrieve active tenant and trace data ambiently.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Execution isolation ensures concurrent interleaved requests never leak state.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
    {
