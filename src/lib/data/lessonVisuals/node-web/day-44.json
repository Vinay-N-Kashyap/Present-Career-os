    {
      "partTitle": "HTTP/1.1 Head-of-Line Blocking vs HTTP/2 Single-TCP Binary Framing Multiplexing",
      "codeHash": "c670ace4145d80185be407d1c4c0e98e288306666f98ab21d70dcfaf12f7bdbe",
      "spec": {
        "template": "compare",
        "title": "HTTP/1.1 HOL Blocking vs HTTP/2 Interleaved Stream Multiplexing",
        "left": {
          "title": "HTTP/1.1 Parallel Sockets",
          "points": [
            "Single socket processes only 1 request/response at a time",
            "Slow request blocks all queued requests behind it (HOL Blocking)",
            "Workaround requires opening multiple TCP sockets with heavy TLS overhead"
          ]
        },
        "right": {
          "title": "HTTP/2 Single TCP Connection",
          "points": [
            "Splits connection into independent bidirectional logical streams",
            "Interleaves binary HEADERS and DATA frames from concurrent requests",
            "Eliminates application-layer Head-of-Line blocking completely"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "HTTP/1.1 queues sequential requests on a single socket, causing severe blocking.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "HTTP/2 introduces a binary framing layer over a single persistent TCP connection.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Frames from different streams carry unique stream IDs and are interleaved on the wire.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "A slow payload on Stream 1 does not impede fast responses on Stream 3.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
