    {
      "partTitle": "TCP Handshake Overhead & Socket Reuse: The Cost of Ephemeral Connections",
      "codeHash": "4c5956a54dde30f0d5733942f330ce5f37b790f7a7214d70137cc5959ea35aaf",
      "spec": {
        "template": "compare",
        "title": "Connection Pooling: Direct Connection Exhaustion vs Pooled Multiplexing",
        "left": {
          "title": "Unbounded Direct Connections",
          "points": [
            "Each Node.js pod opens 100 direct sockets",
            "PostgreSQL forks process per connection (10MB RAM)",
            "Context switching collapses database CPU"
          ]
        },
        "right": {
          "title": "Pooled Gateway Multiplexing",
          "points": [
            "Node.js uses bounded generic-pool (10 conn)",
            "pgBouncer multiplexes 5000 clients over 50 server conns",
            "Near-zero memory bloat and predictable 1ms latency"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "PostgreSQL allocates a dedicated backend OS process for every direct TCP connection.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "High connection concurrency induces severe Linux kernel context switching overhead.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Connection pool buffers excess requests in FIFO queue rather than exhausting sockets.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Database operates at maximum IOPS throughput with minimal operating system overhead.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
    {
