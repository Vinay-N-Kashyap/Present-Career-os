    {
      "partTitle": "Pool Starvation, Health Probes & Deadlock Avoidance: Acquisition Timeouts",
      "codeHash": "80065461b8578097cedb3baf6209bcc3af14a12b9f4407411efccf2e22d69b1d",
      "spec": {
        "template": "states",
        "title": "Resilient Connection Pool Health Check & Draining State Machine",
        "states": [
          {
            "id": "HEALTHY",
            "label": "All Sockets Active",
            "active": false
          },
          {
            "id": "DEGRADED",
            "label": "Socket Error / Reconnect",
            "active": false
          },
          {
            "id": "DRAINING",
            "label": "Graceful Drain on SIGTERM",
            "active": false
          },
          {
            "id": "CLOSED",
            "label": "Pool Terminated",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "HEALTHY",
            "to": "DEGRADED",
            "label": "Network Blip"
          },
          {
            "from": "DEGRADED",
            "to": "HEALTHY",
            "label": "Heartbeat Ping OK"
          },
          {
            "from": "HEALTHY",
            "to": "DRAINING",
            "label": "SIGTERM Received"
          },
          {
            "from": "DRAINING",
            "to": "CLOSED",
            "label": "All Released"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Pool periodically validates idle sockets using SELECT 1 health check ping.",
            "values": {
              "activeState": "HEALTHY"
            }
          },
          {
            "at": "say3",
            "caption": "Dead or unresponsive sockets are pruned and replaced with fresh TCP connections.",
            "values": {
              "activeState": "DEGRADED"
            }
          },
          {
            "at": "say5",
            "caption": "Upon receiving SIGTERM, pool enters DRAINING state, rejecting new acquire calls.",
            "values": {
              "activeState": "DRAINING"
            }
          },
          {
            "at": "say7",
            "caption": "Active queries finish execution cleanly before pool gracefully closes all sockets.",
            "values": {
              "activeState": "CLOSED"
            }
          }
        ]
      }
    }
