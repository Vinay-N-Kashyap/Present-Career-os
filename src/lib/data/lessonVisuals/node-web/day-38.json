    {
      "partTitle": "PostgreSQL Concurrency Cost: Process-Per-Connection Architecture & RAM Sizing",
      "codeHash": "234ee27844df516c8d72bd6a8155cc43ff60ec736fcdad266e91e0d953b885b5",
      "spec": {
        "template": "compare",
        "title": "PostgreSQL pgBouncer Modes: Session vs Transaction Pooling",
        "left": {
          "title": "Session Pooling",
          "points": [
            "Connection bound to client for full session",
            "Supports PREPARE statements and LISTEN/NOTIFY",
            "Low multiplexing ratio"
          ]
        },
        "right": {
          "title": "Transaction Pooling",
          "points": [
            "Connection released back to pool after COMMIT",
            "Achieves 100x client multiplexing ratio",
            "Prohibits session-level state and SET variables"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Session pooling assigns server connection until client terminates TCP socket.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Transaction pooling reclaims connection the millisecond COMMIT or ROLLBACK executes.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Thousands of Node.js pods share small pool of 50 PostgreSQL server backends.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Transaction pooling delivers maximum throughput for REST API stateless workloads.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
