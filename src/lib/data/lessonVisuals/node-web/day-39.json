    {
      "partTitle": "Token Bucket & Leaky Bucket: Burst Tolerance vs Smooth Constant Rate Outflow",
      "codeHash": "e93f237f5a449b34bc82b3a514a95de18f244d645aff9b7c1eedf64158413379",
      "spec": {
        "template": "compare",
        "title": "Token Bucket vs Leaky Bucket Traffic Shaping",
        "left": {
          "title": "Token Bucket Algorithm",
          "points": [
            "Tokens refilled at constant rate R up to capacity C",
            "Permits instant burst up to capacity C",
            "Preferred for user-facing interactive APIs"
          ]
        },
        "right": {
          "title": "Leaky Bucket Algorithm",
          "points": [
            "Requests enter bucket and leak out at constant rate",
            "Completely eliminates bursts, outputting smooth flow",
            "Preferred for pacing writes to fragile legacy systems"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Token bucket enables web clients to burst 10 requests to load full page assets.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Subsequent continuous traffic is bounded by steady-state refill rate.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Leaky bucket queues requests and processes them at strictly fixed intervals.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Engineers select token bucket for burst tolerance and leaky bucket for traffic smoothing.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
