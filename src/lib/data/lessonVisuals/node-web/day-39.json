    {
      "partTitle": "API Gateway Integration: Dynamic Rate Limits, Tiered Quotas & RFC 6585 (429)",
      "codeHash": "fb101ebc34cdc75d413369a00471f1ac17674b0c64e064c3eba87246d88bb9f0",
      "spec": {
        "template": "states",
        "title": "API Gateway Rate Limiting Enforcement & RFC 6585 State Machine",
        "states": [
          {
            "id": "ALLOWED_200",
            "label": "Within Quota (HTTP 200)",
            "active": false
          },
          {
            "id": "WARNING_200",
            "label": "Quota Low (< 10% Left)",
            "active": false
          },
          {
            "id": "THROTTLED_429",
            "label": "Quota Exceeded (HTTP 429)",
            "active": false
          },
          {
            "id": "RESET",
            "label": "Window Reset",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "ALLOWED_200",
            "to": "WARNING_200",
            "label": "Usage > 90%"
          },
          {
            "from": "WARNING_200",
            "to": "THROTTLED_429",
            "label": "Tokens Exhausted"
          },
          {
            "from": "THROTTLED_429",
            "to": "RESET",
            "label": "Retry-After Elapsed"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Gateway inspects incoming request and resolves client subscription tier.",
            "values": {
              "activeState": "ALLOWED_200"
            }
          },
          {
            "at": "say3",
            "caption": "Response headers include RateLimit-Limit, RateLimit-Remaining, and RateLimit-Reset.",
            "values": {
              "activeState": "WARNING_200"
            }
          },
          {
            "at": "say5",
            "caption": "If quota is exhausted, gateway intercepts request and returns HTTP 429 Too Many Requests.",
            "values": {
              "activeState": "THROTTLED_429"
            }
          },
          {
            "at": "say7",
            "caption": "Retry-After header instructs client SDK when to resume requests without human friction.",
            "values": {
              "activeState": "RESET"
            }
          }
        ]
      }
