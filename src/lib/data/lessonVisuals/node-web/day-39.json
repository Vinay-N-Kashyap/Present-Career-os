    {
      "partTitle": "Rate Limiting Paradigms: Fixed Window vs Sliding Window Log & Boundary Bursts",
      "codeHash": "daddfe0ac90f909943d4d9a0c588173c21a87fc1c0680f01bcd38d54c04dc398",
      "spec": {
        "template": "compare",
        "title": "Rate Limiting Paradigms: Fixed Window vs Sliding Window Log",
        "left": {
          "title": "Fixed Window Counter",
          "points": [
            "INCR rate:user:12:00 with 60s TTL",
            "Memory efficient (1 integer per user)",
            "Vulnerable to double-limit bursts across window boundary"
          ]
        },
        "right": {
          "title": "Sliding Window Log (ZSET)",
          "points": [
            "Stores exact Unix timestamps in Redis Sorted Set",
            "100% boundary burst protection",
            "High memory overhead storing timestamp per request"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Fixed windows reset counters at discrete 1-minute clock boundaries.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Attackers burst max limit at 12:00:59 and another burst at 12:01:01.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Sliding window logs remove expired timestamps and count active items in rolling 60s.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Sliding window logs enforce strict mathematical rates across any rolling interval.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
    {
