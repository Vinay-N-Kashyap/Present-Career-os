    {
      "partTitle": "Producer Semantics: Batching, Compression, Idempotence & Acks Invariants",
      "codeHash": "8bed864a7082e4748b9132737d63fa0f67a59bd432aa44488fa46c66c1d23ae8",
      "spec": {
        "template": "compare",
        "title": "Kafka Producer Semantics: acks=0 vs acks=all",
        "left": {
          "title": "Fire-and-Forget (acks=0)",
          "points": [
            "Zero network round-trip wait",
            "Maximum write throughput",
            "High message loss risk on broker crash",
            "Suitable only for non-critical telemetry"
          ]
        },
        "right": {
          "title": "Idempotent Durability (acks=all)",
          "points": [
            "Waits for all in-sync replicas (ISR)",
            "Strict zero message loss guarantee",
            "Enables idempotent producer PID/sequence",
            "Enterprise standard for financial transactions"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "acks=0 fires packets into socket buffer without acknowledgment.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "acks=all waits for complete ISR quorum disk commits.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Idempotent producers prevent duplicate records on retry.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Critical transaction pipelines mandate acks=all and min.insync.replicas=2.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
    {
      "partTitle": "Consumer Groups & Partition Assignment: Cooperative Sticky Rebalancing & Offset Commits",
      "codeHash": "ea8ed249680a0f9fc9bf15700e90eae2eb1701e3cf167acb9f1382a1251369c2",
      "spec": {
        "template": "boxes",
        "title": "Kafka Consumer Group Partition Rebalance Protocols",
        "items": [
          {
            "id": "eager",
            "title": "Eager Rebalance Protocol",
            "desc": "Revokes all partitions from all consumers during rebalance, causing total stop-the-world pauses.",
            "status": "ok"
          },
          {
            "id": "cooperative",
            "title": "Cooperative Sticky Protocol",
            "desc": "Revokes only migrated partitions incrementally, allowing continuous processing on unaffected partitions.",
            "status": "ok"
          },
          {
            "id": "heartbeat",
            "title": "Heartbeat & Liveness Thread",
            "desc": "Maintains session leases with group coordinator independently of message processing event loop.",
            "status": "ok"
          },
          {
            "id": "offsets",
            "title": "Committed Offset Checkpoints",
            "desc": "Persists consumer position in __consumer_offsets topic with manual synchronous or asynchronous commits.",
            "status": "ok"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Eager protocol halts entire consumer fleet during partition rebalancing.",
            "values": {
              "eager": {
                "status": "Inspecting"
              },
              "cooperative": {
                "status": "Inspecting"
              },
              "heartbeat": {
                "status": "Inspecting"
              },
              "offsets": {
                "status": "Inspecting"
              }
            }
          },
          {
            "at": "say3",
            "caption": "Cooperative sticky assignor isolates partition shifts without fleet stoppage.",
            "values": {
