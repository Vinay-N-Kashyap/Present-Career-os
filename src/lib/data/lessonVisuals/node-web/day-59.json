    {
      "partTitle": "Cache Invalidation & Consistency Patterns: Cache-Aside, Write-Through & Write-Behind",
      "codeHash": "63d5a0d2aa0d7b543163494383eb78447d5e3d240e4b62396277d40a15eb5b2b",
      "spec": {
        "template": "compare",
        "title": "Cache-Aside Invalidation: Delete (DEL) vs Update",
        "left": {
          "title": "Direct Cache Update Anti-Pattern",
          "points": [
            "Updates cache key on every DB write",
            "Concurrent writes interleave unpredictably",
            "Older value overwrites newer value in cache",
            "Causes permanent silent data corruption"
          ]
        },
        "right": {
          "title": "Cache-Aside Invalidation (DEL)",
          "points": [
            "Deletes cache key on DB write",
            "Subsequent read forces fresh DB fetch",
            "Eliminates concurrent write races entirely",
            "Industry standard for relational cache consistency"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Updating cache directly causes race conditions under concurrent writes.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Deleting cache keys forces authoritative refreshes from database.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Cache-aside guarantees eventual consistency without desynchronization.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Simple, robust invalidation eliminates silent data divergence permanently.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
