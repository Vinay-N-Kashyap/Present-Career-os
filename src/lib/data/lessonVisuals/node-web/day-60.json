    {
      "partTitle": "Distributed Saga Orchestrator & Multi-Service Compensation Engine",
      "codeHash": "ddd816932265e7a18101237a63b311098e9e3872335994a65072cb270d8fe6a1",
      "spec": {
        "template": "states",
        "title": "Milestone 10 Distributed Saga Orchestrator Lifecycle",
        "states": [
          {
            "id": "initial",
            "label": "INITIAL"
          },
          {
            "id": "order_staged",
            "label": "ORDER_STAGED"
          },
          {
            "id": "payment_charged",
            "label": "PAYMENT_CHARGED"
          },
          {
            "id": "compensating",
            "label": "COMPENSATING (LIFO Stack)"
          },
          {
            "id": "failed",
            "label": "FAILED (Symmetric Rollback)"
          }
        ],
        "transitions": [
          {
            "from": "initial",
            "to": "order_staged",
            "label": "OrderPlaced Event"
          },
          {
            "from": "order_staged",
            "to": "payment_charged",
            "label": "Charge Payment"
          },
          {
            "from": "payment_charged",
            "to": "compensating",
            "label": "Inventory Out-of-Stock"
          },
          {
            "from": "compensating",
            "to": "failed",
            "label": "Refund & Cancel Finished"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Orchestrator consumes OrderPlaced event and stages order transaction.",
            "values": {
              "activeState": "initial"
            }
          },
