            "at": "say3",
            "caption": "Payment service charges customer and registers refund compensation handler.",
            "values": {
              "activeState": "order_staged"
            }
          },
          {
            "at": "say5",
            "caption": "Inventory allocation fails; orchestrator transitions to COMPENSATING.",
            "values": {
              "activeState": "payment_charged"
            }
          },
          {
            "at": "say7",
            "caption": "Compensation stack unwinds in LIFO order, restoring consistent state.",
            "values": {
              "activeState": "compensating"
            }
          }
        ]
      }
