    {
      "partTitle": "The Distributed Consensus Challenge: Paxos vs Raft & CAP Theorem Trade-Offs in Node.js",
      "codeHash": "4986bf2fa0d79c8b249a7e70e5150d9b8f528497d1c97a0e5d607841f356b92a",
      "spec": {
        "template": "compare",
        "title": "Two-Phase Commit (2PC) vs Raft Consensus Protocol",
        "left": {
          "title": "Two-Phase Commit (2PC)",
          "points": [
            "Blocking consensus protocol vulnerable to coordinator crashes",
            "Requires 100% participant agreement to commit state changes",
            "Causes system-wide stalls if any node becomes unreachable"
          ]
        },
        "right": {
          "title": "Raft Consensus Protocol",
          "points": [
            "Non-blocking consensus operating across majority quorums (N/2 + 1)",
            "Automated leader election with randomized election timeouts",
            "Tolerates minority node failures (F < N/2) without downtime"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Traditional 2PC blocks indefinitely when the coordinator fails.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Raft relies on majority quorum replication to prevent stalls.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Randomized election timeouts guarantee reliable leader election.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Raft ensures linearizable state machine replication across clusters.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
