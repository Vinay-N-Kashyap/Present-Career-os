      "partTitle": "Gateway Architecture Topology: Redis Cluster, Redlock & Reservation State Machine",
      "codeHash": "076fa5712f4924b41e7a38a8ed6bccc21e51b830b2d4df744c3fe5a9af3df706",
      "spec": {
        "template": "states",
        "title": "Milestone 7 Distributed Reservation Finite State Machine",
        "states": [
          {
            "id": "PENDING",
            "label": "Hold Initiated",
            "active": false
          },
          {
            "id": "HELD",
            "label": "Stock Reserved (TTL 15m)",
            "active": false
          },
          {
            "id": "COMMITTED",
            "label": "Order Paid & Finalized",
            "active": false
          },
          {
            "id": "EXPIRED",
            "label": "Abandoned / Restored",
            "active": false
          }
        ],
        "transitions": [
          {
            "from": "PENDING",
            "to": "HELD",
            "label": "Lua Debit Success"
          },
          {
            "from": "HELD",
            "to": "COMMITTED",
            "label": "Payment Authorized"
          },
          {
            "from": "HELD",
            "to": "EXPIRED",
            "label": "Reaper Reclaims Stock"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Client initiates checkout; gateway places atomic hold on inventory in Redis.",
            "values": {
              "activeState": "PENDING"
            }
          },
          {
            "at": "say3",
            "caption": "Reservation enters HELD state with 15-minute expiration timestamp in Sorted Set.",
            "values": {
              "activeState": "HELD"
            }
          },
          {
            "at": "say5",
            "caption": "Successful payment transitions reservation to COMMITTED; outbox writes to PostgreSQL.",
            "values": {
              "activeState": "COMMITTED"
            }
          },
          {
            "at": "say7",
            "caption": "If payment is abandoned, expiration reaper transitions to EXPIRED and restores inventory.",
            "values": {
              "activeState": "EXPIRED"
            }
          }
        ]
      }
    },
