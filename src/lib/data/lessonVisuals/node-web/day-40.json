    {
      "partTitle": "Distributed Mutex & Fencing Token Concurrency Gate: Out-of-Order Lock Rejection",
      "codeHash": "f131dfe8cd8bffdbff23412f82f344bb8cb392e1c8973eaf2a379a8dffcb8faf",
      "spec": {
        "template": "compare",
        "title": "Fencing Token Protection: Valid Modern Write vs Stale GC Pause Write",
        "left": {
          "title": "Modern Client 2 Write (Token 102)",
          "points": [
            "Acquired lock after Client 1 lease expired",
            "Issued fencing token 102",
            "Storage gate validates 102 > 0 -> COMMITTED"
          ]
        },
        "right": {
          "title": "Stale Client 1 Write (Token 101)",
          "points": [
            "Awoke from 15-second GC pause unaware lock expired",
            "Presents stale fencing token 101",
            "Storage gate detects 101 <= 102 -> REJECTED"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Client 1 acquires lock with token 101 but suffers prolonged GC pause.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Client 2 acquires lock with token 102, finishes work, and commits to database.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Client 1 wakes up from pause and attempts to commit stale write with token 101.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Downstream database gate rejects token 101, preserving Client 2 data integrity.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
