            "id": "type",
            "label": "type"
          },
          {
            "id": "entity",
            "label": "entityId"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "The unit of work pattern maintains a list of objects in a transaction.",
            "values": {
              "type": {
                "text": "UPDATE"
              },
              "entity": {
                "text": "account_101"
              }
            },
            "tones": {
              "type": "data",
              "entity": "idle"
            }
          },
          {
            "at": "say5",
            "caption": "Repositories stage their mutations inside the unit of work tracker.",
            "values": {
              "type": {
                "text": "INSERT"
              },
              "entity": {
                "text": "order_9901"
              }
            },
            "tones": {
              "type": "data",
              "entity": "data"
            }
          },
          {
            "at": "say8",
