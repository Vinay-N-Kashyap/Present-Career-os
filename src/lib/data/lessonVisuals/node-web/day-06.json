      "partTitle": "Safe vs Idempotent HTTP Methods",
      "codeHash": "527d8457c01e5c4bfd53f3481e83ae3c261c0baed9100925e6efe33a4425002e",
      "spec": {
        "template": "table",
        "title": "HTTP method idempotency semantics",
        "columns": [
          "HTTP Method",
          "Safe Operation",
          "Idempotent"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "A method is considered safe if calling it does not alter server state.",
            "rows": [
              {
                "cells": [
