    {
      "partTitle": "Status Codes: 2xx Success and 3xx Redirection Semantics",
      "codeHash": "effcfe0a314620fa76a763737a7fd9e51a613a0e33ba356f0c6af432973d3292",
      "spec": {
        "template": "states",
        "title": "Status code category distribution",
        "states": [
          {
            "id": "s200",
            "label": "200"
          },
          {
            "id": "s201",
            "label": "201"
          },
          {
            "id": "s204",
            "label": "204"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "The 2xx class indicates that the client request was successfully received.",
            "currentState": "s200",
            "transition": {
              "from": "s204",
              "to": "s200",
              "label": {
                "text": "200 OK - Standard Success"
              }
            },
            "tone": "ok"
          },
          {
            "at": "say3",
            "caption": "The 3xx class indicates that the client must take additional action.",
            "currentState": "s201",
            "transition": {
              "from": "s200",
              "to": "s201",
              "label": {
                "text": "201 Created - Resource Persisted"
              }
            },
            "tone": "error"
          },
          {
            "at": "say8",
            "caption": "Using precise status codes instead of generic responses improves caching.",
            "currentState": "s204",
            "transition": {
              "from": "s201",
              "to": "s204",
              "label": {
                "text": "204 No Content - Deletion Completed"
              }
            },
            "tone": "ok"
          }
        ]
