      "partTitle": "Exponential Backoff, Jitter & Retry Budgets: Preventing Thundering Herd Resurrections",
      "codeHash": "fb5107d38436946b513b998e8acdf3c5ca6c3626bfc9419af9f7c1a6fd19e0fd",
      "spec": {
        "template": "compare",
        "title": "Naive Retries vs Exponential Backoff with Full Jitter",
        "left": {
          "title": "Naive Immediate Retries",
          "points": [
            "Retries sent immediately upon network failure",
            "Synchronized retries create massive thundering herd spikes",
            "Overwhelms recovering services and worsens downtime"
          ]
        },
        "right": {
          "title": "Exponential Backoff with Full Jitter",
          "points": [
            "Delay doubles exponentially with each failed attempt",
            "Full Jitter randomizes retry distribution across time window",
            "Retry budgets cap retry volume to 10% of total traffic"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Immediate retries exacerbate outages through thundering herd effects.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Exponential backoff spreads retry attempts across wider intervals.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Full Jitter eliminates synchronized traffic spikes permanently.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Retry budgets protect degraded downstreams from overload.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
