    {
      "partTitle": "Load Balancing Strategies & Active Health Checking: Round-Robin, Least-Connections & Circuit Breakers",
      "codeHash": "cba62db1fe62fba4d80bdf14b6d47b731db338a7172aefad7cbc391453a25520",
      "spec": {
        "template": "states",
        "title": "Upstream Cluster Outlier Detection & Circuit Breaker State Machine",
        "states": [
          {
            "id": "CLOSED",
            "label": "CLOSED State (Healthy, Traffic Permitted)"
          },
          {
            "id": "OPEN",
            "label": "OPEN State (Tripped, Traffic Blocked)"
          },
          {
            "id": "HALF_OPEN",
            "label": "HALF-OPEN State (Canary Probe Testing)"
          }
        ],
        "transitions": [
          {
            "from": "CLOSED",
            "to": "OPEN",
            "label": "3 Consecutive Upstream Failures"
          },
          {
            "from": "OPEN",
            "to": "HALF_OPEN",
            "label": "Cool-down Timer Expires"
          },
          {
            "from": "HALF_OPEN",
            "to": "CLOSED",
            "label": "Canary Request Succeeds"
          },
          {
            "from": "HALF_OPEN",
            "to": "OPEN",
            "label": "Canary Request Fails"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Load balancer routes requests via least-connections among healthy nodes.",
            "values": {
              "activeState": "CLOSED"
            }
          },
          {
            "at": "say3",
            "caption": "Instance encountering 3 consecutive errors trips circuit breaker to OPEN.",
            "values": {
              "activeState": "OPEN"
            }
          },
          {
            "at": "say5",
            "caption": "Faulty node is ejected from rotation, shielding it from thundering herds.",
            "values": {
              "activeState": "HALF_OPEN"
            }
          },
          {
            "at": "say7",
            "caption": "Cool-down timer triggers HALF-OPEN canary to test recovery before restoring traffic.",
            "values": {
              "activeState": "CLOSED"
            }
          }
        ]
      }
    },
