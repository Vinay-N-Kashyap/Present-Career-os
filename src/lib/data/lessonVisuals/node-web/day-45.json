      "partTitle": "High-Throughput Binary Telemetry Ingestion: Varint-Tagged Protobuf Decoding & Zero-Copy Buffer Pools",
      "codeHash": "fe1ec34479bf45eebb65e58b4f1f7dd9ff122df97a8e1ecc5a85765f2dfd0e38",
      "spec": {
        "template": "boxes",
        "title": "Zero-Copy Varint Protobuf Ingestion & Buffer Pool Management",
        "items": [
          {
            "id": "pool",
            "title": "Pre-Allocated Buffer Pool",
            "desc": "Fixed array of reusable byte arrays allocated at startup",
            "status": "ok"
          },
          {
            "id": "acquire",
            "title": "Borrow on Ingress",
            "desc": "Worker borrows pooled scratch buffer without heap allocation",
            "status": "ok"
          },
          {
            "id": "decode",
            "title": "In-Place Decoding",
            "desc": "Varint values extracted directly via bitwise bit shifting",
            "status": "ok"
          },
          {
            "id": "release",
            "title": "Instant Return",
            "desc": "Scratch buffer returned to pool immediately to prevent GC churn",
            "status": "ok"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Buffer pool initializes fixed byte containers at application startup.",
