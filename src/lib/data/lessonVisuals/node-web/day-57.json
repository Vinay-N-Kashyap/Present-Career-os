    {
      "partTitle": "Change Data Capture (CDC): Debezium, Write-Ahead Logs (WAL) & Outbox Relay",
      "codeHash": "a528fb3bc1ab920dae2ada8deddb92305bfcc369108f1e3ca3d253caed672ea1",
      "spec": {
        "template": "compare",
        "title": "Dual-Write Anti-Pattern vs Transactional Outbox",
        "left": {
          "title": "Naive Dual-Write Anti-Pattern",
          "points": [
            "Commit DB then publish to Kafka",
            "Network drop causes lost events",
            "Publish first causes phantom events",
            "Violates distributed atomicity"
          ]
        },
        "right": {
          "title": "Transactional Outbox Architecture",
          "points": [
            "Atomic commit of DB entity + outbox event",
            "Zero distributed 2PC locking",
            "CDC or SKIP LOCKED relay guarantees delivery",
            "Guarantees At-Least-Once event publishing"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Dual-writes suffer from network timeouts and partial failure splits.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Transactional outbox unifies state mutation and event staging in one ACID unit.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Background relay decouples messaging latency from user HTTP response.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Downstream systems receive guaranteed At-Least-Once event streams.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
