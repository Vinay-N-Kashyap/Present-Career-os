      "partTitle": "Node.js Single-Threaded Constraints & Multi-Core Scaling: Forking vs Worker Threads vs Cluster Module",
      "codeHash": "91d88a3e4d7a6e1508025f3ffb9228ff9a1722a333b24e9b03717550c4d06a0d",
      "spec": {
        "template": "compare",
        "title": "Single Process vs Multi-Core Process Clustering",
        "left": {
          "title": "Single Process Runtime",
          "points": [
            "Restricted to a single OS thread and CPU core",
            "Unused server CPU cores sit idle during traffic spikes",
            "Fatal unhandled exception crashes the entire backend"
          ]
        },
        "right": {
          "title": "Clustered Master-Worker Architecture",
          "points": [
            "One worker process per physical CPU core maximizes throughput",
            "OS-level shared socket distributing incoming TCP connections",
            "Master supervisor restarts isolated failed workers transparently"
          ]
        },
        "steps": [
          {
            "at": "say1",
            "caption": "Single-process Node.js services leave multi-core server hardware underutilized.",
            "values": {
              "activeSide": "left"
            }
          },
          {
            "at": "say3",
            "caption": "Process clustering forks worker processes across all physical CPU cores.",
            "values": {
              "activeSide": "right"
            }
          },
          {
            "at": "say5",
            "caption": "Shared TCP sockets distribute requests evenly with low latency.",
            "values": {
              "activeSide": "both"
            }
          },
          {
            "at": "say7",
            "caption": "Clustered architectures deliver enterprise-grade fault isolation.",
            "values": {
              "activeSide": "both"
            }
          }
        ]
      }
    },
