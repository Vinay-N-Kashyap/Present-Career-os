    {
      "partTitle": "WAF Rule 3: Context-Aware XSS Entity Escaping & CSP Header Injector",
      "codeHash": "2cc3ecda79b7b288039085c41b5f253852bbde7284a43c52b839afdec5124526",
      "spec": {
        "template": "sequence",
        "title": "WAF input entity encoding and CSP response header injection sequence",
        "actors": [
          {
            "id": "client",
            "label": "HTTP Client"
          },
          {
            "id": "wafXss",
            "label": "WAF XSS Sanitizer"
          },
          {
            "id": "appBackend",
            "label": "Application Backend"
          }
        ],
        "messages": [
          {
            "from": "client",
            "to": "wafXss",
            "label": "Transmit Request with Script Tags in Body",
            "tone": "error"
          },
          {
            "from": "wafXss",
            "to": "appBackend",
            "label": "Forward Payload with HTML Entities Encoded",
            "tone": "ok"
          },
          {
            "from": "appBackend",
            "to": "wafXss",
            "label": "Generate Raw HTTP Response Data",
            "tone": "data"
          },
          {
            "from": "wafXss",
            "to": "client",
            "label": "Attach Strict CSP Nonce Header to Response",
            "tone": "ok"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Dangerous characters are transformed into safe named entities.",
            "activeMessageIndex": 1,
