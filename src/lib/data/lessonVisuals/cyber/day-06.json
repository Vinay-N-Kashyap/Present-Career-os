        "messages": [
          {
            "from": "client",
            "to": "cryptoEngine",
            "label": "Submit Payload with Fresh Random Nonce",
            "tone": "data"
          },
          {
            "from": "cryptoEngine",
            "to": "nonceAuditor",
            "label": "Audit Nonce Uniqueness Against Cache",
            "tone": "ok"
          },
          {
