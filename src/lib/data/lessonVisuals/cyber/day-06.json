      "partTitle": "Symmetric vs Asymmetric Cryptography: Computational Trade-offs & Hybrid Architectures",
      "codeHash": "eb57f78be5dc8c512d0bd14a98b00378f3aded9e911318fca807d77510fc52e6",
      "spec": {
        "template": "compare",
        "title": "Symmetric versus asymmetric cipher computational performance trade-offs",
        "left": {
          "title": "Symmetric Encryption (AES)",
          "items": [
            "Single shared secret key for encryption and decryption",
            "Hardware acceleration with dedicated AES-NI instructions",
            "High throughput for gigabytes of bulk payload data"
          ]
        },
        "right": {
          "title": "Asymmetric Cryptography (RSA/ECC)",
          "items": [
            "Mathematically linked public and private key pairs",
            "Solves key distribution over untrusted networks",
            "Higher computational cost suited for key exchange"
          ]
        },
        "steps": [
