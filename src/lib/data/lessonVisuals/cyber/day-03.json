      "spec": {
        "template": "compare",
        "title": "Client-side tainted input sources versus dangerous execution sinks",
        "left": {
          "title": "Tainted Sources",
          "items": [
            "location.search query string parameters",
            "location.hash fragment identifiers",
            "document.referrer header values"
          ]
        },
        "right": {
          "title": "Dangerous Sinks",
          "items": [
            "element.innerHTML and outerHTML parsers",
            "document.write direct DOM markup injection",
            "eval and Function dynamic script evaluators"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "A source is a property through which untrusted data enters the dom.",
            "highlightSide": "left",
            "statusBadge": "active"
