    {
      "partTitle": "Sigma Detection Rules & Multi-SIEM Query Translation",
      "codeHash": "0d7b29c15e25bb44105fae5c041ad14e7a79c40523847cf8f7cf3082d671011f",
      "spec": {
        "template": "compare",
        "title": "Proprietary SIEM query lock-in versus open portable Sigma signatures",
        "left": {
          "title": "Vendor Proprietary Queries",
          "items": [
            "Locked into vendor specific query syntax and platforms",
            "Migrating SIEM solutions requires rewriting thousands of rules",
            "Incompatible across external threat intelligence communities"
          ]
        },
        "right": {
          "title": "Generic Open Sigma Rules",
          "items": [
            "YAML standardized syntax describing vendor neutral attacks",
            "Compiler translates rules to Splunk Elastic and Sentinel",
            "Decouples detection logic from underlying data stores"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Sigma provides an open format for generic SIEM detection rules.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "The compiler converts generic rules into native target query languages.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
