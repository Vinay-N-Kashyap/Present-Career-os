    {
      "partTitle": "Double-Submit Cookie Pattern for Stateless Microservices",
      "codeHash": "ed7b9971365decd6d876a69fb22faee29227409c951e8585dd7f44f2f67922b9",
      "spec": {
        "template": "compare",
        "title": "Synchronizer session token pattern versus stateless double-submit cookie pattern",
        "left": {
          "title": "Synchronizer Token Pattern",
          "items": [
            "Requires server-side session memory or Redis store",
            "Tokens tied to active authenticated session state",
            "Best suited for traditional monolith web apps"
          ]
        },
        "right": {
          "title": "Double-Submit Cookie Pattern",
          "items": [
            "Zero server-side session storage overhead",
            "Cookie value mirrored into custom HTTP request header",
            "Ideal for distributed stateless microservice APIs"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "The double submit cookie pattern keeps verification entirely stateless.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Forged requests arrive without matching headers and are rejected.",
            "highlightSide": "left",
            "statusBadge": "completed"
          }
        ]
      },
