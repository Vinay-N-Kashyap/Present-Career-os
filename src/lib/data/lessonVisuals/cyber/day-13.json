    {
      "partTitle": "Packet Filtering Firewalls vs Stateful Packet Inspection (SPI)",
      "codeHash": "c3fa1e175637d5a060d4b7c3e85c40bbe0557c730d40a2d12332d4b5f9f9f3df",
      "spec": {
        "template": "compare",
        "title": "Stateless five-tuple packet filtering versus stateful packet inspection",
        "left": {
          "title": "Stateless Packet Filtering",
          "items": [
            "Inspects each packet in isolation using header rules",
            "Cannot track bidirectional connection context or phase",
            "Requires opening broad ranges of ephemeral ports"
          ]
        },
        "right": {
          "title": "Stateful Packet Inspection",
          "items": [
            "Maintains dynamic connection tracking state tables",
            "Automatically correlates outbound requests with replies",
            "Blocks unsolicited inbound packets while permitting web"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Stateless firewalls inspect each packet in complete isolation.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "Unsolicited inbound packets without established connections are dropped.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
