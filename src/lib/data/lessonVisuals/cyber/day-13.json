    {
      "partTitle": "Mitigating SYN Floods with Cryptographic SYN Cookies (RFC 4987)",
      "codeHash": "33e0fb584d056a3ab3582ddff9240883568b3e655ca133a47bffa9e2036699da",
      "spec": {
        "template": "compare",
        "title": "Stateful connection backlog queue versus stateless cryptographic SYN cookies",
        "left": {
          "title": "Standard SYN Backlog Queue",
          "items": [
            "Allocates kernel memory for every incoming SYN packet",
            "Queue becomes exhausted within seconds under flood",
            "Legitimate user connections dropped due to full queue"
          ]
        },
        "right": {
          "title": "Cryptographic SYN Cookie Defense",
          "items": [
            "Zero memory allocated upon receiving initial SYN packet",
            "Connection state encoded into thirty-two bit sequence",
            "Allocates connection memory only after valid client ACK"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "The server allocates zero memory when receiving an initial SYN packet.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say9",
            "caption": "Stateless cookies neutralize floods without allocating memory in queues.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
