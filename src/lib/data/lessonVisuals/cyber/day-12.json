    {
      "partTitle": "Sequential Numeric IDs vs Cryptographic Random Identifiers (UUIDv4)",
      "codeHash": "f30d4b8c70ef0427b3d5c84805f7fcea4e61b2cdf45a420813acd469915f7b5b",
      "spec": {
        "template": "compare",
        "title": "Sequential predictable numeric identifiers versus cryptographic random UUIDs",
        "left": {
          "title": "Sequential Numeric Identifiers",
          "items": [
            "Predictable auto incrementing integer sequences",
            "Attackers systematically scrape and enumerate records",
            "Leaks operational business intelligence and sales rates"
          ]
        },
        "right": {
          "title": "Cryptographic UUID Identifiers",
          "items": [
            "Random one hundred twenty eight bit cryptographic keys",
            "Predicting another valid object identifier is impossible",
            "Prevents enumeration while requiring ownership checks"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Attackers can easily predict and enumerate sequential numbers in an API.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "Random identifiers prevent enumeration but never replace authorization.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Sequential Numeric Identifiers",
        "rightLabel": "Cryptographic UUID Identifiers"
      },
