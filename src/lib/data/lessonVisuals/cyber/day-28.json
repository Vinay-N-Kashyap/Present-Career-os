      "partTitle": "Cross-Account IAM Role Delegation & Confused Deputy Prevention",
      "codeHash": "118d590ab070b699d6d3d09e46df9f4ee768dac32f92f515039ef3a59527dc4a",
      "spec": {
        "template": "compare",
        "title": "Cross-account trust policies without external ID versus hardened delegation",
        "left": {
          "title": "Vulnerable Trust Policy",
          "items": [
            "Lacks sts:ExternalId condition",
            "Vulnerable to confused deputy exploitation",
            "Shared third party SaaS roles reused across tenants",
            "Adversary can access arbitrary customer cloud accounts"
          ]
        },
        "right": {
          "title": "Hardened Trust Policy",
          "items": [
            "Mandates unique secret sts:ExternalId key",
            "Mathematically prevents confused deputy replay",
            "Binds third party role assumption to specific client",
            "Audit logging tracks exact cross account session"
          ]
        },
        "steps": [
          {
            "at": "say7",
            "caption": "External identifier conditions prevent confused deputy attacks on roles.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Shared external secrets ensure third parties only access designated resources.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
