    {
      "partTitle": "Precomputed Rainbow Tables & The Mathematical Invariant of Unique Salts",
      "codeHash": "0210f24bf6a4895be65e1b0d634b3908aba29be77701b7f0d0b4846b2d138d25",
      "spec": {
        "template": "compare",
        "title": "Unsalted hash rainbow table lookups versus unique cryptographic salt defense",
        "left": {
          "title": "Unsalted Hash Vulnerability",
          "items": [
            "Identical passwords generate identical hash digests",
            "Instantaneous reverse lookups via precomputed tables",
            "Single compromised hash reveals thousands of accounts"
          ]
        },
        "right": {
          "title": "Salted Credential Protection",
          "items": [
            "Unique random byte sequence per account credential",
            "Identical passwords produce completely distinct hashes",
            "Forces adversaries to recompute hashes from scratch"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Identical passwords produce matching hashes when unsalted.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "Unique random salts ensure identical passwords produce distinct hashes.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Unsalted Hash Vulnerability",
        "rightLabel": "Salted Credential Protection"
      },
