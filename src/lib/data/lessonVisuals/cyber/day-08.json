    {
      "partTitle": "Cryptographic Signature Verification in Certificate Chains",
      "codeHash": "153eda8c58e99d1f467a88d83e865516a66437ea38ce0388b1fb4034233813c5",
      "spec": {
        "template": "sequence",
        "title": "Certificate chain recursive signature verification sequence",
        "actors": [
          {
            "id": "clientBrowser",
            "label": "Client TLS Agent"
          },
          {
            "id": "leafCert",
            "label": "Server Leaf Cert"
          },
          {
            "id": "intermediateCa",
            "label": "Intermediate CA"
          },
          {
            "id": "rootCa",
            "label": "Root CA Anchor"
          }
        ],
        "messages": [
          {
            "from": "leafCert",
            "to": "clientBrowser",
            "label": "Present Leaf Certificate and Signature",
            "tone": "data"
          },
          {
            "from": "clientBrowser",
            "to": "intermediateCa",
            "label": "Extract Intermediate Public Key to Verify Leaf",
            "tone": "ok"
          },
          {
            "from": "intermediateCa",
            "to": "rootCa",
            "label": "Verify Intermediate Signature Against Root",
            "tone": "ok"
          },
          {
            "from": "rootCa",
            "to": "clientBrowser",
            "label": "Root Found in OS Trust Store Chain Confirmed",
            "tone": "ok"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "The client extracts the public key from the parent certificate.",
            "activeMessageIndex": 1,
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Matching hashes prove the certificate was genuinely issued and unaltered.",
            "activeMessageIndex": 3,
            "statusBadge": "completed"
          }
        ]
      },
