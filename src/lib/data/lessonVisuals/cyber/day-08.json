                "tone": "data"
              },
              {
                "cells": [
                  "Forward Secrecy",
                  "Optional (Static RSA Allowed)",
                  "Mandatory (ECDHE Only)",
                  "Guarantees past sessions stay safe"
                ],
                "tone": "data"
              },
              {
                "cells": [
                  "Supported Ciphers",
                  "Weak CBC and RC4 Permitted",
                  "AEAD Ciphers Exclusively",
                  "Eliminates padding oracle exploits"
