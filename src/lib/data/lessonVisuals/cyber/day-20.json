      "partTitle": "Leaky Bucket vs Sliding Window Log Rate Limiting Algorithms",
      "codeHash": "d8ba1c816a87f204040f3d05958d16170ca45813d27a749f587878c946ea669c",
      "spec": {
        "template": "compare",
        "title": "Token bucket burst accommodation versus sliding window log precision",
        "left": {
          "title": "Token Bucket Burst Allowance",
          "items": [
            "Permits temporary bursts of requests up to capacity limit",
            "Smooth replenishment at constant refill rate over time",
            "Very low memory consumption with only two numeric values"
          ]
        },
        "right": {
          "title": "Sliding Window Log Precision",
          "items": [
            "Records timestamp for every individual request in cache",
            "Eliminates boundary burst flaws with absolute precision",
            "High memory overhead storing logs for millions of users"
          ]
        },
        "steps": [
