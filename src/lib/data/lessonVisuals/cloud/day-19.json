    {
      "partTitle": "The SNS + SQS Fanout Architectural Pattern",
      "codeHash": "61d3c717829ae82c005806ca7dba5bd1f41dc3cd08695dccba9309403a119c96",
      "spec": {
        "template": "sequence",
        "title": "SNS fanout to multiple isolated SQS worker queues sequence",
        "actors": [
          {
            "id": "pub",
            "name": "Order Service"
          },
          {
            "id": "sns",
            "name": "Orders SNS Topic"
          },
          {
            "id": "inv",
            "name": "Inventory Queue"
          },
          {
            "id": "bill",
            "name": "Billing Queue"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "SNS immediately replicates the published event into every subscribed queue.",
            "from": "pub",
            "to": "sns",
            "label": "Publish OrderPlaced",
            "tone": "data"
          },
          {
            "at": "say7",
            "caption": "Each microservice pulls messages from its dedicated SQS queue.",
            "from": "sns",
            "to": "inv",
            "label": "Parallel Fanout Replica",
            "tone": "ok"
          }
        ]
      },
