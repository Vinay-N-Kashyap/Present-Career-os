            "caption": "Publishing to a FIFO topic requires a message group and deduplication id.",
            "active": "published"
          },
          {
            "at": "say7",
            "caption": "Duplicate messages with identical ids are suppressed within the window.",
            "active": "duplicateDiscarded"
          }
        ]
