    {
      "partTitle": "SNS Subscription Filter Policies",
      "codeHash": "c5eb96dc6c8eafe172ee91e3809f5e9e238b97f7d2442544c20897ebee14c925",
      "spec": {
        "template": "compare",
        "title": "Unfiltered topic broadcast compared to subscription filter policy",
        "leftLabel": "Unfiltered Subscription",
        "rightLabel": "Filtered Subscription Policy",
        "steps": [
          {
            "at": "say6",
            "caption": "SNS evaluates the filter policy before delivering messages to endpoints.",
            "left": {
              "code": "No Filter Policy",
              "result": {
                "text": "100% Messages Ingested"
              },
              "tone": "idle"
            },
            "right": {
              "code": "shippingType: [\"express\"]",
              "result": {
                "text": "Targeted Ingestion"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say8",
            "caption": "If attributes match the policy SNS delivers otherwise it discards them.",
            "left": {
              "code": "Unfiltered Waste",
              "result": {
                "text": "Downstream Discard Cost"
              },
              "tone": "error"
            },
            "right": {
              "code": "Server-Side Discard",
              "result": {
                "text": "Zero Waste Delivery"
              },
              "tone": "ok"
            }
          }
        ]
      },
      "filled": {
