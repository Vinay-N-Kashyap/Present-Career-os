      "partTitle": "Standard Workflows vs Express Workflows",
      "codeHash": "fb839cc1185d397a60551b723ca9f8e793b87841e05ec9e786794f9cc4853fd7",
      "spec": {
        "template": "compare",
        "title": "Standard workflows compared to Express workflows",
        "leftLabel": "Standard Workflow",
        "rightLabel": "Express Workflow",
        "steps": [
          {
            "at": "say3",
            "caption": "Standard workflows provide exactly once execution guarantees.",
            "left": {
              "code": "type: \"STANDARD\"",
              "result": {
                "text": "Exactly-Once Guarantee"
              },
              "tone": "ok"
            },
            "right": {
              "code": "type: \"EXPRESS\"",
              "result": {
                "text": "At-Least-Once Delivery"
              },
              "tone": "data"
            }
          },
          {
            "at": "say6",
            "caption": "Express workflows support high rate executions with at least once delivery.",
            "left": {
              "code": "maxExecutionDuration: 1_Year",
              "result": {
                "text": "Audit History 90 Days"
              },
              "tone": "ok"
            },
            "right": {
              "code": "maxExecutionDuration: 5_Min",
              "result": {
                "text": "High-Volume Streaming"
              },
              "tone": "ok"
            }
          }
        ]
