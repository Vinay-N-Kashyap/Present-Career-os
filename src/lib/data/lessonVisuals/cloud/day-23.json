        "title": "ASL error retry backoff rate multiplier and attempt limits",
        "steps": [
          {
            "at": "say4",
            "caption": "A retry block specifies backoff rate and maximum retry attempts.",
            "bars": [
              {
                "label": "Initial Retry Interval",
                "value": 2,
                "max": 10,
                "tone": "data"
              },
              {
                "label": "Exponential Backoff Multiplier",
                "value": 2,
                "max": 10,
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say7",
            "caption": "The catch block transitions seamlessly to a designated fallback state.",
            "bars": [
              {
                "label": "Consecutive Retries Exhausted",
