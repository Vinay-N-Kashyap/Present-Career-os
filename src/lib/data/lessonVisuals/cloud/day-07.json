      "partTitle": "Spot Fleet & Handling the 2-Minute Interruption Notice",
      "codeHash": "6502308de4713d3495713b3c489ab2dd7d75d4c424003c745c725c5d061ab880",
      "spec": {
        "template": "sequence",
        "title": "Spot instance interruption notice handling flow",
        "actors": [
          {
            "id": "aws",
            "name": "EC2 Spot Controller"
          },
          {
            "id": "worker",
            "name": "Spot Node"
          },
          {
            "id": "queue",
            "name": "Task Queue"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Service issues warning notice before terminating spare spot instances.",
            "from": "aws",
            "to": "worker",
            "label": "Interruption Warning",
            "tone": "error"
          },
          {
            "at": "say5",
            "caption": "Background listeners intercept this warning immediately to save state.",
            "from": "worker",
            "to": "queue",
            "label": "Requeue Tasks",
            "tone": "ok"
          }
        ]
      },
