        "leftLabel": "Cold Start (Init + Exec)",
        "rightLabel": "Warm Start (Instant)",
        "steps": [
          {
            "at": "say2",
            "caption": "Cold starts occur when no idle execution environment is available.",
            "left": {
              "code": "New MicroVM Provisioning",
              "result": {
                "text": "Cold Start Latency"
              },
              "tone": "error"
            },
            "right": {
              "code": "Warm Sandbox Reused",
              "result": {
                "text": "Sub-Millisecond"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Placing database connections outside handler optimizes cold start duration.",
            "left": {
              "code": "Inside Handler Init",
              "result": {
                "text": "Repeated Overhead"
              },
              "tone": "error"
            },
            "right": {
              "code": "Outside Handler Cache",
              "result": {
                "text": "Static Reused"
              },
              "tone": "ok"
            }
          }
        ]
