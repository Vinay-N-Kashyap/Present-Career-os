    {
      "partTitle": "Trust Policies (AssumeRolePolicyDocument) vs Permission Policies",
      "codeHash": "06c728ef526c630841ef72132e45284df08cafd6e58c30ffae491cb0ff5367bf",
      "spec": {
        "template": "compare",
        "title": "Trust policies compared to permission policies",
        "leftLabel": "Trust Policy (AssumeRole)",
        "rightLabel": "Permissions Policy (Access)",
        "steps": [
          {
            "at": "say2",
            "caption": "Roles consist of two distinct documents separating trust from permissions.",
            "left": {
              "code": "Principal: ec2.amazonaws.com",
              "result": {
                "text": "Trust Policy"
              },
              "tone": "ok"
            },
            "right": {
              "code": "Action: s3:PutObject",
              "result": {
                "text": "Permissions Policy"
              },
              "tone": "data"
            }
          },
          {
            "at": "say5",
            "caption": "Without explicit allow in trust policy requests reject immediately.",
            "left": {
              "code": "AssumeRole Denied",
              "result": {
                "text": "Access Denied"
              },
              "tone": "error"
            },
            "right": {
              "code": "Role Assumed Successfully",
              "result": {
                "text": "Access Granted"
              },
              "tone": "ok"
            }
          }
        ]
      },
