      "spec": {
        "template": "compare",
        "title": "Direct KMS decrypt compared to in-memory data key caching",
        "leftLabel": "Direct KMS Decrypt Per Request",
        "rightLabel": "Data Key Caching In Memory",
        "steps": [
          {
            "at": "say3",
            "caption": "The application sends only the encrypted ciphertext blob to decrypt.",
            "left": {
              "code": "Call KMS Every Record",
              "result": {
                "text": "API Rate Limit Risk"
              },
              "tone": "idle"
            },
            "right": {
              "code": "Memory Key Cache Hit",
              "result": {
                "text": "Wire-Speed Decrypt"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say7",
            "caption": "Data key caching caches plaintext keys in memory for a configurable time.",
            "left": {
              "code": "kpi: \"High API Invocations\"",
              "result": {
                "text": "Full Latency & Cost"
              },
              "tone": "error"
            },
            "right": {
              "code": "kpi: \"99% Call Reduction\"",
              "result": {
                "text": "Configurable TTL Cache"
              },
              "tone": "ok"
            }
          }
        ]
