    {
      "partTitle": "AWS Transit Gateway (TGW) Architecture: Hub-and-Spoke Routing & Route Table Isolation",
      "codeHash": "f1c58e1fe3eb64c15806fdb60dd318df64fad8f85bfd04fad296500a9367f94f",
      "spec": {
        "template": "workflow",
        "workflow": {
          "title": "AWS Transit Gateway (TGW) Architecture: Hub-and-Spoke Routing & Route Table Isolation",
          "nodes": [
            {
              "id": "spoke_vpc",
              "label": "Application Spoke VPC",
              "status": "active"
            },
            {
              "id": "transit_gateway",
              "label": "AWS Transit Gateway (TGW)",
              "status": "active"
            },
            {
              "id": "inspection_firewall",
              "label": "Inspection VPC & Network Firewall",
              "status": "active"
            },
            {
              "id": "privatelink_target",
              "label": "PrivateLink / Backbone Peer",
              "status": "active"
            }
          ],
          "edges": [
            {
              "from": "spoke_vpc",
              "to": "transit_gateway",
              "label": "Forward Packet via TGW Attach"
            },
            {
              "from": "transit_gateway",
              "to": "inspection_firewall",
              "label": "Route to Suricata DPI Engine"
            },
            {
              "from": "inspection_firewall",
              "to": "privatelink_target",
              "label": "Forward to Hyperplane / Peer"
            }
          ]
        },
        "steps": [
          {
            "at": "say1",
            "focus": "spoke_vpc",
            "annotation": "Spoke VPCs attach to Transit Gateway without requiring full-mesh point-to-point peering."
          },
          {
            "at": "say2",
            "focus": "transit_gateway",
            "annotation": "Transit Gateway route tables enforce Layer 3 isolation and route traffic to inspection hubs."
          },
          {
            "at": "example",
            "focus": "inspection_firewall",
            "annotation": "AWS Network Firewall executes stateful Suricata inspection, dropping unauthorized C2 traffic."
          },
          {
            "at": "tryIt",
            "focus": "privatelink_target",
            "annotation": "PrivateLink and TGW Peering route traffic privately over AWS backbone with MACsec encryption."
          }
        ]
      }
    },
