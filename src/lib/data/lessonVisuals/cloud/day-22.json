        "template": "compare",
        "title": "EC2 launch type compared to AWS Fargate serverless containers",
        "leftLabel": "EC2 Launch Type",
        "rightLabel": "AWS Fargate Serverless",
        "steps": [
          {
            "at": "say3",
            "caption": "EC2 launch types require managing operating system patches and agents.",
            "left": {
              "code": "serverManagement: true",
              "result": {
                "text": "OS Patching Required"
              },
              "tone": "idle"
            },
            "right": {
              "code": "serverManagement: false",
              "result": {
                "text": "Zero Server Overhead"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say8",
            "caption": "Fargate eliminates operational server management and capacity planning.",
            "left": {
              "code": "idleCostRisk: true",
              "result": {
                "text": "Pay for Idle Instances"
              },
              "tone": "error"
            },
            "right": {
              "code": "idleCostRisk: false",
              "result": {
                "text": "Pay Per Task Second"
              },
              "tone": "ok"
            }
          }
        ]
