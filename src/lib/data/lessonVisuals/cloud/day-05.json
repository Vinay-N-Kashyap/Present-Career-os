      "partTitle": "Redundant NAT Gateway Placement",
      "codeHash": "ac8eaa193d0687f3694ea2b83e53895b882dd245bb7254488fda9c71c06aa4e6",
      "spec": {
        "template": "compare",
        "title": "Single NAT gateway failure risk compared to redundant NAT gateways",
        "leftLabel": "Single NAT Gateway",
        "rightLabel": "Dual Redundant NAT Gateways",
        "steps": [
          {
            "at": "say2",
            "caption": "Naïve setup routing both private subnets through single gateway is risky.",
            "left": {
              "code": "Single NAT Gateway",
              "result": {
                "text": "Single Point of Failure"
              },
              "tone": "error"
            },
            "right": {
              "code": "Multi-AZ Redundancy",
              "result": {
                "text": "Fault Tolerant"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Production architecture deploys independent NAT gateways in each public subnet.",
            "left": {
              "code": "AZ Outage Severance",
              "result": {
                "text": "Outage Vulnerable"
              },
              "tone": "error"
            },
            "right": {
              "code": "Independent Gateway per AZ",
              "result": {
                "text": "High Availability"
              },
              "tone": "ok"
            }
          }
        ]
      },
