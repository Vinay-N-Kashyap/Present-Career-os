      "partTitle": "Dead Letter Queue (DLQ) & Poison Pill Payload Handling",
      "codeHash": "34df657e3c7f80884a686a0df921ce681ad482e8b949cadecb5b058fb191be83",
      "spec": {
        "template": "compare",
        "title": "Poison pill failure handling compared to Dead Letter Queue isolation",
        "leftLabel": "Poison Pill Payload",
        "rightLabel": "Dead Letter Queue (DLQ)",
        "steps": [
          {
            "at": "say2",
            "caption": "Malformed payloads and corrupted files crash processing functions.",
            "left": {
              "code": "Corrupted MP4 Payload",
              "result": {
                "text": "Crash on Retry"
              },
              "tone": "error"
            },
            "right": {
              "code": "Isolated SQS Dead Letter",
              "result": {
                "text": "Captured for Analysis"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Routing failed events to a dead letter queue prevents pipeline stalls.",
            "left": {
              "code": "Retries Exhausted",
              "result": {
                "text": "Pipeline Blocked"
              },
              "tone": "error"
            },
            "right": {
              "code": "Forwarded to DLQ",
              "result": {
                "text": "Pipeline Healthy"
              },
              "tone": "ok"
            }
          }
        ]
      },
