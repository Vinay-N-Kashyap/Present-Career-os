      "partTitle": "Standard Queues vs FIFO Queues: Guarantees & Throughput",
      "codeHash": "7180470d4e84aeef1128d47222a75e1dbadc9fa20c843d6e2a7c067fce4e99ab",
      "spec": {
        "template": "compare",
        "title": "Standard queue throughput compared to FIFO queue ordering",
        "leftLabel": "Standard SQS Queue",
        "rightLabel": "FIFO SQS Queue (.fifo)",
        "steps": [
          {
            "at": "say3",
            "caption": "Standard queues guarantee delivery at least once with unlimited throughput.",
            "left": {
              "code": "At-Least-Once Delivery",
              "result": {
                "text": "Nearly Unlimited TPS"
              },
              "tone": "ok"
            },
            "right": {
              "code": "Exactly-Once Processing",
              "result": {
                "text": "Capped 300 TPS"
              },
              "tone": "data"
            }
          },
          {
            "at": "say5",
            "caption": "FIFO queues preserve strict message ordering and guarantee processing.",
            "left": {
              "code": "guaranteesOrder: false",
              "result": {
                "text": "Best-Effort Ordering"
              },
              "tone": "idle"
            },
            "right": {
              "code": "guaranteesOrder: true",
              "result": {
                "text": "Strict First-In-First-Out"
              },
              "tone": "ok"
            }
          }
        ]
      },
