      "partTitle": "What a database is, and why apps need one",
      "codeHash": "081a582af1c1b1b6358c1373d5ad9f68463883ad69ab42cc01ef8a72a95a9b23",
      "spec": {
        "template": "compare",
        "title": "Spreadsheet concurrency limits versus relational database",
        "leftLabel": "Spreadsheet",
        "rightLabel": "Relational Database",
        "steps": [
          {
            "at": "say2",
            "caption": "A spreadsheet gets confused while a database handles many users and data.",
            "left": {
              "code": "concurrent writes",
              "result": {
                "text": "corrupted data"
              },
              "tone": "error"
            },
            "right": {
              "code": "concurrent writes",
              "result": {
                "text": "ACID transactions"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Structured Query Language asks questions reading almost like English.",
            "left": {
              "code": "filter query",
              "result": {
                "text": "manual scan"
              },
              "tone": "data"
            },
            "right": {
              "code": "SELECT * FROM orders",
              "result": {
                "text": "declarative result"
              },
              "tone": "ok"
            }
          }
        ]
      },
