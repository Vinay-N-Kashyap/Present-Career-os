    {
      "partTitle": "The grouping rule",
      "codeHash": "894f16da4fb6b113a82cf6ab614ac83f8646f1101f6452dc7f69fb1372d7c830",
      "spec": {
        "template": "compare",
        "title": "Unaggregated column in SELECT versus valid GROUP BY",
        "leftLabel": "Invalid SELECT",
        "rightLabel": "Valid Aggregated Query",
        "steps": [
          {
            "at": "say2",
            "caption": "Giving one name would be guessing and databases do not guess values.",
            "left": {
              "code": "SELECT category, name",
              "result": {
                "text": "error: ambiguous name"
              },
              "tone": "error"
            },
            "right": {
              "code": "SELECT category, count(*)",
              "result": {
                "text": "deterministic count"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Every column must appear in GROUP BY or be used in an aggregate function.",
            "left": {
              "code": "unaggregated name",
              "result": {
                "text": "fails validation"
              },
              "tone": "error"
            },
            "right": {
              "code": "min(name) AS first_item",
              "result": {
                "text": "Notebook"
              },
              "tone": "ok"
            }
          }
        ]
      },
