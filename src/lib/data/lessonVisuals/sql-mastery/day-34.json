    {
      "partTitle": "Static and Run-Time Partition Pruning: Query Planner and Executor Optimization",
      "codeHash": "8c5cc2ee51590ecf51f65bc55e9936d98144021c310496685e8475a115a2a0e5",
      "spec": {
        "template": "compare",
        "title": "Query Execution Partition Pruning Mechanics",
        "leftLabel": "Unpruned Full Table Scan",
        "rightLabel": "Pruned Targeted Partition Scan",
        "steps": [
          {
            "at": "say1",
            "caption": "Partition pruning is an advanced query optimization technique.",
            "left": {
              "code": "Scans all child table partitions",
              "result": {
                "text": "severe storage I/O waste"
              },
              "tone": "error"
            },
            "right": {
              "code": "Prunes non-matching partitions",
              "result": {
                "text": "scans target partition only"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "PostgreSQL implements partition pruning in distinct execution phases.",
            "left": {
              "code": "Static planner evaluation",
              "result": {
                "text": "prunes constant literal filters"
              },
              "tone": "ok"
            },
            "right": {
              "code": "Run-time executor evaluation",
              "result": {
                "text": "prunes dynamic bound variables"
              },
              "tone": "data"
            }
          },
          {
            "at": "example",
            "caption": "A municipal archive storing property deeds in individual filing cabinets.",
            "left": {
              "code": "Searching all fifty cabinets",
              "result": {
                "text": "hours of manual labor"
              },
              "tone": "error"
            },
            "right": {
              "code": "Opening only target decade cabinet",
              "result": {
                "text": "instant document retrieval"
              },
              "tone": "ok"
            }
          },
          {
            "at": "tryIt",
            "caption": "Execute the warehouse sensor query to verify single partition routing.",
            "left": {
              "code": "Disabled partition pruning",
              "result": {
                "text": "scans all three sensor tables"
              },
              "tone": "error"
            },
            "right": {
              "code": "Enabled partition pruning",
              "result": {
                "text": "reads February partition only"
              },
              "tone": "ok"
            }
          }
        ]
      },
