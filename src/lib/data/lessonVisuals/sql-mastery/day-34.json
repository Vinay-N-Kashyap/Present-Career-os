    {
      "partTitle": "Hash Partitioning for High-Concurrency Write Scaling & Partition-Wise Joins",
      "codeHash": "34759e5e245f520f7399f87c60bc6714c435710408ed681a7595d5dbff02c01f",
      "spec": {
        "template": "compare",
        "title": "Write Hotspotting vs Hash Sharded Ingestion",
        "leftLabel": "Sequential Key Range Hotspotting",
        "rightLabel": "Uniform Hash Partitioning",
        "steps": [
          {
            "at": "say1",
            "caption": "Transactional systems processing high inserts face write hotspotting.",
            "left": {
              "code": "All inserts hit single current partition",
              "result": {
                "text": "controller queue saturation"
              },
              "tone": "error"
            },
            "right": {
              "code": "Inserts hashed across modular shards",
              "result": {
                "text": "balanced concurrent write load"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "The rightmost page split bottleneck creates severe latch contention.",
            "left": {
              "code": "B-tree rightmost leaf split thrashing",
              "result": {
                "text": "write throughput collapse"
              },
              "tone": "error"
            },
            "right": {
              "code": "Distributed modulus hash buckets",
              "result": {
                "text": "independent concurrent buffers"
              },
              "tone": "ok"
            }
          },
          {
            "at": "example",
            "caption": "A stadium entrance where attendees enter through multiple turnstiles.",
            "left": {
              "code": "All attendees crowd single gate",
              "result": {
                "text": "dangerous crush bottleneck"
              },
              "tone": "error"
            },
            "right": {
              "code": "Barcode modulus directs to ten gates",
              "result": {
                "text": "smooth distributed entry"
              },
              "tone": "ok"
            }
          },
          {
            "at": "tryIt",
            "caption": "Execute the high-throughput events query to observe uniform distribution.",
            "left": {
              "code": "Monolithic unpartitioned table",
              "result": {
                "text": "single disk queue bottleneck"
              },
              "tone": "error"
            },
            "right": {
              "code": "Three-way modulus hash partitions",
              "result": {
                "text": "linear throughput scaling"
              },
              "tone": "ok"
            }
          }
        ]
      },
