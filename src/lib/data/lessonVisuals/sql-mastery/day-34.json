      "partTitle": "Zero-Downtime Partition Lifecycle Management: Detaching and Attaching Partitions Concurrently",
      "codeHash": "d0d9199cec211c658f9feff0555cc7d55bfaf21c7b660f9a8b3db31217570db6",
      "spec": {
        "template": "compare",
        "title": "Partition Detachment Concurrency Tradeoffs",
        "leftLabel": "Standard Blocking Detach",
        "rightLabel": "Non-Blocking Concurrent Detach",
        "steps": [
          {
            "at": "say1",
            "caption": "Data lifecycle management enables zero-downtime maintenance operations.",
            "left": {
              "code": "DELETE FROM table WHERE date < cutoff",
              "result": {
                "text": "massive dead tuple bloat"
              },
              "tone": "error"
            },
            "right": {
              "code": "ALTER TABLE DETACH PARTITION",
              "result": {
                "text": "instantaneous metadata uncoupling"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Dropping or archiving an entire seasonal partition requires no row deletion.",
            "left": {
              "code": "Row by row heap deletion",
              "result": {
                "text": "gigabytes of WAL churn"
              },
              "tone": "error"
            },
            "right": {
              "code": "Direct filesystem unlinking",
              "result": {
                "text": "zero WAL churn in milliseconds"
              },
              "tone": "ok"
            }
          },
          {
            "at": "example",
            "caption": "A high-speed passenger train traveling on an express railway track.",
