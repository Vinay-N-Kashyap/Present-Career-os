    {
      "partTitle": "AND, OR and NOT",
      "codeHash": "3d0e17564b938ea69d1c43484c7750ba6d4e3f8161ec45b1d7313375a74e25aa",
      "spec": {
        "template": "compare",
        "title": "Operator precedence and parentheses in SQL WHERE",
        "leftLabel": "Without Brackets",
        "rightLabel": "With Brackets",
        "steps": [
          {
            "at": "say3",
            "caption": "When you mix AND and OR SQL does AND before OR causing confusion.",
            "left": {
              "code": "bags OR home AND cheap",
              "result": {
                "text": "bags OR (home AND cheap)"
              },
              "tone": "error"
            },
            "right": {
              "code": "evaluate precedence",
              "result": {
                "text": "AND evaluates first"
              },
              "tone": "data"
            }
          },
          {
            "at": "say4",
            "caption": "Brackets make your intention clear to PostgreSQL and anyone reading.",
            "left": {
              "code": "Backpack 1200",
              "result": {
                "text": "included by OR"
              },
              "tone": "error"
            },
            "right": {
              "code": "(bags OR home) AND cheap",
              "result": {
                "text": "Tote bag, Cushion"
              },
              "tone": "ok"
            }
          }
        ]
      },
