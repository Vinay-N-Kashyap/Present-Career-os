                "text": "wastes 30% server CPU on parsing and query planning"
              },
              "tone": "error"
            },
            "right": {
              "code": "Parameterized prepared statement",
              "result": {
                "text": "eliminates parse latency; reuses generic plan cache"
              },
              "tone": "ok"
            }
          },
          {
            "at": "example",
            "caption": "Barista serves commuter customers personalized beverage drinks.",
            "left": {
              "code": "Stale plan retained post-DDL",
              "result": {
                "text": "executes against modified schema; risk of memory fault"
              },
              "tone": "error"
            },
            "right": {
              "code": "sinval shared invalidation queue",
              "result": {
                "text": "flags and purges obsolete plan before execution"
              },
              "tone": "ok"
            }
          },
          {
            "at": "tryIt",
            "caption": "Inspect prepared statement lifecycle mechanics and execution phases.",
            "left": {
              "code": "Unmonitored execution time variance",
              "result": {
                "text": "hidden parameter sniffing latency spikes unnoticed"
              },
              "tone": "error"
            },
            "right": {
              "code": "pg_stat_statements stddev monitoring",
              "result": {
                "text": "automated alert detects plan drift for instant triage"
              },
              "tone": "ok"
            }
          }
        ]
      },
