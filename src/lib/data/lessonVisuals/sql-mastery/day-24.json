    {
      "partTitle": "Views for simplicity and safety",
      "codeHash": "bd73edd52a1243d0968ea1eebea3fe46ee45c21641688f58e770319fbda0fe98",
      "spec": {
        "template": "compare",
        "title": "Restricting sensitive columns with access views",
        "leftLabel": "Raw Customers Table",
        "rightLabel": "Public Directory View",
        "steps": [
          {
            "at": "say1",
            "caption": "Views act as a tool for privacy by leaving out sensitive columns.",
            "left": {
              "code": "includes private phone numbers",
              "result": {
                "text": "phone exposed"
              },
              "tone": "error"
            },
            "right": {
              "code": "customer_directory view",
              "result": {
                "text": "phone excluded"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "A view provides a clean friendly interface translating codes into words.",
            "left": {
              "code": "raw status code 'a' or 'i'",
              "result": {
                "text": "cryptic code"
              },
              "tone": "data"
            },
            "right": {
              "code": "CASE status 'active' / 'inactive'",
              "result": {
                "text": "friendly label"
              },
              "tone": "ok"
            }
          }
        ]
      },
