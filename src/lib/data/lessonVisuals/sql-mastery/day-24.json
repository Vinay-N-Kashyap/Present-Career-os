    {
      "partTitle": "Views always show current data",
      "codeHash": "35b13a951f215c78cd65d20f999b47309acba19acd57f26ec5c398f568bc5af2",
      "spec": {
        "template": "compare",
        "title": "Instant reflection of table modifications in views",
        "leftLabel": "Base Table Changes",
        "rightLabel": "Live View Results",
        "steps": [
          {
            "at": "say1",
            "caption": "Changes to underlying tables appear in the view immediately.",
            "left": {
              "code": "INSERT Update prices, complete task 1",
              "result": {
                "text": "table updated"
              },
              "tone": "data"
            },
            "right": {
              "code": "SELECT FROM open_tasks",
              "result": {
                "text": "shows fresh tasks"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Dropping a view never deletes table data because no storage is held.",
            "left": {
              "code": "DROP VIEW open_tasks",
              "result": {
                "text": "saved query removed"
              },
              "tone": "data"
            },
            "right": {
              "code": "SELECT FROM tasks",
              "result": {
                "text": "all rows intact"
              },
              "tone": "ok"
            }
          }
        ]
      },
