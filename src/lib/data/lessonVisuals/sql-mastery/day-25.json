        "title": "Constructing and mutating jsonb values",
        "leftLabel": "SQL Function or Operator",
        "rightLabel": "Resulting JSON Payload",
        "steps": [
          {
            "at": "say1",
            "caption": "Functions build JSON objects and aggregate rows into arrays.",
            "left": {
              "code": "jsonb_build_object('id', id)",
              "result": {
                "text": "{\"id\": 1, \"name\": \"Asha\"}"
              },
              "tone": "data"
            },
            "right": {
              "code": "jsonb_agg(...)",
              "result": {
                "text": "[{...}, {...}] array"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "The concatenation operator merges objects while minus removes keys.",
            "left": {
              "code": "settings || '{\"lang\": \"hi\"}'",
              "result": {
                "text": "adds or overwrites key"
              },
              "tone": "ok"
            },
            "right": {
              "code": "settings - 'coupon'",
              "result": {
                "text": "drops coupon key"
              },
              "tone": "ok"
            }
          }
        ]
