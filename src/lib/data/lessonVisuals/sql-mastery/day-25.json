      "partTitle": "Reading values: -> and ->>",
      "codeHash": "2f07611cb2a4cdaf698ee025119037f53ef0950d258d876d4cfe733faeb0cdb2",
      "spec": {
        "template": "compare",
        "title": "Distinction between JSON operator -> and text operator ->>",
        "leftLabel": "Operator -> (JSON Output)",
        "rightLabel": "Operator ->> (Text Output)",
        "steps": [
          {
            "at": "say1",
            "caption": "The arrow returns JSON whereas double arrow returns plain text.",
            "left": {
              "code": "details -> 'page'",
              "result": {
                "text": "\"/home\" (quoted JSON)"
              },
              "tone": "data"
            },
            "right": {
              "code": "details ->> 'page'",
              "result": {
                "text": "/home (plain text)"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Chained arrows reach inside nested objects and array positions.",
            "left": {
              "code": "details -> 'customer' ->> 'city'",
              "result": {
                "text": "Pune"
              },
              "tone": "ok"
            },
            "right": {
              "code": "details -> 'items' ->> 0",
              "result": {
                "text": "Pen"
              },
              "tone": "ok"
            }
          }
        ]
