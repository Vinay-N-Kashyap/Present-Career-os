    {
      "partTitle": "Why data is split into several tables",
      "codeHash": "e75988cd3751f8add13364d1f6fcc704e25a02e0e0938720738b38645a51c443",
      "spec": {
        "template": "compare",
        "title": "Denormalized duplication versus relational separation",
        "leftLabel": "Single Big Table",
        "rightLabel": "Normalized Relational Tables",
        "steps": [
          {
            "at": "say2",
            "caption": "Keeping everything in one table copies customer address repeatedly.",
            "left": {
              "code": "orders table",
              "result": {
                "text": "address repeated 50 times"
              },
              "tone": "error"
            },
            "right": {
              "code": "customers + orders",
              "result": {
                "text": "address stored once"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "The better design stores each customer once with an id in customers.",
            "left": {
              "code": "update customer move",
              "result": {
                "text": "modify 50 rows"
              },
              "tone": "error"
            },
            "right": {
              "code": "update customer 1",
              "result": {
                "text": "modify 1 row"
              },
              "tone": "ok"
            }
          }
        ]
      },
      "filled": {
