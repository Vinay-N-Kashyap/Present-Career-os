    {
      "partTitle": "Second highest value",
      "codeHash": "b9cd631d22dd06e9c525d5e9facbdf5530d1016017c9a73c9fd41d31b3a534c5",
      "spec": {
        "template": "compare",
        "title": "Tied value handling in second highest salary queries",
        "leftLabel": "Naive LIMIT OFFSET Trap",
        "rightLabel": "DENSE_RANK Window Solution",
        "steps": [
          {
            "at": "say3",
            "caption": "Using dense_rank identifies distinct ranked salaries despite duplicate ties.",
            "left": {
              "code": "dense_rank() OVER (ORDER BY salary)",
              "result": {
                "text": "rank 1: 90000, rank 2: 75000"
              },
              "tone": "data"
            },
            "right": {
              "code": "WHERE dr = 2",
              "result": {
                "text": "returns 75000 accurately"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "A naive offset query returns the duplicate salary when ties exist.",
            "left": {
              "code": "LIMIT 1 OFFSET 1",
              "result": {
                "text": "returns 90000 duplicate"
              },
              "tone": "error"
            },
            "right": {
              "code": "dense_rank() handles ties",
              "result": {
                "text": "skips duplicate top salary"
              },
              "tone": "ok"
            }
          }
        ]
      },
