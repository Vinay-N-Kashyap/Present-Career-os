      "spec": {
        "template": "compare",
        "title": "Comparing join behavior and filter semantics",
        "leftLabel": "INNER JOIN Query Semantics",
        "rightLabel": "LEFT JOIN Query Semantics",
        "steps": [
          {
            "at": "say2",
            "caption": "INNER JOIN keeps matches while LEFT JOIN preserves customers without orders.",
            "left": {
              "code": "customers JOIN orders",
              "result": {
                "text": "excludes Meera (0 orders)"
              },
              "tone": "data"
            },
            "right": {
              "code": "customers LEFT JOIN orders",
              "result": {
                "text": "includes Meera with NULL"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "The WHERE clause filters rows before grouping while HAVING filters groups.",
            "left": {
              "code": "WHERE price < 100",
              "result": {
                "text": "filters rows before aggregate"
              },
              "tone": "data"
            },
            "right": {
              "code": "HAVING count(*) > 5",
              "result": {
                "text": "filters grouped result sets"
              },
              "tone": "ok"
            }
          }
        ]
      },
