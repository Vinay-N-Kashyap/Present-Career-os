    {
      "partTitle": "Why order is never guaranteed",
      "codeHash": "def8a059ba037dcfa03d4e767d53ee80da9a6bcf99b237661a40c3f7e9dc1ade",
      "spec": {
        "template": "compare",
        "title": "Unordered results versus guaranteed ORDER BY",
        "leftLabel": "Without ORDER BY",
        "rightLabel": "With ORDER BY",
        "steps": [
          {
            "at": "say1",
            "caption": "When you run SELECT without asking for order PostgreSQL returns any order.",
            "left": {
              "code": "SELECT name, price",
              "result": {
                "text": "arbitrary order"
              },
              "tone": "error"
            },
            "right": {
              "code": "disk block order",
              "result": {
                "text": "unstable sequence"
              },
              "tone": "data"
            }
          },
          {
            "at": "say3",
            "caption": "If the order matters ask for it with ORDER BY to guarantee sort order.",
            "left": {
              "code": "Pen, Backpack, Notebook",
              "result": {
                "text": "unpredictable"
              },
              "tone": "error"
            },
            "right": {
              "code": "ORDER BY price",
              "result": {
                "text": "12, 60, 899, 1200"
              },
              "tone": "ok"
            }
          }
        ]
      },
