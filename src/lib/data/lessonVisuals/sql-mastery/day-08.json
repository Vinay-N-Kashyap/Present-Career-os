    {
      "partTitle": "SUM and AVG, and how they treat NULL",
      "codeHash": "c62e986d7518f616333892f8e50e9690e5c4c3d5fbbf61d6cf163b8050c1e863",
      "spec": {
        "template": "compare",
        "title": "Aggregate handling of NULL values versus coalesce",
        "leftLabel": "Default NULL Handling",
        "rightLabel": "With coalesce Guard",
        "steps": [
          {
            "at": "say1",
            "caption": "The sum and avg aggregate functions skip NULL values completely.",
            "left": {
              "code": "avg(price)",
              "result": {
                "text": "skips NULL rows"
              },
              "tone": "data"
            },
            "right": {
              "code": "avg(coalesce(price, 0))",
              "result": {
                "text": "includes zero"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "A report showing an empty total looks broken so wrap it with coalesce.",
            "left": {
              "code": "sum(price) on empty",
              "result": {
                "text": "returns NULL"
              },
              "tone": "error"
            },
            "right": {
              "code": "coalesce(sum(price), 0)",
              "result": {
                "text": "returns 0"
              },
              "tone": "ok"
            }
          }
        ]
      },
