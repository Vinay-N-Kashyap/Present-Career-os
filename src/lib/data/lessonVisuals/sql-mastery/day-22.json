    {
      "partTitle": "Errors inside a transaction",
      "codeHash": "b0020505f85cf2994b62b67e43eb56a4356cfd337ace55edd79cd35c37df774a",
      "spec": {
        "template": "compare",
        "title": "Aborting transactions on constraint errors",
        "leftLabel": "Initial Insert Step",
        "rightLabel": "Constraint Error Reversal",
        "steps": [
          {
            "at": "say1",
            "caption": "PostgreSQL marks transaction failed when a constraint violation occurs.",
            "left": {
              "code": "INSERT INTO sales (Pen, 8)",
              "result": {
                "text": "staged in block"
              },
              "tone": "data"
            },
            "right": {
              "code": "UPDATE stock units - 8",
              "result": {
                "text": "error: check units >= 0"
              },
              "tone": "error"
            }
          },
          {
            "at": "say3",
            "caption": "Enforcing all or nothing rules prevents leaving underlying data half-changed.",
            "left": {
              "code": "half-applied partial state",
              "result": {
                "text": "strictly disallowed"
              },
              "tone": "error"
            },
            "right": {
              "code": "automatic abort cleanup",
              "result": {
                "text": "sales row also dropped"
              },
              "tone": "ok"
            }
          }
        ]
      },
