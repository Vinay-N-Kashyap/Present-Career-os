      "partTitle": "ROLLBACK: undoing on purpose",
      "codeHash": "e2e86ecc90396398f54380663cf576f8d43e0ac43090bae9b90628f6f244b91f",
      "spec": {
        "template": "compare",
        "title": "Undoing speculative updates with ROLLBACK",
        "leftLabel": "Uncommitted Modification",
        "rightLabel": "Restored After ROLLBACK",
        "steps": [
          {
            "at": "say1",
            "caption": "The ROLLBACK command throws away uncommitted modifications completely.",
            "left": {
              "code": "price = 0 across table",
              "result": {
                "text": "3 free products"
              },
              "tone": "error"
            },
            "right": {
              "code": "ROLLBACK executed",
              "result": {
                "text": "original prices restored"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "A manual ROLLBACK acts as a safety tool when checking an UPDATE result.",
            "left": {
              "code": "unintended broad UPDATE",
              "result": {
                "text": "caught during inspection"
              },
              "tone": "data"
            },
            "right": {
              "code": "safety reversal invoked",
              "result": {
                "text": "zero damage to database"
              },
              "tone": "ok"
            }
          }
        ]
      },
