    {
      "partTitle": "Parameters: the safe way",
      "codeHash": "4b8d2418405e069b62e64a29148b5415329cd36863875ec6bf1f41352b753ed6",
      "spec": {
        "template": "compare",
        "title": "Parameterized queries separating code and data",
        "leftLabel": "Raw String Embedding",
        "rightLabel": "Parameterized Query",
        "steps": [
          {
            "at": "say1",
            "caption": "Writing queries with placeholders keeps data and SQL logic separate.",
            "left": {
              "code": "query string concat",
              "result": {
                "text": "injection risk"
              },
              "tone": "error"
            },
            "right": {
              "code": "PREPARE find_user($1)",
              "result": {
                "text": "placeholder bound safely"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "The database treats parameter values as data so malicious input is not found.",
            "left": {
              "code": "EXECUTE find_user('Asha')",
              "result": {
                "text": "matches id 1"
              },
              "tone": "ok"
            },
            "right": {
              "code": "EXECUTE with \"' OR '1'='1\"",
              "result": {
                "text": "zero rows returned"
              },
              "tone": "ok"
            }
          }
        ]
      },
