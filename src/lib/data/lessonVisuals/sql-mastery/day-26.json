    {
      "partTitle": "SQL injection: the most important security rule",
      "codeHash": "ea746a2b66ad462d85f61e0c864f1329440bf1eebbd32e6b5d7cf41e0c815408",
      "spec": {
        "template": "compare",
        "title": "String concatenation vulnerability versus parameter isolation",
        "leftLabel": "Vulnerable Concatenation",
        "rightLabel": "SQL Injection Exploitation",
        "steps": [
          {
            "at": "say1",
            "caption": "Gluing input directly into SQL text exposes login queries to tampering.",
            "left": {
              "code": "WHERE name = 'Asha'",
              "result": {
                "text": "finds single user"
              },
              "tone": "data"
            },
            "right": {
              "code": "WHERE name = '' OR '1'='1'",
              "result": {
                "text": "condition always true"
              },
              "tone": "error"
            }
          },
          {
            "at": "say4",
            "caption": "The database cannot distinguish between developer query text and user input.",
            "left": {
              "code": "unparsed merged query string",
              "result": {
                "text": "code and data mixed"
              },
              "tone": "error"
            },
            "right": {
              "code": "unintended execution flow",
              "result": {
                "text": "dumps entire user table"
              },
              "tone": "error"
            }
          }
        ]
      },
