          {
            "at": "say2",
            "caption": "A sequential scan reads every single row to check matching records.",
            "left": {
              "code": "unindexed table scan",
              "result": {
                "text": "checks 50000 rows"
              },
              "tone": "error"
            },
            "right": {
              "code": "indexed lookup B-tree",
              "result": {
                "text": "skips non-matching rows"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "An index sorted structure points to where matching records live.",
            "left": {
              "code": "unordered heap access",
