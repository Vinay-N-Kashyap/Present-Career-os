    {
      "partTitle": "EXPLAIN: seeing the plan",
      "codeHash": "fb1a304b21379b1f36daa0b134c2ae6887de0d55031c1113791a5004650692dc",
      "spec": {
        "template": "compare",
        "title": "Comparing query execution plans with EXPLAIN",
        "leftLabel": "Unindexed Query Plan",
        "rightLabel": "Indexed Query Plan",
        "steps": [
          {
            "at": "say2",
            "caption": "The plan shows whether PostgreSQL runs a Seq Scan or uses an index.",
            "left": {
              "code": "EXPLAIN SELECT customer_id = 42",
              "result": {
                "text": "Seq Scan on orders"
              },
              "tone": "data"
            },
            "right": {
              "code": "EXPLAIN SELECT id = 42",
              "result": {
                "text": "Index Scan on orders_pkey"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say5",
            "caption": "Reading query plans reveals whether PostgreSQL scans whole table or index.",
            "left": {
              "code": "Seq Scan + Filter",
              "result": {
                "text": "inspects whole table"
              },
              "tone": "error"
            },
            "right": {
              "code": "Index Scan on key",
              "result": {
                "text": "retrieves exact pointer"
              },
              "tone": "ok"
            }
          }
        ]
