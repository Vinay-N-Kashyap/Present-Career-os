      "spec": {
        "template": "compare",
        "title": "Full table qualifiers versus table aliases",
        "leftLabel": "Full Table Names",
        "rightLabel": "Table Aliases",
        "steps": [
          {
            "at": "say1",
            "caption": "SQL lets you give each table a short alias right after its name.",
            "left": {
              "code": "customers.name, orders.id",
              "result": {
                "text": "verbose syntax"
              },
              "tone": "data"
            },
            "right": {
              "code": "c.name, o.id",
              "result": {
                "text": "concise alias"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "The query becomes much shorter and easier to read with aliases.",
            "left": {
              "code": "unaliased join",
              "result": {
                "text": "cluttered query"
              },
              "tone": "data"
            },
            "right": {
              "code": "FROM orders o JOIN customers c",
              "result": {
                "text": "clean readable"
              },
              "tone": "ok"
            }
          }
