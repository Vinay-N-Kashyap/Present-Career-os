      "partTitle": "Simple CASE and cleaning codes into words",
      "codeHash": "16ca21a7b1c8f344739a39a947b4b9a10cd1acf377d2ae1ff0a4993940237094",
      "spec": {
        "template": "compare",
        "title": "Mapping status codes to human readable text",
        "leftLabel": "Short Code: status",
        "rightLabel": "Readable Text: status_text",
        "steps": [
          {
            "at": "say2",
            "caption": "Compact codes are translated into readable words for people.",
            "left": {
              "code": "status = 'o'",
              "result": {
                "text": "'o'"
              },
              "tone": "data"
            },
            "right": {
              "code": "WHEN 'o' THEN 'Open'",
              "result": {
                "text": "'Open'"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "The fallback ELSE branch catches unexpected codes preventing a silent NULL.",
            "left": {
              "code": "unhandled code 'x'",
              "result": {
                "text": "NULL"
              },
              "tone": "error"
            },
            "right": {
              "code": "ELSE 'Unknown code: ' || status",
              "result": {
                "text": "'Unknown code: x'"
              },
              "tone": "ok"
            }
          }
        ]
      },
