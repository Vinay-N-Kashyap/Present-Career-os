    {
      "partTitle": "Text functions",
      "codeHash": "b783ca9c15ce9d2cc697bb015760af9f5d6c0c0892e2a4bb435d732becaf779d",
      "spec": {
        "template": "compare",
        "title": "Raw messy customer strings versus cleaned formatted output",
        "leftLabel": "Raw Input",
        "rightLabel": "Cleaned Result",
        "steps": [
          {
            "at": "say1",
            "caption": "The initcap function makes the first letter of each word a capital.",
            "left": {
              "code": "asha RAO",
              "result": {
                "text": "irregular casing"
              },
              "tone": "error"
            },
            "right": {
              "code": "initcap(trim(name))",
              "result": {
                "text": "Asha Rao"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "The trim function removes spaces at the start and the end cleanly.",
            "left": {
              "code": "'  asha'",
              "result": {
                "text": "leading spaces"
              },
              "tone": "error"
            },
            "right": {
              "code": "trim('  asha')",
              "result": {
                "text": "'asha'"
              },
              "tone": "ok"
            }
          }
        ]
      },
