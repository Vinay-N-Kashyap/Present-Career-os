      "partTitle": "ILIKE: search without worrying about capitals",
      "codeHash": "c464e4de5ace6c97d4db9487e6c7f7d2404e4828db6ca4f3cb8f0617e1bc4356",
      "spec": {
        "template": "compare",
        "title": "Case-sensitive LIKE versus case-insensitive ILIKE",
        "leftLabel": "LIKE (Case Sensitive)",
        "rightLabel": "ILIKE (Case Insensitive)",
        "steps": [
          {
            "at": "say1",
            "caption": "PostgreSQL has ILIKE which ignores capital letters in text search.",
            "left": {
              "code": "LIKE 'head%'",
              "result": {
                "text": "case sensitive"
              },
              "tone": "error"
            },
            "right": {
              "code": "ILIKE 'head%'",
              "result": {
                "text": "case insensitive"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "For most search boxes in applications ILIKE is what you want.",
            "left": {
              "code": "search 'HEAD%' with LIKE",
              "result": {
                "text": "zero matches"
              },
              "tone": "error"
            },
            "right": {
              "code": "search 'HEAD%' with ILIKE",
              "result": {
                "text": "Headphones"
              },
              "tone": "ok"
            }
          }
        ]
