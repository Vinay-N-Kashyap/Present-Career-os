    {
      "partTitle": "Veg and non-veg, and the busiest hour",
      "codeHash": "491873254870347e86fdd0316971a854620928ec2ea8eefa4c680b8be8744cea",
      "spec": {
        "template": "compare",
        "title": "Dietary revenue split and hourly order volume",
        "leftLabel": "Dietary Revenue Split",
        "rightLabel": "Peak Hour Ordering",
        "steps": [
          {
            "at": "say1",
            "caption": "Conditional aggregation divides revenue between veg and non-veg dishes.",
            "left": {
              "code": "FILTER (WHERE is_veg)",
              "result": {
                "text": "260.00 (65.0%)"
              },
              "tone": "ok"
            },
            "right": {
              "code": "FILTER (WHERE NOT is_veg)",
              "result": {
                "text": "140.00 (35.0%)"
              },
              "tone": "data"
            }
          },
          {
            "at": "say3",
            "caption": "Extracting the hour groups order volume to identify peak canteen times.",
