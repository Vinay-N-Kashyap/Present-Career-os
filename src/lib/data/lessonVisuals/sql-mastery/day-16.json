      "partTitle": "WITH versus subqueries",
      "codeHash": "8b5da2147ca3a0a8a22fed9221fc99bdf7815a0b3158afa7ff24b49a98cd365f",
      "spec": {
        "template": "compare",
        "title": "Nested subquery versus common table expression clarity",
        "leftLabel": "Nested Subquery",
        "rightLabel": "Common Table Expression (CTE)",
        "steps": [
          {
            "at": "say2",
            "caption": "A WITH query is read from top to bottom in the order steps happen.",
            "left": {
              "code": "nested brackets",
              "result": {
                "text": "inside out reading"
              },
              "tone": "error"
            },
            "right": {
              "code": "WITH step_name AS (...)",
              "result": {
                "text": "top to bottom flow"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "The WITH clause lets you use the same step without repeating queries.",
            "left": {
              "code": "copy SQL twice",
              "result": {
                "text": "redundant duplicate"
              },
              "tone": "error"
            },
            "right": {
              "code": "reference CTE",
              "result": {
                "text": "single definition"
              },
              "tone": "ok"
            }
          }
        ]
      },
