        "title": "Role enforcement blocking unauthorized DML operations",
        "leftLabel": "Permitted Read Operation",
        "rightLabel": "Refused Write Operation",
        "steps": [
          {
            "at": "say1",
            "caption": "Switching session identity with SET ROLE tests assigned permissions directly.",
            "left": {
              "code": "SET ROLE report_reader",
              "result": {
                "text": "acting as read-only role"
              },
              "tone": "data"
            },
            "right": {
              "code": "SELECT sum(amount)",
              "result": {
                "text": "query succeeds (1200.00)"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "PostgreSQL protects data with permission denied when unauthorized writes occur.",
