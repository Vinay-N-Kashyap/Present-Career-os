      "partTitle": "Copying and restoring tables",
      "codeHash": "284889316b6727e73cb1cb4b1d1a4c3f6a81b3b62ba4ea0c95758a28cac9cfb5",
      "spec": {
        "template": "compare",
        "title": "Safety tables and row restoration after unintended delete",
        "leftLabel": "Post Accident Table",
        "rightLabel": "Restored from Backup",
        "steps": [
          {
            "at": "say2",
            "caption": "Inserting from the backup table restores missing rows after an accident.",
            "left": {
              "code": "DELETE FROM products",
              "result": {
                "text": "0 rows left"
              },
              "tone": "error"
            },
            "right": {
              "code": "INSERT SELECT * FROM backup",
              "result": {
                "text": "3 rows restored"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "A transaction provides a safer habit with rollback for planned changes.",
            "left": {
              "code": "uncommitted session work",
              "result": {
                "text": "isolated changes"
              },
              "tone": "data"
            },
            "right": {
              "code": "ROLLBACK safety escape",
              "result": {
                "text": "clean revert on mistake"
              },
              "tone": "ok"
            }
          }
        ]
      },
