      "partTitle": "Running totals with SUM OVER",
      "codeHash": "ebca88d592684ef0593fd42319552d84028b2c6d25b6de69d4ac060d4e933c80",
      "spec": {
        "template": "compare",
        "title": "Progressive running total versus constant grand total",
        "leftLabel": "Grand Total: OVER ()",
        "rightLabel": "Running Total: OVER (ORDER BY day)",
        "steps": [
          {
            "at": "say2",
            "caption": "The ORDER BY inside OVER adds up all rows from start up to current row.",
            "left": {
              "code": "OVER ()",
              "result": {
                "text": "constant 4337 on all rows"
              },
              "tone": "data"
            },
            "right": {
              "code": "OVER (ORDER BY day)",
              "result": {
                "text": "280, 1480, 3577, 4337"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Without an order clause the function gives the grand total on every row.",
            "left": {
              "code": "sum(amount) OVER ()",
              "result": {
                "text": "unaccumulated aggregate"
              },
              "tone": "data"
            },
            "right": {
              "code": "sum() OVER (ORDER BY)",
              "result": {
                "text": "growing accumulation"
              },
              "tone": "ok"
            }
          }
        ]
      },
