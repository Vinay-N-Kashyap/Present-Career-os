    {
      "partTitle": "EXISTS and correlated subqueries",
      "codeHash": "7d8caa19b088b81e772567c3aafa3ef0c9e9302fe584b0eba19d36d4e76266e9",
      "spec": {
        "template": "compare",
        "title": "EXISTS versus NOT EXISTS correlated filtering",
        "leftLabel": "EXISTS Condition",
        "rightLabel": "NOT EXISTS Condition",
        "steps": [
          {
            "at": "say1",
            "caption": "EXISTS asks a question whether the subquery returns at least one row.",
            "left": {
              "code": "EXISTS (SELECT 1)",
              "result": {
                "text": "keeps active customers"
              },
              "tone": "ok"
            },
            "right": {
              "code": "correlated c.id = o.customer_id",
              "result": {
                "text": "stops on first match"
              },
              "tone": "data"
            }
          },
          {
            "at": "say3",
            "caption": "NOT EXISTS is the safest way to find rows with no matching orders.",
            "left": {
              "code": "NOT IN (orders)",
              "result": {
                "text": "fails if NULL present"
              },
              "tone": "error"
            },
            "right": {
              "code": "NOT EXISTS",
              "result": {
                "text": "Meera (reliable)"
              },
              "tone": "ok"
            }
          }
        ]
      },
