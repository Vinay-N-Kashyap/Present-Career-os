      "partTitle": "UNION: stacking results",
      "codeHash": "58400421f914b065e32ec52f4cde125346f0666720b49511bd735533e54d955f",
      "spec": {
        "template": "compare",
        "title": "Horizontal joins versus vertical UNION stacking",
        "leftLabel": "Horizontal JOIN",
        "rightLabel": "Vertical UNION",
        "steps": [
          {
            "at": "say1",
            "caption": "Joins put tables side by side while UNION stacks results on top.",
            "left": {
              "code": "JOIN tables",
              "result": {
                "text": "side by side columns"
              },
              "tone": "data"
            },
            "right": {
              "code": "UNION queries",
              "result": {
                "text": "stacked rows"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Plain UNION also removes duplicate rows keeping unique entries once.",
            "left": {
              "code": "Pune in both tables",
              "result": {
                "text": "duplicate record"
              },
              "tone": "data"
            },
            "right": {
              "code": "UNION result",
              "result": {
                "text": "Pune appears once"
              },
              "tone": "ok"
            }
          }
        ]
      },
