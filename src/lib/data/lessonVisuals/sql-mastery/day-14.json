    {
      "partTitle": "UNION ALL: keep every row",
      "codeHash": "d2d78b37cb6db95079549b8cbd2d822dc7b800682021f39fec6f6c22a5447481",
      "spec": {
        "template": "compare",
        "title": "Deduplicated UNION versus UNION ALL row preservation",
        "leftLabel": "UNION (Deduplicated)",
        "rightLabel": "UNION ALL (All Rows)",
        "steps": [
          {
            "at": "say1",
            "caption": "The UNION ALL keeps every row including duplicates without checking.",
            "left": {
              "code": "UNION sum(amount)",
              "result": {
                "text": "1650 (dropped 250)"
              },
              "tone": "error"
            },
            "right": {
              "code": "UNION ALL sum(amount)",
              "result": {
                "text": "1900 (accurate)"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Use UNION ALL when duplicates are real and meaningful for true totals.",
            "left": {
              "code": "duplicate 250 dropped",
              "result": {
                "text": "wrong calculation"
              },
              "tone": "error"
            },
            "right": {
              "code": "both 250 kept",
              "result": {
                "text": "correct total"
              },
              "tone": "ok"
            }
          }
        ]
      },
