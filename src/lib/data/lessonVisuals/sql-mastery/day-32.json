      "partTitle": "B+ Tree Physical Layout: Slotted Pages, Fillfactor, Leaf Page Doubly Linked Lists & High-Concurrency Latching",
      "codeHash": "0bc7cdfc5bd79b2fda89101350b0f9e680efd0f53b231e08f8bdc09814944f54",
      "spec": {
        "template": "compare",
        "title": "B-Tree Slotted Page Fillfactor Allocation Tradeoffs",
        "leftLabel": "Full Fillfactor Allocation",
        "rightLabel": "Reduced Fillfactor Headroom",
        "steps": [
          {
            "at": "say1",
            "caption": "In relational database architecture the tree remains foundational.",
            "left": {
              "code": "fillfactor = 100% density",
              "result": {
                "text": "zero free space headroom"
              },
              "tone": "data"
            },
            "right": {
              "code": "fillfactor = 75% density",
              "result": {
                "text": "reserved update headroom"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "The physical architecture of a single database page follows slotted layout.",
            "left": {
              "code": "pd_lower meets pd_upper",
              "result": {
                "text": "immediate page split risk"
              },
              "tone": "error"
            },
            "right": {
              "code": "free space between pointers",
              "result": {
                "text": "absorbs in-place updates"
              },
              "tone": "ok"
            }
          },
          {
            "at": "example",
            "caption": "A corporate physical archive storing client document binders in vaults.",
            "left": {
              "code": "Overflowing binder split in two",
              "result": {
                "text": "costly archive reorganization"
              },
              "tone": "error"
            },
            "right": {
              "code": "Empty binder sleeves reserved",
              "result": {
                "text": "smooth document filing"
              },
              "tone": "ok"
            }
          },
          {
            "at": "tryIt",
            "caption": "Execute the slotted page layout query to evaluate fillfactor free space.",
            "left": {
              "code": "Imminent Leaf Page Split",
              "result": {
                "text": "critical split risk"
              },
              "tone": "error"
            },
            "right": {
              "code": "Absorbing Concurrent Inserts",
              "result": {
                "text": "healthy operation"
              },
              "tone": "ok"
            }
          }
        ]
      },
