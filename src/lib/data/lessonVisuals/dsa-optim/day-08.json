    {
      "partTitle": "Fast & Slow Pointers (Floyd's Cycle Detection)",
      "codeHash": "14e458d9cf83ba8a5fe35dce04c62c383e086b6217218fb75354f25c9332aa8b",
      "spec": {
        "template": "compare",
        "title": "Fast and slow pointer cycle detection",
        "leftLabel": "Slow Pointer",
        "rightLabel": "Fast Pointer",
        "steps": [
          {
            "at": "say2",
            "caption": "Slow pointer advances while fast pointer advances faster.",
            "left": {
              "code": "slow = slow!.next",
              "result": {
                "text": "1"
              },
              "tone": "data"
            },
            "right": {
              "code": "fast = fast.next.next",
              "result": {
                "text": "2"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Fast pointer eventually laps slow pointer inside cycle.",
            "left": {
              "code": "slow === fast",
              "result": {
                "text": "true"
              },
              "tone": "ok"
            },
            "right": {
              "code": "fast === null",
              "result": {
                "text": "false"
              },
              "tone": "error"
            }
          }
        ]
      },
