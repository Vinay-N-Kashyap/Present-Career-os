        "title": "Generic comparator min-heap vs max-heap ordering",
        "left": {
          "title": "Min-Heap Comparator",
          "items": [
            {
              "label": "Order",
              "value": "(a, b) => a - b"
            },
            {
              "label": "Priority",
              "value": "Smallest at root"
            }
          ]
        },
        "right": {
          "title": "Max-Heap Comparator",
          "items": [
            {
              "label": "Order",
              "value": "(a, b) => b - a"
            },
            {
              "label": "Priority",
              "value": "Largest at root"
            }
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Min heap comparator returns negative value when first item is smaller.",
