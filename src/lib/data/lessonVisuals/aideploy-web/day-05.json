    {
      "partTitle": "Prompt Injection Defense & Delimiter Neutralization",
      "codeHash": "7df561d10519125e0bb1fac702c175de10a05dedf11368eab19c884cb6f96788",
      "spec": {
        "template": "compare",
        "title": "Raw Malicious Input vs Sanitized Output",
        "leftLabel": "Raw User Input (Dangerous)",
        "rightLabel": "Sanitized Output (Neutralized)",
        "leftItems": [
          "Contains <|im_start|> control token",
          "Fake System: header impersonates authority",
          "Unescaped delimiters trick the tokenizer",
          "Model interprets user text as system prompt"
        ],
        "rightItems": [
          "Replaced with [ESC_IM_START] safe token",
          "System: rewritten to [$1_del]: prefix",
          "All injection delimiters fully neutralized",
          "Model receives only intended user content"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Injection exploits special chat control delimiters like im_start.",
            "highlightSide": "left"
          },
          {
            "at": "say7",
            "caption": "Delimiters are escaped into harmless bracketed representations.",
            "highlightSide": "right"
          }
        ]
      },
