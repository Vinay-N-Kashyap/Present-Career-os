    {
      "partTitle": "Message History Window Pruning (Sliding Budget)",
      "codeHash": "78d2558b98f792a6084ab25e4b76ab5eafbdd64145e96ee6c03114daee9a3672",
      "spec": {
        "template": "flow",
        "title": "Reverse-Chronological Sliding History Pruner (350t Budget)",
        "subtitle": "Pinning system prompt (50t) while retaining newest turns (150t + 90t = 290t)",
        "nodes": [
          {
            "id": "n1",
            "label": "Index 0: System (50t)",
            "sublabel": "Always pinned",
            "tappable": false
          },
          {
            "id": "n2",
            "label": "Turn 4 & 3 (150t + 90t)",
            "sublabel": "Retained (290t <= 350t)",
            "tappable": false
          },
          {
            "id": "n3",
            "label": "Turn 2 & 1 (120t + 80t)",
            "sublabel": "Pruned (exceeds 350t)",
            "tappable": false
          },
          {
            "id": "n4",
            "label": "Pruned Array (3 msgs)",
            "sublabel": "[system, user, assistant]",
            "tappable": false
          }
        ],
        "edges": [
          {
            "from": "n1",
            "to": "n2",
            "label": "walk backwards"
          },
          {
            "from": "n2",
            "to": "n3",
            "label": "budget full"
          },
          {
            "from": "n2",
            "to": "n4",
            "label": "unshift retained"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "The pruning algorithm preserves system instructions and traverses backwards.",
            "activeNodes": [
              "n1",
              "n2"
            ],
            "statusBadge": "active"
          },
          {
            "at": "say5",
            "caption": "Older dialog turns accumulate in reverse order until the token budget fills.",
            "activeNodes": [
              "n1",
              "n2",
              "n3",
              "n4"
            ],
            "statusBadge": "completed"
          }
        ]
      },
