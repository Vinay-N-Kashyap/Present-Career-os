          {
            "id": "s1",
            "name": "Base Chars (7)",
            "subtext": "['t','h','e',' ','c','a','t']"
          },
          {
            "id": "s2",
            "name": "Bigram Merges",
            "subtext": "('t','h')->'th', ('c','a')->'ca'"
          },
          {
            "id": "s3",
            "name": "Word Merges",
            "subtext": "('th','e')->'the', ('ca','t')->'cat'"
          },
          {
            "id": "s4",
            "name": "Final Tokens (3)",
            "subtext": "['the', ' ', 'cat']"
