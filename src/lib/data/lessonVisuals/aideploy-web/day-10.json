      "partTitle": "RPM vs TPM Dual-Metering Architecture",
      "codeHash": "22d46493f9d3308e3ce23e575fa25b1329fa2776e85dfc6557b4b30a0f99adc6",
      "spec": {
        "template": "compare",
        "title": "Single Metric RPM vs Dual RPM & TPM Metering",
        "leftLabel": "RPM-Only Metering (Vulnerable)",
        "rightLabel": "Dual RPM & TPM Quota (Protected)",
        "leftItems": [
          "Only counts raw request volume",
          "Ignores prompt and generation sizes",
          "1 query consuming 64k tokens passes",
          "Permits GPU monopolization and cost spikes"
        ],
        "rightItems": [
          "Meters Requests Per Minute (RPM)",
          "Enforces Tokens Per Minute (TPM) cap",
          "Calculates projected token consumption",
          "Guarantees multi-tenant fairness and budget"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Request volume alone is a misleading indicator of model resource usage.",
            "highlightSide": "left"
          },
          {
            "at": "say6",
            "caption": "Production gateways implement dual-quota metering for requests and tokens.",
            "highlightSide": "right"
          }
        ]
      },
