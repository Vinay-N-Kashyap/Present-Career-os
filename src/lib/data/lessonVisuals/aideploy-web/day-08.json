    {
      "partTitle": "Euclidean Distance vs Cosine Proximity",
      "codeHash": "680363ddaa6abd8b4ff4d3490625a38c14c68c92dc9795735f176c57c90357fe",
      "spec": {
        "template": "compare",
        "title": "Cosine Similarity vs Euclidean Distance",
        "leftLabel": "Cosine Similarity Metric",
        "rightLabel": "Euclidean L2 Distance Metric",
        "leftItems": [
          "Measures angular orientation between vectors",
          "Bounded range from -1.0 to +1.0",
          "Higher score indicates closer resemblance",
          "Equivalent to dot product when normalized"
        ],
        "rightItems": [
          "Measures straight-line distance in space",
          "Values range from 0.0 to infinity",
          "Lower value indicates closer proximity",
          "Dist squared equals 2 * (1 - CosSim) on unit sphere"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Higher cosine scores show resemblance while lower Euclidean distance is closer.",
            "highlightSide": "left"
          },
          {
            "at": "say6",
            "caption": "On unit vectors Euclidean distance squared equals two times one minus cosine.",
            "highlightSide": "right"
          }
        ]
      },
