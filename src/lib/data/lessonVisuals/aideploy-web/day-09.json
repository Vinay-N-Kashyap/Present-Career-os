      "partTitle": "Why Exact Hashing Fails for Natural Language Queries",
      "codeHash": "c5a71034eaa7f28271a6cb6f6d306c8721620981c6b853790c77e6e05f6ccbe6",
      "spec": {
        "template": "compare",
        "title": "Exact Key Hashing vs Vector Semantic Caching",
        "leftLabel": "Exact String Hashing (MD5/SHA)",
        "rightLabel": "Vector Semantic Caching",
        "leftItems": [
          "Fails on tiny wording differences",
          "Plurals and spaces create hash miss",
          "Forces unnecessary expensive LLM calls",
          "Misses up to 40% of identical intents"
        ],
        "rightItems": [
          "Embeds queries into continuous latent space",
          "Matches questions by cosine similarity",
          "Delivers instant sub-10ms cache hits",
          "Captures varied phrasing of same intent"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Natural language questions share user intent despite differing characters.",
            "highlightSide": "left"
          },
          {
            "at": "say8",
            "caption": "Semantic caching matches queries using vector embedding similarity distance.",
            "highlightSide": "right"
          }
        ]
      },
