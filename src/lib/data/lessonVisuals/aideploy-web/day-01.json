    {
      "partTitle": "Transient Failure Classification: 429s, 500s & 503s",
      "codeHash": "466af446003dc8ce7b3ae7444125f919813c68e3452b332dc3b84c95d46ac6db",
      "spec": {
        "template": "compare",
        "title": "Permanent 4xx Errors vs Transient 429/5xx Failures",
        "leftLabel": "Permanent Failures (Fail Fast)",
        "rightLabel": "Transient Failures (Retryable)",
        "leftItems": [
          "401 / 403 -> AUTH_ERROR (shouldRetry: false)",
          "400 / 404 / 422 -> BAD_REQUEST",
          "Immediate abort saves quota and sockets",
          "Requires credential or payload fix"
        ],
        "rightItems": [
          "429 -> RATE_LIMIT (honors Retry-After: 3s)",
          "500..599 -> SERVER_ERROR (503 Unavailable)",
          "isTransient: true, shouldRetry: true",
          "Recovers via jittered exponential backoff"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Client errors like Unauthorized represent permanent auth or code failures.",
            "highlightSide": "left"
          },
          {
            "at": "say5",
            "caption": "Internal Server Error and Service Unavailable are classic transient errors.",
            "highlightSide": "right"
          }
        ]
      },
      "filled": {
