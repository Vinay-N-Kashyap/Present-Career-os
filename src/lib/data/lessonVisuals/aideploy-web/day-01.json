    {
      "partTitle": "Timeout Ceilings & AbortController Signal Handling",
      "codeHash": "b9d387ccbc6ca0ce8c588a16467fa480f96a17ab0261384c583efa7d56fd2a38",
      "spec": {
        "template": "workflow",
        "title": "TimeoutGovernor Signal & Timer Lifecycle",
        "subtitle": "Enforcing strict client deadline ceilings and deterministic timer cleanup",
        "stages": [
          {
            "id": "s1",
            "name": "Budget Signal",
            "subtext": "createBudgetedSignal(50)"
          },
          {
            "id": "s2",
            "name": "Deadline Timer",
            "subtext": "setTimeout(timeoutMs)"
          },
          {
            "id": "s3",
            "name": "Abort Trigger",
            "subtext": "mockController.abort()"
          },
          {
            "id": "s4",
            "name": "Timer Cleanup",
            "subtext": "clearTimeout(timerId)"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "When inference exceeds its configured deadline, the timer triggers abort.",
            "activeStageId": "s3",
            "statusBadge": "active"
          },
          {
            "at": "say9",
            "caption": "Always clear active timeout timers so event loops do not remain pinned.",
            "activeStageId": "s4",
            "statusBadge": "completed"
          }
        ]
      },
