      "spec": {
        "template": "boxes",
        "title": "A box keeps only its newest value",
        "boxes": [
          {
            "id": "balance",
            "label": "balance"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "balance starts at 500.",
            "values": {
              "balance": {
