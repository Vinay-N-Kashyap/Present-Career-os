      "partTitle": "Capital letters matter",
      "codeHash": "4a6a443e8de280c1941c3d0bde2584175ba4347e5783b6d326d2a5983d460a6c",
      "spec": {
        "template": "compare",
        "title": "Small and capital letters are different",
        "leftLabel": "print",
        "rightLabel": "Print",
        "steps": [
          {
            "at": "say1",
            "caption": "Python knows print, not Print.",
            "left": {
              "code": "print(\"hello\")",
              "result": "hello",
              "tone": "ok",
              "checks": [
                "hello"
              ]
            },
            "right": {
              "code": "Print(\"hello\")",
              "result": "NameError",
              "tone": "error",
              "checks": [
                "NameError"
              ],
              "whatIf": "Print(\"hello\")"
            }
          },
          {
            "at": "say3",
            "caption": "Inside quotes any letters work, but H and h are still different.",
            "left": {
              "code": "print(\"HELLO\")",
              "result": "HELLO",
              "tone": "ok",
              "checks": [
                "HELLO"
              ]
            },
            "right": {
              "code": "print(\"Hello\" == \"hello\")",
              "result": "False",
              "tone": "data",
              "checks": [
                "False"
              ]
            }
          }
        ]
      },
