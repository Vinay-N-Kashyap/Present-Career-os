          {
            "id": "doubled",
            "label": "doubled"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "A list comprehension builds a new list in one line.",
            "values": {
              "prices": {
                "var": "prices",
                "line": 1
              },
              "doubled": {
                "text": "[p * 2 for p in prices]"
