      "spec": {
        "template": "boxes",
        "title": "Importing tools from modules",
        "boxes": [
          {
            "id": "math",
            "label": "math"
          },
          {
            "id": "pi",
            "label": "pi"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "To use a module import it at the top of your file.",
            "values": {
              "math": {
                "text": "import math"
              },
              "pi": {
                "text": "math.sqrt(16)"
              }
            },
            "tones": {
              "math": "data",
              "pi": "idle"
            }
          },
          {
            "at": "say3",
            "caption": "Import just the tools you need directly without module name.",
            "values": {
              "math": {
                "text": "from math import pi"
              },
              "pi": {
                "var": "pi",
                "line": 5
              }
            },
            "tones": {
              "math": "data",
              "pi": "ok"
            }
          }
        ]
      },
