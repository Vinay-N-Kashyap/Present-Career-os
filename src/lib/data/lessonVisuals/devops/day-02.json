    {
      "partTitle": "Linux Permissions, UIDs & The Principle of Least Privilege",
      "codeHash": "40e98231251e6216347b51e5f9aed5c2ccbd977d7806cb08834568e33a2466e6",
      "spec": {
        "template": "compare",
        "title": "Linux user privilege and file permission audit",
        "leftLabel": "Insecure Root (UID 0)",
        "rightLabel": "Unprivileged User (UID 10001)",
        "steps": [
          {
            "at": "say3",
            "caption": "Running as root inside container introduces physical host security risk.",
            "left": {
              "code": "USER root (UID 0)",
              "result": {
                "text": "HIGH_RISK"
              },
              "tone": "error"
            },
            "right": {
              "code": "USER appuser (UID 10001)",
              "result": {
                "text": "ISOLATED"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "Principle of least privilege mandates processes run with minimum access.",
            "left": {
              "code": "chmod 777 /app",
              "result": {
                "text": "WORLD_WRITABLE"
              },
              "tone": "error"
            },
            "right": {
              "code": "chmod 755 /app",
              "result": {
                "text": "RESTRICTED"
              },
              "tone": "ok"
            }
          }
        ]
      },
