      "partTitle": "User-Defined Bridge Networks & Service Discovery",
      "codeHash": "dfdca0b356b7df45b07c46acbcc9c1785d6b825f4512ffb404d2da7a467fa17f",
      "spec": {
        "template": "sequence",
        "title": "Embedded Docker DNS service discovery resolution",
        "actors": [
          "ApiServer",
          "DockerDNS",
          "PostgresDB",
          "RedisCache"
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "Docker provides internal DNS service discovery on bridge network.",
            "messages": [
              {
                "from": "ApiServer",
                "to": "DockerDNS",
                "label": "resolve postgres:5432"
              }
            ],
            "activeActor": "ApiServer"
          },
          {
            "at": "say8",
            "caption": "Embedded DNS server intercepts queries and dynamically resolves address.",
            "messages": [
              {
                "from": "DockerDNS",
                "to": "ApiServer",
                "label": "returns 172.28.0.2"
              },
              {
                "from": "ApiServer",
                "to": "PostgresDB",
                "label": "connect TCP socket"
              }
            ],
            "activeActor": "PostgresDB"
          }
        ]
      },
