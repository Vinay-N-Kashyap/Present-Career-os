      "partTitle": "Named Volumes vs Bind Mounts for Data Persistence",
      "codeHash": "458d321cfc9efb154031953f288c246b108b2109a696f9e4f0682308e2d7a22d",
      "spec": {
        "template": "compare",
        "title": "Named volumes vs bind mounts storage persistence",
        "leftLabel": "Named Volumes (Databases)",
        "rightLabel": "Bind Mounts (Local Development)",
        "steps": [
          {
            "at": "say4",
            "caption": "Named volumes are managed exclusively by Docker daemon for persistence.",
            "left": {
              "code": "pgdata:/var/lib/postgresql/data",
              "result": {
                "text": "MANAGED_VOLUME"
              },
              "tone": "ok"
            },
            "right": {
              "code": "./src:/app/src",
              "result": {
                "text": "HOST_PATH"
              },
              "tone": "data"
            }
          },
          {
            "at": "say8",
            "caption": "Bind mounts reflect host code changes immediately without rebuilding.",
            "left": {
              "code": "Persistence: Survives restarts",
              "result": {
                "text": "PRODUCTION_SAFE"
              },
              "tone": "ok"
            },
            "right": {
              "code": "Hot-Reload: Instant sync",
              "result": {
                "text": "DEV_OPTIMIZED"
              },
              "tone": "ok"
            }
          }
        ]
      },
