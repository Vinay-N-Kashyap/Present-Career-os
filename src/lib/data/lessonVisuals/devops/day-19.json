      "spec": {
        "template": "compare",
        "title": "Secret base64 obfuscation versus KMS envelope encryption at rest",
        "leftLabel": "Base64 Obfuscation Only",
        "rightLabel": "KMS Envelope Encryption",
        "steps": [
          {
            "at": "say3",
            "caption": "Default secrets are simply base64 encoded strings stored in cluster database.",
            "left": {
              "code": "rawPassword",
              "result": {
                "text": "super-secret-db-password-99"
              },
              "tone": "error"
            },
            "right": {
              "code": "base64Encoded",
              "result": {
                "text": "super-secret-db-password-99"
              },
              "tone": "data"
            }
          },
          {
            "at": "say6",
            "caption": "Encryption at rest leverages key management services for envelope protection.",
            "left": {
              "code": "auditSecretSecurity(false)",
              "result": {
                "text": "SecretAuditor"
              },
              "tone": "error"
            },
            "right": {
              "code": "auditSecretSecurity(true)",
              "result": {
                "text": "SecretAuditor"
              },
              "tone": "ok"
            }
          }
