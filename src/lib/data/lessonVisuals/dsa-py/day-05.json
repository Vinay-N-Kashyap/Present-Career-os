    {
      "partTitle": "Two structures, two jobs",
      "codeHash": "754b195699058111c335a08bc9fce3b2a4c5447e7281e27497c2504bf3332513",
      "spec": {
        "template": "compare",
        "title": "Coordinating hash map and doubly linked list",
        "leftLabel": "Hash Map (Dict)",
        "rightLabel": "Doubly Linked List",
        "steps": [
          {
            "at": "say1",
            "caption": "Dict maps each key to its node for constant lookup.",
            "left": {
              "code": "map[\"b\"] -> node",
              "result": {
                "text": "O(1) lookup"
              },
              "tone": "ok"
            },
            "right": {
              "code": "head <-> a <-> b <-> tail",
              "result": {
                "text": "order"
              },
              "tone": "data"
            }
          },
          {
            "at": "say2",
            "caption": "Doubly linked list keeps order of use between dummy head and tail.",
            "left": {
              "code": "map[\"c\"] -> front",
              "result": {
                "text": "O(1) update"
              },
              "tone": "ok"
            },
            "right": {
              "code": "head <-> c <-> b <-> tail",
              "result": {
                "text": "newest to oldest"
              },
              "tone": "ok"
            }
          }
        ]
      },
