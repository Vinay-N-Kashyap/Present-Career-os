    {
      "partTitle": "What dynamic programming is",
      "codeHash": "fae41d57bd868dc40bef70d6860bc5417718468c2322b2b8216b4cd665b24ee4",
      "spec": {
        "template": "compare",
        "title": "Exponential recursive tree vs memoized linear work",
        "leftLabel": "Naive Recursion",
        "rightLabel": "Dynamic Programming",
        "steps": [
          {
            "at": "say1",
            "caption": "Dynamic programming solves smaller subproblems once and reuses answers.",
            "left": {
              "code": "fib(30)",
              "result": {
                "text": "1M calls"
              },
              "tone": "error"
            },
            "right": {
              "code": "memo fib(30)",
              "result": {
                "text": "30 cached steps"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "DP turns exponential work into linear work by storing each answer.",
            "left": {
              "code": "work complexity",
              "result": {
                "text": "O(2^N) exponential"
              },
              "tone": "error"
            },
            "right": {
              "code": "work complexity",
              "result": {
                "text": "O(N) linear"
              },
              "tone": "ok"
            }
          }
        ]
      },
