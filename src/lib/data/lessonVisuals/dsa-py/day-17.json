                  }
                ],
                "tone": "data"
              },
              {
                "cells": [
                  {
                    "text": "Range Query"
                  },
                  {
                    "text": "Selective BST Walk"
                  },
                  {
                    "text": "Skip left if node < low, skip right if node > high"
                  }
                ],
                "tone": "ok"
              }
            ]
          }
        ]
