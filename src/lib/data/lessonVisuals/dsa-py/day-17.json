      "partTitle": "The k-th smallest and range queries",
      "codeHash": "e4bc456d767e7faed5ee3c162a221e8c173484fb4cb06a6018022c307561274b",
      "spec": {
        "template": "table",
        "title": "BST queries: k-th smallest and range queries",
        "columns": [
          "Query Operation",
          "Traversal Method",
          "Early Pruning Strategy"
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "Inorder gives sorted order allowing early exit at the target element.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "k-th Smallest"
                  },
                  {
                    "text": "Inorder (LNR)"
                  },
                  {
                    "text": "Stop traversal as soon as k elements visited"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say2",
            "caption": "A range query skips subtrees when the current node is outside bounds.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "k-th Smallest"
                  },
                  {
                    "text": "Inorder (LNR)"
                  },
                  {
