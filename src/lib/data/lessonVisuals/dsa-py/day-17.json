    {
      "partTitle": "Searching and the cost of balance",
      "codeHash": "a66dc1242cc5d472ac7955967945cac94d12240c553632feb3b96d47115c3d7b",
      "spec": {
        "template": "compare",
        "title": "Tree balance versus degenerate linked list chain",
        "leftLabel": "Balanced BST",
        "rightLabel": "Degenerate Chain",
        "steps": [
          {
            "at": "say1",
            "caption": "Insert searches until falling off the tree then places new node.",
            "left": {
              "code": "insert(val)",
              "result": {
                "text": "height: log N"
              },
              "tone": "ok"
            },
            "right": {
              "code": "insert(sorted)",
              "result": {
                "text": "height: N"
              },
              "tone": "error"
            }
          },
          {
            "at": "say2",
            "caption": "Insert in sorted order degrades search height to linear time.",
            "left": {
              "code": "search balanced",
              "result": {
                "text": "O(log N)"
              },
              "tone": "ok"
            },
            "right": {
              "code": "search chained",
              "result": {
                "text": "O(N)"
              },
              "tone": "error"
            }
          }
        ]
      },
