        "leftLabel": "List pop(0)",
        "rightLabel": "Deque popleft()",
        "steps": [
          {
            "at": "say1",
            "caption": "Removing front item from list moves every other item left.",
            "left": {
              "code": "list.pop(0)",
              "result": {
                "text": "O(N) shifts"
              },
              "tone": "error"
            },
            "right": {
              "code": "deque.popleft()",
              "result": {
                "text": "O(1) pointer"
              },
              "tone": "ok"
            }
          },
