    {
      "partTitle": "Why negative weights break Dijkstra",
      "codeHash": "ddf3332aa148eebe739454c98801e3567d9a374acffe23c0c14180a41226016a",
      "spec": {
        "template": "compare",
        "title": "Dijkstra failure on negative edge weights vs Bellman-Ford",
        "leftLabel": "Dijkstra Algorithm",
        "rightLabel": "Bellman-Ford Algorithm",
        "steps": [
          {
            "at": "say1",
            "caption": "Negative edges violate greedy settlement and produce incorrect answers.",
            "left": {
              "code": "greedy settle",
              "result": {
                "text": "fails on negative"
              },
              "tone": "error"
            },
            "right": {
              "code": "multiple passes",
              "result": {
                "text": "correct"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Use Bellman-Ford for negative edge graphs relaxing edges repeatedly.",
            "left": {
              "code": "Dijkstra",
              "result": {
                "text": "O((V+E) log V)"
              },
              "tone": "data"
            },
            "right": {
              "code": "Bellman-Ford",
              "result": {
                "text": "O(V * E)"
              },
              "tone": "ok"
            }
          }
        ]
      },
