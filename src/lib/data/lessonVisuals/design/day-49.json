      "steps": [
        {
          "stepNumber": 1,
          "label": "Viewport Bounds Projecting",
          "caption": "Visible cell rectangle coordinates project onto hardware canvas context."
        },
        {
          "stepNumber": 2,
          "label": "Canvas Context Blitting",
          "caption": "High-density numeric text and background colors draw in single blit pass."
        },
        {
          "stepNumber": 3,
          "label": "Coordinate Hit Testing",
          "caption": "Pointer coordinates calculate target row and column in constant time."
        },
        {
          "stepNumber": 4,
          "label": "Transparent DOM Overlaying",
          "caption": "Invisible semantic table elements overlay canvas for screen reader access."
        }
      ]
    }
  ],
