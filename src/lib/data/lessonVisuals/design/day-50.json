      "steps": [
        {
          "stepNumber": 1,
          "label": "Execution Fill Ingesting",
          "caption": "Incoming order execution reports buffer rapidly into ingestion queue."
        },
        {
          "stepNumber": 2,
          "label": "Order State Map Coalescing",
          "caption": "Multiple partial execution fills for matching order ids coalesce in place."
        },
        {
          "stepNumber": 3,
          "label": "Batch Flush Dispatching",
          "caption": "Animation frame pulse dispatches coalesced order book to presentation."
        },
        {
          "stepNumber": 4,
          "label": "Adaptive Clamp Regulating",
          "caption": "Adaptive throttle clamp protects frame rates during intense market volume."
        }
      ]
