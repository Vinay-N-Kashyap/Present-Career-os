      "steps": [
        {
          "step": 1,
          "title": "Source Code String Stream",
          "caption": "Primitive regex searches cannot distinguish between comments and code."
        },
        {
          "step": 2,
          "title": "Lexical Tokenizing Pass",
          "caption": "Compiler tokenizers decompose source text into structured language tokens."
        },
        {
          "step": 3,
          "title": "AST Import Resolution",
          "caption": "Import declarations map local component aliases back to official package origins."
        },
        {
          "step": 4,
          "title": "Canonical Component Mapping",
          "caption": "AST visitors catalogue exact component invocations without false positives."
        }
      ]
    },
