      "steps": [
        {
          "step": 1,
          "title": "Multiple Duplicate Packages",
          "caption": "Bundling multiple copies of React causes hook dispatcher crashes."
        },
        {
          "step": 2,
          "title": "Singleton Contract Validation",
          "caption": "Federation configurations declare singleton requirements for critical libraries."
        },
        {
          "step": 3,
          "title": "Shared Memory Dispatcher",
          "caption": "The host container shares its active runtime instance with all remotes."
        },
        {
          "step": 4,
          "title": "Lean Single-Instance Runtime",
          "caption": "Single-instance execution eliminates memory bloat and prevents hook exceptions."
        }
      ]
    },
