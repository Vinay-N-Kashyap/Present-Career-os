        },
        {
          "stepNumber": 3,
          "label": "Clipboard Write Dispatching",
          "caption": "System clipboard receives serialized text for spreadsheet interoperability."
        },
        {
          "stepNumber": 4,
          "label": "Paste Ingestion Validating",
          "caption": "Paste event parses incoming text and writes values into target range."
        }
      ]
    }
