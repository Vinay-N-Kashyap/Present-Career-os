      "codeHash": "1c65f9a94b054ddb64807711831a8added477d9832defadffd73f9d83da86378",
      "steps": [
        {
          "stepNumber": 1,
          "label": "Arrow Key Intercepting",
          "caption": "Keyboard arrow events intercept default page scroll and navigate cells."
        },
        {
          "stepNumber": 2,
          "label": "Matrix Coordinate Clamping",
          "caption": "Target row and column indices clamp within valid matrix boundaries."
        },
        {
          "stepNumber": 3,
          "label": "Shift Modifier Expanding",
          "caption": "Shift key with directional arrows expands the rectangular selection box."
        },
        {
          "stepNumber": 4,
          "label": "Scroll Into View Aligning",
          "caption": "Target cell smoothly scrolls into viewport if currently positioned offscreen."
        }
      ]
    },
    {
      "visualId": "design-d48-p3",
      "partNumber": 3,
      "title": "Inline Cell Editing: Double-Click Triggers, Keydown Interception & Value Commit Lifecycles",
