      "codeHash": "8370afc6dc5c3a0c8faaca4542024193eaa13af6113b24914ef50f9101222392",
      "steps": [
        {
          "stepNumber": 1,
          "label": "Anchor Coordinate Setting",
          "caption": "Mouse press establishes the primary origin anchor cell coordinate."
        },
        {
          "stepNumber": 2,
          "label": "Active Focus Navigating",
          "caption": "Pointer drag extends current focus coordinate across row and column spans."
        },
        {
          "stepNumber": 3,
          "label": "Bounding Box Normalizing",
          "caption": "Calculated bounding box normalizes regardless of drag direction."
        },
        {
          "stepNumber": 4,
          "label": "Selection Overlay Styling",
          "caption": "Semi-transparent brand tint highlights the active selection bounding box."
        }
      ]
    },
    {
      "visualId": "design-d48-p2",
      "partNumber": 2,
      "title": "Keyboard Matrix Navigation: Arrow Keys, Tab Loops & Formula Bar Synchronization",
