      "steps": [
        {
          "step": 1,
          "title": "Disjoint CSS Properties",
          "caption": "Composite tokens bundle related typography or shadow properties together."
        },
        {
          "step": 2,
          "title": "Composite Typography Token",
          "caption": "Typography bundles font family, font size, line height, and font weight."
        },
        {
          "step": 3,
          "title": "Sub-Value Map Extraction",
          "caption": "Compilers extract individual sub-values for targeted platform emitters."
        },
        {
          "step": 4,
          "title": "Atomic Property Expansion",
          "caption": "Atomic expansion enables platforms to consume composite properties cleanly."
        }
      ]
    },
    {
      "partIndex": 4,
      "template": "compare",
      "prompt": "Architectural and conceptual diagram for Day 51 Part 4: Token Reference Resolution: Alias Graph Traversal & Cycle Detection Algorithms. Visualizing step progression with compare template.",
      "promptSha": "7dee1e4cf7f86b04550bdb32776843e84dc9991352775f08b7966102f04fef34",
      "codeHash": "69d3202ec694e5bf1f0a3b256f1f70ba71d47a3c099b650bbc1c1218dc78803d",
      "steps": [
        {
          "step": 1,
          "title": "Hardcoded Literal Values",
          "caption": "Design systems link semantic tokens to primitives through alias references."
        },
        {
          "step": 2,
          "title": "Alias Reference Pointer",
          "caption": "Curly brace pointers denote references to global foundation values."
        },
        {
          "step": 3,
          "title": "Dependency Graph Walking",
          "caption": "Reference resolvers construct directed acyclic graphs to detect cycles."
        },
        {
          "step": 4,
          "title": "Resolved Concrete Token",
          "caption": "Deep references resolve into concrete leaf values for runtime stylesheet injection."
        }
      ]
    }
