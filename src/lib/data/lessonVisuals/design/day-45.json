      "steps": [
        {
          "stepNumber": 1,
          "label": "Scaled Integer Arithmetic",
          "caption": "The financial calculation engine uses scaled integer cents to eliminate drift."
        },
        {
          "stepNumber": 2,
          "label": "Buying Power Verifying",
          "caption": "Buying power algorithms verify settled cash and margin leverage against order value."
        },
        {
          "stepNumber": 3,
          "label": "Collar Band Auditing",
          "caption": "Price collar checks prevent execution of orders outside five percent market bands."
        },
        {
          "stepNumber": 4,
          "label": "Circuit Breaker Tripping",
          "caption": "Violations immediately trip circuit breakers and lock primary submission triggers."
        }
      ]
    },
