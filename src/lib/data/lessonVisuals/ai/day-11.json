      "spec": {
        "template": "compare",
        "title": "Bi-encoder independent vector embeddings versus cross-encoder joint attention",
        "left": {
          "title": "Bi-Encoder Architecture",
          "items": [
            "Independent vector forward passes",
            "Calculates pre computed embeddings",
            "Fast HNSW vector index search",
            "Lacks cross token attention interplay"
          ]
        },
        "right": {
          "title": "Cross-Encoder Architecture",
          "items": [
            "Concatenates query and document",
            "Joint transformer self-attention",
            "All-to-all token attention interplay",
            "Outputs calibrated relevance probability"
          ]
        },
