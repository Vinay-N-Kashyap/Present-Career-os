        "template": "compare",
        "title": "Zero-shot instruction prompting versus few-shot exemplar demonstrations",
        "left": {
          "title": "Zero-Shot Prompting",
          "items": [
            "Relies strictly on task instructions",
            "Fast and consumes minimal token budget",
            "Prone to format hallucinations on rigid schemas",
            "Struggles with subtle classification edge cases"
          ]
        },
        "right": {
          "title": "Few-Shot Exemplars",
          "items": [
            "Provides two to five input-output demonstrations",
            "Anchors exact output formatting and tone",
            "Boosts accuracy on complex classification tasks",
            "Consumes additional input tokens per API call"
          ]
