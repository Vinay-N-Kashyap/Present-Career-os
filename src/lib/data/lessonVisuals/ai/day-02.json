      "partTitle": "Tokenization Edge Cases: Numbers, Code Indentation, and Multilingual Bytes",
      "codeHash": "aea185e474e8251b740ae782502f35ec49dfc35ba948f74e8ecd5e85157fc217",
      "spec": {
        "template": "compare",
        "title": "English token efficiency versus non-English multilingual byte overhead",
        "left": {
          "title": "English Token Efficiency",
          "items": [
            "Single token represents whole common words",
            "Compact sequence lengths on GPU tensor cores",
            "Lower financial cost per thousand words",
            "High context efficiency"
          ]
        },
        "right": {
          "title": "Multilingual Byte Overhead",
          "items": [
            "Non-Latin scripts split into multiple byte tokens",
            "Single word requires four to eight tokens",
            "Higher context consumption and inference cost",
            "Fragmented sub-word token identifiers"
          ]
        },
        "steps": [
          {
            "at": "say6",
            "caption": "Tokenization compression is significantly worse in non-English languages.",
            "highlightSide": "right",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "The token tax causes multilingual prompts to consume additional context.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
