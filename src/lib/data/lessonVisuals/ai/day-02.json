      "partTitle": "The Tokenization Abstraction: Why LLMs Ingest Tokens Not Characters",
      "codeHash": "3252ff87763258e1604d605c91db9078e323aa0b5ff0a1f4795398231cadbbd7",
      "spec": {
        "template": "compare",
        "title": "Character-level sequence overhead versus sub-word vocabulary balance",
        "left": {
          "title": "Character Level Processing",
          "items": [
            "Sequence lengths grow four to five times longer",
            "Quadratic attention compute becomes prohibitive",
            "Lacks semantic grouping across character clusters",
            "GPU memory saturates on small document inputs"
          ]
        },
        "right": {
          "title": "Sub-Word BPE Tokenization",
          "items": [
            "Decomposes rare words into frequent sub-words",
            "Preserves compact sequence length on GPU",
            "Eliminates out-of-vocabulary exceptions",
            "Balances vocabulary size against sequence length"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Character level modeling causes sequence lengths to explode compute costs.",
            "highlightSide": "left",
