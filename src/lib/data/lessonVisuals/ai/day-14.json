      "spec": {
        "template": "compare",
        "title": "Direct user prompt injection attacks versus indirect document injection",
        "left": {
          "title": "Direct Injection Attack",
          "items": [
            "Attacker submits malicious user chat",
            "Attempts to override system instructions",
            "Requests internal system prompt leakage",
            "Blocked easily by input regex firewall"
          ]
        },
        "right": {
          "title": "Indirect Injection Attack",
          "items": [
            "Malicious payload hidden in public doc",
            "Ingested via vector RAG retrieval",
            "Model executes third party instructions",
            "Exploits lack of data instruction separation"
          ]
        },
        "steps": [
