    {
      "partTitle": "The Unstructured Data Challenge: Why Raw LLM Text Fails in Enterprise APIs",
      "codeHash": "143586753fb8ba62e63ffd59e4eb9b3c2193128e258fd58f45afefcf51ec32a4",
      "spec": {
        "template": "compare",
        "title": "Unstructured natural language completions versus deterministic schema contracts",
        "left": {
          "title": "Raw LLM Text Generation",
          "items": [
            "Prefixes responses with conversational filler text",
            "Wraps JSON in markdown code fence delimiters",
            "Leaves trailing commas that break standard parsers",
            "Causes unhandled runtime exceptions in backends"
          ]
        },
        "right": {
          "title": "Structured Schema Contracts",
          "items": [
            "Enforces deterministic JSON schemas and types",
            "Guarantees valid JSON without markdown wrapping",
            "Validates fields and data types before ingestion",
            "Eliminates unhandled parsing exceptions completely"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Conversational pleasantries break automated downstream JSON parsing.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say8",
            "caption": "Structured validation layers enforce strict schema adherence for data.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
