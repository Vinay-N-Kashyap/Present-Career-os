    {
      "partTitle": "Sliding Window Log vs Token Bucket Rate Limiting",
      "codeHash": "69e51ca9100d447bc66081614c3182a7bdf267550679778031a5752743931128",
      "spec": {
        "template": "compare",
        "title": "Rate limiting algorithm trade-off comparison",
        "leftLabel": "Token Bucket Algorithm",
        "rightLabel": "Sliding Window Log",
        "leftItems": [
          "Memory footprint is minimal storing only count and timestamp",
          "Smoothly absorbs sudden bursts up to maximum capacity",
          "Computationally lightweight with basic arithmetic refill",
          "Cannot audit exact granular history of prior timestamps"
        ],
        "rightItems": [
          "Memory scales linearly storing individual request timestamps",
          "Prevents boundary reset spikes across sliding intervals",
          "Filters and purges expired historical records on each check",
          "Guarantees exact mathematical precision across sliding window"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Token bucket requires negligible memory storing minimal tenant state.",
            "highlightSide": "left"
          },
          {
            "at": "say6",
            "caption": "Sliding window algorithm purges older log entries and sums active tokens.",
            "highlightSide": "right"
          }
        ]
      },
