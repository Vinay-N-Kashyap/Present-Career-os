    {
      "partTitle": "Explicit Operational Boundaries & Negative Constraints",
      "codeHash": "757faabf945001f292ff0d7b86ef3abc2b775bc23e33081dee7c5843a67041cb",
      "spec": {
        "template": "compare",
        "title": "Pure negative prohibitions versus negative with alternative framing",
        "left": {
          "title": "Pure Negative Prohibition",
          "items": [
            "Phrased as bare DO NOT or NEVER rules",
            "Attention mechanisms attend heavily to forbidden words",
            "Prone to compliance failures under user pressure",
            "Leaves the model without an alternative output path"
          ]
        },
        "right": {
          "title": "Negative with Alternative",
          "items": [
            "Combines explicit refusal with alternative actions",
            "Directs attention toward sanctioned replacement phrases",
            "Drastically improves compliance across adversarial tests",
            "Provides standard scripted fallback responses"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Language models struggle when provided with purely negative instructions.",
            "highlightSide": "left",
            "statusBadge": "failed"
          },
          {
            "at": "say5",
            "caption": "Alternative framing specifies exact fallback actions for forbidden tasks.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Pure Negative Prohibition",
        "rightLabel": "Negative with Alternative"
      },
