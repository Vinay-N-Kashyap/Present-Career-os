      "spec": {
        "template": "compare",
        "title": "High semantic relevance alignment versus orthogonal query key matching",
        "left": {
          "title": "Semantic Alignment Match",
          "items": [
            "Query and key point in identical direction",
            "High positive dot product magnitude",
            "Receives dominant softmax attention probability",
            "Context vector inherits primary value content"
          ]
        },
        "right": {
          "title": "Orthogonal Unrelated Match",
          "items": [
            "Query and key are mathematically orthogonal",
            "Dot product evaluates near zero or negative",
            "Softmax normalizes weight close to zero",
            "Minimal value vector contribution"
          ]
        },
        "steps": [
