      "partTitle": "The Transformer Revolution & Decoder-Only Architecture",
      "codeHash": "e4e571e8777f1c6afa2d2502b9820461959e929d2f70ce18774e0b3ff0ae1b57",
      "spec": {
        "template": "compare",
        "title": "Sequential recurrent network bottlenecks versus parallel transformer attention",
        "left": {
          "title": "Recurrent Sequential Models",
          "items": [
            "Processes tokens strictly left to right",
            "Sequential processing creates GPU bottlenecks",
            "Suffers from vanishing gradients over time",
            "Context memory degrades on long documents"
          ]
        },
        "right": {
          "title": "Transformer Decoder Stack",
          "items": [
            "Attends to all tokens simultaneously in parallel",
            "Multi-head self-attention mechanisms",
            "Residual skip connections and RMSNorm layers",
            "Scales efficiently across thousands of GPU cores"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Sequential recurrent models process text sequentially from left to right.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say4",
            "caption": "The transformer eliminates recurrence with parallel attention mechanisms.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
