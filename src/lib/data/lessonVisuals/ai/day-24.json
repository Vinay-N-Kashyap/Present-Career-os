          "title": "Verbosity Exploit Vulnerability",
          "items": [
            "Reward hack by padding fluff",
            "Longer answers favored unfairly",
            "Bloated inference token costs",
            "Sluggish user response times"
          ]
        },
        "right": {
          "title": "Length-Normalized DPO",
          "items": [
            "Divides log probs by length",
            "Penalizes redundant padding",
            "Rewards informational density",
            "Lean and concise completions"
