      "spec": {
        "template": "compare",
        "title": "Oversized document embeddings versus fragile sentence micro-chunks",
        "left": {
          "title": "Oversized Document Chunks",
          "items": [
            "Entire chapters in single vector",
            "Averages disparate topics together",
            "Dilutes semantic similarity score",
            "Exceeds prompt context capacity"
          ]
        },
        "right": {
          "title": "Micro Chunks Fragility",
          "items": [
            "Tiny sentence fragment tokens",
            "Lacks surrounding semantic context",
            "Breaks conditional business logic",
            "Missing critical noun references"
          ]
        },
        "steps": [
