    {
      "partTitle": "Resilient Client-Side SSE Chunk Parsing & Line Buffering",
      "codeHash": "abaef6c9a5e7c1c23a713390f2e5d27d0c20944ea67fe0c3ff1a7f7274eca803",
      "spec": {
        "template": "compare",
        "title": "Naive packet parsing versus resilient line-buffered SSE chunk ingestion",
        "left": {
          "title": "Naive Packet Parsing",
          "items": [
            "Parses raw incoming packets",
            "Assumes clean frame boundaries",
            "Crashes on split TCP packets",
            "Throws JSON syntax exceptions"
          ]
        },
        "right": {
          "title": "Resilient Line Buffer",
          "items": [
            "Accumulates raw fragment bytes",
            "Splits on double newlines",
            "Retains incomplete fragments",
            "Guarantees 100% parse safety"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Naive parsing on raw incoming network packets causes JSON syntax crashes.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Complete frames are extracted while incomplete fragments stay in the buffer.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
