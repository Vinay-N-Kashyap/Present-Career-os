    {
      "partTitle": "Continuous Batching (Iteration-Level Scheduling)",
      "codeHash": "d706885456fcd1049deeff4038766d16339dd418bc7e497b117f293fdfbcdab9",
      "spec": {
        "template": "compare",
        "title": "Static batching compute starvation versus continuous iteration scheduling",
        "left": {
          "title": "Static Batching Starvation",
          "items": [
            "Waits for slowest request",
            "Short queries stay trapped",
            "High idle compute waste",
            "Poor hardware utilization"
          ]
        },
        "right": {
          "title": "Continuous Dynamic Batching",
          "items": [
            "Iteration-level scheduling",
            "Evicts completed sequences",
            "Slots new requests instantly",
            "Near 100% GPU utilization"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Short queries remain trapped for seconds leaving GPU compute idle.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "In that exact iteration newly arrived requests slot into the active batch.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
