      "partTitle": "Metadata Filtering: Pre-Filtering, Post-Filtering & Single-Stage Search",
      "codeHash": "275ba63fa8f84468e8cf7fe212df0de77d77929edabd512298ddcf6952a9a785",
      "spec": {
        "template": "compare",
        "title": "Relational metadata post-filtering versus single-stage graph traversal filtering",
        "left": {
          "title": "Naive Post-Filtering",
          "items": [
            "Performs vector search first",
            "Discards failing metadata rows",
            "Can return zero valid results",
            "Fails on selective tenant filters"
          ]
        },
        "right": {
          "title": "Single-Stage Search",
          "items": [
            "Inspects metadata during graph traversal",
            "Bypasses invalid candidate nodes",
            "Maintains high search recall",
            "Guarantees tenant security isolation"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Post-filtering performs vector search first and discards failing results.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say9",
            "caption": "Single-stage filtering checks candidate nodes during graph traversal.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
