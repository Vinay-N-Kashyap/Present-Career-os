        "template": "compare",
        "title": "Exact lexical string hashing versus semantic vector cosine similarity",
        "left": {
          "title": "Exact Key Hashing",
          "items": [
            "Fails on paraphrased phrasing",
            "Zero semantic understanding",
            "100% cache miss on synonyms",
            "Rigid character-level lookup"
          ]
        },
        "right": {
          "title": "Dense Semantic Vector Cache",
          "items": [
            "Converts query to embeddings",
            "Matches conceptual user intent",
            "Cosine similarity threshold",
            "High hit rate on variations"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "An exact key cache yields total misses when users express identical intent.",
            "highlightSide": "left",
            "statusBadge": "active"
