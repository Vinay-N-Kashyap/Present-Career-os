    {
      "partTitle": "Implementing the breaker",
      "codeHash": "e21bd35d1126468c720963ce97e511c0a68007a79cf7116163f44a59ef16b905",
      "spec": {
        "template": "compare",
        "title": "Circuit breaker execution paths normal closed calls versus open trips",
        "leftLabel": "Healthy Service (CLOSED)",
        "rightLabel": "Failing Service (OPEN)",
        "steps": [
          {
            "at": "say1",
            "caption": "If breaker is OPEN calls raise CircuitOpenError immediately.",
            "left": {
              "code": "fn() executes normally",
              "result": {
                "text": "ok"
              },
              "tone": "ok"
            },
            "right": {
              "code": "raise CircuitOpenError",
              "result": {
                "text": "circuit open"
              },
              "tone": "error"
            }
          },
          {
            "at": "say3",
            "caption": "Move to OPEN once failures reach threshold or trial fails.",
            "left": {
              "code": "failures count reset",
              "result": {
                "text": "CLOSED"
              },
              "tone": "ok"
            },
            "right": {
              "code": "trips open at threshold",
              "result": {
                "text": "OPEN"
              },
              "tone": "error"
            }
          },
          {
            "at": "say5",
            "caption": "On success reset failures to zero and return result.",
            "left": {
              "code": "trial call succeeds",
              "result": {
                "text": "ok"
              },
              "tone": "ok"
            },
            "right": {
              "code": "dependency still down",
              "result": {
                "text": "payments down"
              },
              "tone": "idle"
            }
          }
        ]
      },
