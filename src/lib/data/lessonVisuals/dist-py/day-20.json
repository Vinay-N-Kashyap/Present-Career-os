      "spec": {
        "template": "states",
        "title": "Circuit breaker transitions between closed open and half-open states",
        "states": [
          {
            "id": "CLOSED",
            "label": "CLOSED"
          },
          {
            "id": "OPEN",
            "label": "OPEN"
          },
          {
            "id": "HALF_OPEN",
            "label": "HALF_OPEN"
          }
        ],
        "steps": [
          {
            "at": "say1",
            "caption": "A circuit breaker wraps dependency calls and has three states.",
            "currentState": "CLOSED",
            "tone": "ok"
          },
          {
            "at": "say2",
            "caption": "After too many failures calls are rejected immediately.",
            "currentState": "OPEN",
            "transition": {
              "from": "CLOSED",
              "to": "OPEN"
            },
            "tone": "error"
          },
          {
            "at": "say4",
            "caption": "After reset timeout one trial call is allowed in HALF_OPEN.",
            "currentState": "HALF_OPEN",
            "transition": {
              "from": "OPEN",
              "to": "HALF_OPEN"
            },
            "tone": "idle"
          }
        ]
      },
