      "spec": {
        "template": "compare",
        "title": "Snowflake generator clock monotonicity and backward jump error handling",
        "leftLabel": "Monotonic Progression",
        "rightLabel": "Clock Backward Anomaly",
        "steps": [
          {
            "at": "say1",
            "caption": "Function next_id increments sequence when millisecond equals last.",
            "left": {
              "code": "ms == last_ms: sequence + 1",
              "result": {
                "text": "1"
              },
              "tone": "ok"
            },
            "right": {
              "code": "ms != last_ms: sequence = 0",
              "result": {
                "text": "3"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Backward clock raises CLOCK_MOVED_BACKWARDS avoiding duplicates.",
            "left": {
              "code": "advancing millisecond timestamp",
              "result": {
                "text": "1"
              },
              "tone": "ok"
            },
            "right": {
              "code": "ms < last_ms clock backward",
              "result": {
                "text": "CLOCK_MOVED_BACKWARDS"
              },
              "tone": "error"
            }
          },
          {
            "at": "say7",
            "caption": "ID generation happens locally without network calls.",
            "left": {
              "code": "local sequence calculation",
              "result": {
                "text": "1"
              },
              "tone": "ok"
            },
            "right": {
              "code": "clock exception aborts id",
              "result": {
                "text": "CLOCK_MOVED_BACKWARDS"
              },
              "tone": "error"
            }
          }
        ]
