      "spec": {
        "template": "compare",
        "title": "API gateway dispatch pipeline handling success rate limits and circuit trips",
        "leftLabel": "Allowed 200 OK Response",
        "rightLabel": "Error 429 / 503 Response",
        "steps": [
          {
            "at": "say1",
            "caption": "If is_allowed returns False the gateway returns status 429.",
            "left": {
              "code": "rate limit check passes",
              "result": {
                "text": "orders"
              },
              "tone": "ok"
            },
            "right": {
              "code": "client exceeds limit",
              "result": {
                "text": "429"
              },
              "tone": "error"
            }
          },
          {
            "at": "say2",
            "caption": "On open circuit breaker gateway returns 503 otherwise 200.",
            "left": {
              "code": "successful backend call",
              "result": {
                "text": "order-7"
              },
              "tone": "ok"
            },
            "right": {
              "code": "circuit breaker open",
              "result": {
                "text": "503"
              },
              "tone": "error"
            }
          },
          {
            "at": "say5",
            "caption": "Status 503 indicates temporary issue while 500 signals server error.",
            "left": {
              "code": "clean response",
              "result": {
                "text": "orders"
              },
              "tone": "ok"
            },
            "right": {
              "code": "unexpected backend failure",
              "result": {
                "text": "bad row in orders table"
              },
              "tone": "idle"
            }
          }
        ]
      },
