      "spec": {
        "template": "compare",
        "title": "Thundering herd stampede defense using cached fetch consolidation",
        "leftLabel": "Uncached Stampede",
        "rightLabel": "Consolidated Burst",
        "steps": [
          {
            "at": "say1",
            "caption": "Popular key expiry triggers simultaneous queries to database.",
