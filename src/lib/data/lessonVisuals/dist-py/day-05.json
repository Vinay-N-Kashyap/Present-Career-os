              },
              "tone": "error"
            },
            "right": {
              "code": "first request populates cache",
              "result": {
                "text": "hot"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say3",
            "caption": "Function get_many calls fetch at most once per distinct key.",
