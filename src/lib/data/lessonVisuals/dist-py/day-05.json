              "code": "redundant database calls",
              "result": {
                "text": "cold"
              },
              "tone": "error"
            },
            "right": {
              "code": "single fetch per distinct key",
              "result": {
                "text": "cold"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say6",
            "caption": "Ten requests cause only two database calls across keys.",
