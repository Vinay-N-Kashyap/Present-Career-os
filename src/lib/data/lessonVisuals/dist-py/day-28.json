    {
      "partTitle": "Cache-Control headers",
      "codeHash": "436ddf37ee9ee0eb6622309ae59bf491ba013e6aeb91a6217f6fd3d1b47feef7",
      "spec": {
        "template": "table",
        "title": "HTTP Cache-Control response header directives and timing values",
        "columns": [
          "name",
          "value"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "The max-age directive defines fresh lifetime in seconds for shared caches.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "public"
                  },
                  {
                    "text": "True"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say4",
            "caption": "The no-store directive forbids caching entirely for sensitive customer data.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "public"
                  },
                  {
                    "text": "True"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "max-age"
                  },
                  {
                    "text": "60"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say5",
            "caption": "The stale-while-revalidate directive serves cached copies while refreshing.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "public"
                  },
                  {
                    "text": "True"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "max-age"
                  },
                  {
                    "text": "60"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "stale-while-revalidate"
                  },
                  {
                    "text": "30"
                  }
                ],
                "tone": "idle"
              }
            ]
          }
        ]
      },
