    {
      "partTitle": "Fresh, stale or expired?",
      "codeHash": "7af8ff67cd3d62b36a8fdb44e77193beb94c894a46cd94c89bea2db05f05ea9c",
      "spec": {
        "template": "table",
        "title": "Edge cache evaluation status and revalidation decisions by age",
        "columns": [
          "status",
          "revalidate"
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "If age is within max-age the copy is fresh and served without revalidation.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "FRESH"
                  },
                  {
                    "text": "False"
                  }
                ],
                "tone": "ok"
              }
            ]
          },
          {
            "at": "say3",
            "caption": "Stale content is served immediately while triggering background refresh.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "FRESH"
                  },
                  {
                    "text": "False"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "STALE_REVALIDATING"
                  },
                  {
                    "text": "True"
                  }
                ],
                "tone": "idle"
              }
            ]
          },
          {
            "at": "say5",
            "caption": "Otherwise expired assets must fetch fresh responses from origin.",
            "rows": [
              {
                "cells": [
                  {
                    "text": "FRESH"
                  },
                  {
                    "text": "False"
                  }
                ],
                "tone": "ok"
              },
              {
                "cells": [
                  {
                    "text": "STALE_REVALIDATING"
                  },
                  {
                    "text": "True"
                  }
                ],
                "tone": "idle"
              },
              {
                "cells": [
                  {
                    "text": "EXPIRED"
                  },
                  {
                    "text": "False"
                  }
                ],
                "tone": "error"
              }
            ]
          }
        ]
      },
