    {
      "partTitle": "Why duplicates hurt",
      "codeHash": "ba8762782a1f358777778a84d1b888e456ea7c8e90ec7c0dfbf1d124df7cd8b0",
      "spec": {
        "template": "compare",
        "title": "Idempotent email update versus non-idempotent credit comparison",
        "leftLabel": "Naturally Idempotent",
        "rightLabel": "Non-Idempotent Credit",
        "steps": [
          {
            "at": "say1",
            "caption": "Setting a user email to the same value twice changes nothing.",
            "left": {
              "code": "set_email(profile, email)",
              "result": {
                "text": "asha@example.com"
              },
              "tone": "ok"
            },
            "right": {
              "code": "credit(amount)",
              "result": {
                "text": "asha"
              },
              "tone": "error"
            }
          },
          {
            "at": "say2",
            "caption": "Adding money twice results in incorrect doubled balance.",
            "left": {
              "code": "repeat set_email twice",
              "result": {
                "text": "asha@example.com"
              },
              "tone": "ok"
            },
            "right": {
              "code": "repeat credit twice",
              "result": {
                "text": "1000"
              },
              "tone": "error"
            }
          },
          {
            "at": "say4",
            "caption": "Operations should be naturally idempotent or skip repeats.",
            "left": {
              "code": "profile email intact",
              "result": {
                "text": "asha@example.com"
              },
              "tone": "ok"
            },
            "right": {
              "code": "duplicate balance corrupt",
              "result": {
                "text": "500"
              },
              "tone": "error"
            }
          }
        ]
      },
