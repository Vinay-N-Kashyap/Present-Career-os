    {
      "partTitle": "Designing naturally idempotent operations",
      "codeHash": "2765542ab6cc49e15c496bfd98084ec2bc4afbf255a5a9b5a737ce77d51c277b",
      "spec": {
        "template": "compare",
        "title": "Naturally idempotent upsert versus duplicate plain insert comparison",
        "leftLabel": "Idempotent Upsert",
        "rightLabel": "Non-Idempotent Plain Insert",
        "steps": [
          {
            "at": "say1",
            "caption": "Prefer operations that are safe by design.",
            "left": {
              "code": "upsert_order(order_id, status)",
              "result": {
                "text": "PLACED"
              },
              "tone": "ok"
            },
            "right": {
              "code": "insert_order(rows, order_id, status)",
              "result": {
                "text": "PLACED"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say2",
            "caption": "Upserts overwrite by unique key so repeated create adds no row.",
            "left": {
              "code": "second run updates key",
              "result": {
                "text": "order-7"
              },
              "tone": "ok"
            },
            "right": {
              "code": "second run inserts duplicate",
              "result": {
                "text": "order-7"
              },
              "tone": "error"
            }
          },
          {
            "at": "say5",
            "caption": "Unique constraint in database ensures only one insert succeeds.",
            "left": {
              "code": "single row remains",
              "result": {
                "text": "PLACED"
              },
              "tone": "ok"
            },
            "right": {
              "code": "duplicate rows created",
              "result": {
                "text": "PLACED"
              },
              "tone": "error"
            }
          }
        ]
      },
