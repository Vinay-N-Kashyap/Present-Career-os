    {
      "partTitle": "Fencing tokens",
      "codeHash": "59dd1f879c1d5e9677c8be085690acad6f335327da21a6507b386b56aee042f0",
      "spec": {
        "template": "compare",
        "title": "Fencing token monotonic counter validation on shared storage",
        "leftLabel": "Fresh Token Write",
        "rightLabel": "Stale Token Write",
        "steps": [
          {
            "at": "say2",
            "caption": "Fencing token counter increases every time lock is granted.",
            "left": {
              "code": "locks.acquire(\"invoice-9\", now=1500)",
              "result": {
                "text": "True"
              },
              "tone": "ok"
            },
            "right": {
              "code": "delayed worker-1 holds expired lease",
              "result": {
                "text": "False"
              },
              "tone": "error"
            }
          },
          {
            "at": "say3",
            "caption": "Storage tracks highest token rejecting writes with lower tokens.",
            "left": {
              "code": "db.write(token=2, \"from worker-2\")",
              "result": {
                "text": "from worker-2"
              },
              "tone": "ok"
            },
            "right": {
              "code": "db.write(token=1, \"from worker-1\")",
              "result": {
                "text": "REJECTED"
              },
              "tone": "error"
            }
          },
          {
            "at": "say5",
            "caption": "Checking lock on release stops worker releasing expired lock.",
            "left": {
              "code": "locks.release(\"invoice-9\", w2_id)",
              "result": {
                "text": "True"
              },
              "tone": "ok"
            },
            "right": {
              "code": "locks.release(\"invoice-9\", w1_id)",
              "result": {
                "text": "False"
              },
              "tone": "error"
            }
          }
        ]
      },
