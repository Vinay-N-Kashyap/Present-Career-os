    {
      "partTitle": "The follower's consistency check",
      "codeHash": "01b642c332fab6905568fb84afd334b8b5e37075383d5a2ea7b2f78b08baa3df",
      "spec": {
        "template": "compare",
        "title": "Raft follower consistency check matching log prefix against mismatch",
        "leftLabel": "Consistent Prefix Match",
        "rightLabel": "Conflicting Log Mismatch",
        "steps": [
          {
            "at": "say1",
            "caption": "When term differs append_entries replies LOG_MISMATCH.",
            "left": {
              "code": "prev_index term matches follower log",
              "result": {
                "text": "True"
              },
              "tone": "ok"
            },
            "right": {
              "code": "prev_index term mismatch on follower",
              "result": {
                "text": "LOG_MISMATCH"
              },
              "tone": "error"
            }
          },
          {
            "at": "say2",
            "caption": "Otherwise keep prefix add entries and reply match_index.",
            "left": {
              "code": "new_log = log[:prev_index + 1] + list(entries)",
              "result": {
                "text": "True"
              },
              "tone": "ok"
            },
            "right": {
              "code": "drop conflicting tail entries",
              "result": {
                "text": "False"
              },
              "tone": "error"
            }
          },
          {
            "at": "say4",
            "caption": "Entries after prev_index drop stale follower tail.",
            "left": {
              "code": "current leader version accepted",
              "result": {
                "text": "True"
              },
              "tone": "ok"
            },
            "right": {
              "code": "stale entry from old leader dropped",
              "result": {
                "text": "stale"
              },
              "tone": "idle"
            }
          }
        ]
      },
