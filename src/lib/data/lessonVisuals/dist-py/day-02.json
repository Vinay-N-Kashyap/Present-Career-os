              "code": "partition isolated r1 rejects write",
              "result": {
                "text": "REJECTED"
              },
              "tone": "error"
            },
            "right": {
              "code": "partition majority r2+r3 accepts",
              "result": {
                "text": "ACCEPTED"
              },
              "tone": "ok"
            }
          },
          {
            "at": "say4",
            "caption": "AP system keeps answering on both sides.",
