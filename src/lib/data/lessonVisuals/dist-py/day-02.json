              "code": "minority partition rejects write",
              "result": {
                "text": "REJECTED"
              },
              "tone": "error"
            },
            "right": {
              "code": "AP replica r1 accepts update",
              "result": {
                "text": "ACCEPTED"
              },
              "tone": "ok"
            }
          }
        ]
      },
