    {
      "partTitle": "Sampling Strategies: Head-Based vs Tail-Based Sampling",
      "codeHash": "a07116060a2bd41100772b37114de53211110e3eb86a55001f5311ed05b5ce99",
      "spec": {
        "template": "compare",
        "title": "Head-based probabilistic sampling versus tail-based collector sampling",
        "left": {
          "title": "Head-Based Sampling",
          "items": [
            "Decision made at ingress root span",
            "Fixed probabilistic sampling rate",
            "Drops rare errors in unsampled traffic"
          ]
        },
        "right": {
          "title": "Tail-Based Sampling",
          "items": [
            "Buffers spans in memory until completion",
            "Retains all high-latency traces",
            "Saves error traces while dropping routine traffic"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Sampling decisions occur at the root span when entering the gateway.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Tail sampling buffers spans in memory until request completion.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
