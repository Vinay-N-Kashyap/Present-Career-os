    {
      "partTitle": "Exponential Backoff with Full Jitter & Truncated Caps",
      "codeHash": "470152ab2c9dffa58f445fabe939c45035e62a6dcbb80f6f91aeb467e1e1e19c",
      "spec": {
        "template": "workflow",
        "title": "Exponential backoff and randomized full jitter progression",
        "stages": [
          {
            "id": "failedReq",
            "name": "Request Timeout",
            "subtext": "Transient Failure"
          },
          {
            "id": "calcBackoff",
            "name": "Exponential Delay",
            "subtext": "Double Ceiling"
          },
          {
            "id": "applyJitter",
            "name": "Random Full Jitter",
            "subtext": "Uniform Desync"
          },
          {
            "id": "retrySend",
            "name": "Scheduled Retry",
            "subtext": "Dispatched Request"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "Contending clients retry in synchronized waves causing severe load spikes.",
            "activeStageId": "calcBackoff",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Sleep duration is chosen uniformly at random beneath the calculated ceiling.",
            "activeStageId": "applyJitter",
            "statusBadge": "verified"
          }
        ]
      },
