        "template": "compare",
        "title": "At-Least-Once delivery compared to Exactly-Once processing guarantees",
        "leftLabel": "At-Least-Once Delivery Semantics",
        "rightLabel": "Exactly-Once Processing Semantics",
        "steps": [
          {
            "at": "say4",
            "caption": "Mandating retries guarantees that outgoing messages are never lost.",
            "left": {
              "code": "mode: 'AT_LEAST_ONCE'",
              "result": {
                "text": "AT_LEAST_ONCE"
              },
              "tone": "ok"
            },
            "right": {
