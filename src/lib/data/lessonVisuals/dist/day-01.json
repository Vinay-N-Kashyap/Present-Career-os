    {
      "partTitle": "Idempotency Keys & Deduplication in Unreliable Networks",
      "codeHash": "8536d9d19c2e47882b1a72904bc819bf7e91a6acd56a30d71b38eafb654064bb",
      "spec": {
        "template": "sequence",
        "title": "Idempotent request processing and duplicate retry suppression",
        "actors": [
          {
            "id": "client",
            "label": "Web Client"
          },
          {
            "id": "gateway",
            "label": "Payment Gateway"
          },
          {
            "id": "store",
            "label": "Idempotency Store"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "Enterprise systems utilize unique client generated idempotency keys.",
            "messages": [
              {
                "from": "client",
                "to": "gateway",
                "label": "POST /charge (Key: req_abc_123)"
              },
              {
                "from": "gateway",
                "to": "store",
                "label": "Reserve Key req_abc_123"
              }
            ],
            "activeActorId": "gateway"
          },
          {
            "at": "say9",
            "caption": "Duplicate retries bypass execution and return the cached response.",
            "messages": [
              {
                "from": "client",
                "to": "gateway",
                "label": "POST /charge Retry (Key: req_abc_123)"
              },
              {
                "from": "gateway",
                "to": "store",
                "label": "Check Key Status -> COMPLETED"
              },
              {
                "from": "gateway",
                "to": "client",
                "label": "Replay Cached Response (Replay: true)"
              }
            ],
            "activeActorId": "client"
          }
        ]
      },
