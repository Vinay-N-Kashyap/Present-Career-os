    {
      "partTitle": "Client-Side vs Server-Side Service Discovery",
      "codeHash": "252226c09e50587c2ff2847c755c24b4fce457e28f34eac6b600cff1be1a057d",
      "spec": {
        "template": "compare",
        "title": "Client-side discovery versus server-side discovery architecture",
        "left": {
          "title": "Client-Side Discovery",
          "items": [
            "Calling client queries service registry directly",
            "Client executes local load balancing algorithm",
            "Requires discovery language SDK per client"
          ]
        },
        "right": {
          "title": "Server-Side Discovery",
          "items": [
            "Client invokes stable virtual DNS proxy name",
            "Centralized load balancer routes to endpoints",
            "Language agnostic polyglot service design"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "In client side discovery calling clients query the registry directly.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "In server side discovery clients call a stable virtual dns name.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Client-Side Discovery",
        "rightLabel": "Server-Side Discovery"
      },
