          },
          {
            "id": "grpcServer",
            "label": "gRPC Service Backend"
          }
        ],
        "steps": [
          {
            "at": "say2",
            "caption": "Unary mode sends a single request message and receives one response.",
            "messages": [
              {
                "from": "grpcClient",
                "to": "grpcServer",
                "label": "Unary Request (GetUser id=101)"
              },
