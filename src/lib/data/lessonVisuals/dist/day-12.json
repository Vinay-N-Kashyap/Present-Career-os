      "spec": {
        "template": "states",
        "title": "Offset commit timing states and message delivery guarantees",
        "states": [
          {
            "id": "fetched",
            "label": "Message Fetched from Kafka"
          },
          {
            "id": "committedEarly",
            "label": "Offset Committed Before Execution"
          },
          {
            "id": "processingLogic",
            "label": "Business Mutation Executing"
          },
          {
            "id": "committedLate",
            "label": "Offset Committed After Execution"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Consumer commits offset before processing which risks data loss.",
            "activeStateId": "committedEarly",
            "statusBadge": "failed"
          },
          {
            "at": "say5",
            "caption": "Consumer commits offset only after successfully processing the message.",
            "activeStateId": "committedLate",
            "statusBadge": "completed"
          }
        ]
