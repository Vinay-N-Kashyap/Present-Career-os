    {
      "partTitle": "Consumer Group Rebalancing: Eager vs Incremental Cooperative Rebalancing",
      "codeHash": "bbcdf0b592efa8d6321bc52d504ff53be20ffadde417907d87c3769d8a648f69",
      "spec": {
        "template": "compare",
        "title": "Eager rebalancing versus incremental cooperative rebalancing",
        "left": {
          "title": "Eager Rebalance Protocol",
          "items": [
            "All consumers revoke all assignments",
            "Global stop-the-world cluster freeze",
            "Full recalculation of partition ownership"
          ]
        },
        "right": {
          "title": "Cooperative Rebalance Protocol",
          "items": [
            "Consumers keep unaffected partitions",
            "Zero global cluster downtime",
            "Incremental handoff of specific partitions"
          ]
        },
        "steps": [
          {
            "at": "say6",
            "caption": "Under eager rebalancing consumers revoke all assignments and stop.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say9",
            "caption": "Cooperative rebalancing allows healthy consumers to keep processing.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Eager Rebalance Protocol",
        "rightLabel": "Cooperative Rebalance Protocol"
      },
