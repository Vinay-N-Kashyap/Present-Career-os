      "spec": {
        "template": "compare",
        "title": "Single-shard query versus scatter-gather cluster penalty",
        "left": {
          "title": "Targeted Shard Query",
          "items": [
            "Query includes shard key in where clause",
            "Direct single hop to specific physical host",
            "Sub-millisecond query execution latency"
          ]
        },
        "right": {
          "title": "Scatter-Gather Query",
          "items": [
            "Query lacks primary shard key attribute",
            "Broadcasts parallel requests to every shard",
            "Governed by slowest responding tail node"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Router scatters the query in parallel across all cluster shards.",
