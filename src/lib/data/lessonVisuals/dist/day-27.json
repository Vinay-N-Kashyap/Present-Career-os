      "partTitle": "The Consistency Spectrum: Safety vs Performance vs Availability",
      "codeHash": "c8d93f5d7f795ccb2be397d3e78cb587f7d79a9d4a0a075cfc253b3f5e26ee82",
      "spec": {
        "template": "compare",
        "title": "Strong linearizable consistency versus weak eventual consistency spectrum",
        "left": {
          "title": "Strong Linearizability",
          "items": [
            "Instant global real-time ordering",
            "Universal wall-clock consistency guarantees",
            "Requires consensus and synchronous round-trips"
          ]
        },
        "right": {
          "title": "Eventual Consistency",
          "items": [
            "Replicas converge asynchronously over time",
            "Sub-millisecond write response latency",
            "Exposes clients to transient stale reads"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Linearizability guarantees every read reflects the latest write.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
