    {
      "partTitle": "Transient vs Fatal Error Classification",
      "codeHash": "5dd47ae0b25c4703836e40f2abd42cd698b081e425910e7b670a6198287a5df9",
      "spec": {
        "template": "compare",
        "title": "Classification of transient errors versus fatal errors",
        "left": {
          "title": "Transient Errors",
          "items": [
            "Temporary socket timeout or pool exhaustion",
            "Safe to retry with exponential backoff",
            "Expected to recover naturally with time"
          ]
        },
        "right": {
          "title": "Fatal Errors",
          "items": [
            "Malformed JSON syntax or missing schema fields",
            "Retrying causes dangerous crash loops",
            "Must be routed directly to dead letter queue"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Transient errors should be retried with exponential backoff.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Retrying fatal errors wastes compute cycles and causes crash loops.",
            "highlightSide": "right",
            "statusBadge": "failed"
          }
        ],
        "leftLabel": "Transient Errors",
        "rightLabel": "Fatal Errors"
      },
