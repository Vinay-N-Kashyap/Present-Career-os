            "id": "clientReq",
            "label": "Incoming Order Creation Request",
            "status": "completed"
          },
          {
            "id": "dbCommit",
            "label": "Commit Order to Local Database",
            "status": "active"
          },
          {
            "id": "kafkaPublish",
            "label": "Publish Event to Message Broker",
            "status": "pending"
          }
        ],
        "steps": [
