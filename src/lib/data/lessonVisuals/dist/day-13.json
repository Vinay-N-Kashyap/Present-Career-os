    {
      "partTitle": "Natural vs Artificial Idempotency: HTTP Verbs & Deduplication Math",
      "codeHash": "01598d614b756aec9bbdec1959895dc243077b6637061fdaef4c7cb6c04078c6",
      "spec": {
        "template": "compare",
        "title": "Comparison between natural idempotency and artificial idempotency",
        "left": {
          "title": "Naturally Idempotent",
          "items": [
            "Absolute state replacement logic",
            "Standard HTTP verbs like GET PUT and DELETE",
            "Zero extra deduplication storage needed"
          ]
        },
        "right": {
          "title": "Artificially Idempotent",
          "items": [
            "Incremental business operations like POST",
            "Requires explicit idempotency tokens",
            "Relies on deduplication table records"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "Verbs like get put and delete are naturally idempotent by specification.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "Non-idempotent actions require artificial tokens or database unique keys.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Naturally Idempotent",
        "rightLabel": "Artificially Idempotent"
      },
      "filled": {
