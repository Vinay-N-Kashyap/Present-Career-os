    {
      "partTitle": "Cache-Aside (Lazy Loading) vs Write-Through vs Write-Back",
      "codeHash": "4406dd8008f0b35db74a0e36208dc4f4b624a42c2324742ff0c1dbf22bf425e1",
      "spec": {
        "template": "table",
        "title": "Distributed caching access patterns and write synchronization models",
        "columns": [
          "Caching Access Pattern",
          "Read Pathway Flow",
          "Write Pathway Flow",
          "Consistency vs Latency Tradeoff"
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Cache aside queries the cache before requesting from database.",
            "rows": [
              [
                "Cache-Aside (Lazy)",
                "App queries cache -> Miss queries DB -> Populates cache",
                "App writes directly to DB -> Evicts or updates cache",
                "Eventual consistency, zero stale writes on miss"
              ],
              [
                "Write-Through",
                "App queries cache -> Cache loads from DB on miss",
                "App writes to cache -> Cache synchronously writes to DB",
                "Strong consistency, higher write latency"
              ]
            ]
          },
          {
            "at": "say6",
            "caption": "Write through ensures cache and database remain in sync.",
            "rows": [
              [
                "Cache-Aside (Lazy)",
                "App queries cache -> Miss queries DB -> Populates cache",
                "App writes directly to DB -> Evicts or updates cache",
                "Eventual consistency, zero stale writes on miss"
              ],
              [
                "Write-Through",
                "App queries cache -> Cache loads from DB on miss",
                "App writes to cache -> Cache synchronously writes to DB",
                "Strong consistency, higher write latency"
              ],
              [
                "Write-Back (Write-Behind)",
                "App reads exclusively from cache",
                "App writes to cache -> Cache async flushes batches to DB",
                "Ultimate write throughput, data loss risk on crash"
              ]
            ]
          }
        ]
      },
