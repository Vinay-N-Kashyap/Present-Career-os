      "partTitle": "Singleflight Mutex: Suppressing Duplicate Concurrent Backend Misses",
      "codeHash": "03fd95ee3534b7ed8fdd3d640978d7fc553803be02329f47a9c29111813ec558",
      "spec": {
        "template": "sequence",
        "title": "Singleflight mutex duplicate backend call suppression sequence",
        "actors": [
          {
            "id": "clients",
            "label": "Concurrent Clients"
          },
          {
            "id": "singleflight",
            "label": "Singleflight Mutex Group"
          },
          {
            "id": "dbBackend",
            "label": "Primary SQL Database"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Singleflight ensures that only one request hits the database for a key.",
            "messages": [
              {
                "from": "clients",
                "to": "singleflight",
                "label": "4 Concurrent Calls for item:42"
              },
              {
                "from": "singleflight",
                "to": "dbBackend",
                "label": "Single Leader Query for item:42"
              }
            ],
            "activeActorId": "singleflight"
          },
          {
            "at": "say8",
            "caption": "Awaiting requests receive the resolved value simultaneously from cache.",
            "messages": [
              {
                "from": "dbBackend",
                "to": "singleflight",
                "label": "Return PRODUCT_DETAILS_42"
              },
              {
                "from": "singleflight",
                "to": "clients",
                "label": "Broadcast Exact Result to All 4 Clients"
              }
            ],
            "activeActorId": "clients"
          }
        ]
      },
