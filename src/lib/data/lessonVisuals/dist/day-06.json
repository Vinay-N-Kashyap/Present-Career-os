    {
      "partTitle": "Clock Drift, NTP Skew & Kleppmann's Critique of Redlock",
      "codeHash": "f8a04fae1bc438d16b5c027a6b457c974529ea7157e17428ef069d4d88e486a2",
      "spec": {
        "template": "compare",
        "title": "Synchronized monotonic clock operation compared to NTP clock drift jump",
        "leftLabel": "Normal Synchronized Clock Operation",
        "rightLabel": "NTP Skewed Forward Jump",
        "steps": [
          {
            "at": "say2",
            "caption": "Algorithms assuming synchronous clocks face danger from quartz crystal drift.",
            "left": {
              "code": "Normal Clock (10000 < 10500)",
              "result": {
                "text": "true"
              },
              "tone": "ok"
            },
            "right": {
              "code": "NTP Skewed (+800ms -> 10800 > 10500)",
              "result": {
                "text": "false"
              },
              "tone": "warn"
            }
          },
          {
            "at": "say4",
            "caption": "Clock jumps prematurely expire valid leases while clients execute.",
            "left": {
              "code": "activeLock.leaseExpiresAt > adjustedClock",
              "result": {
                "text": "true"
              },
              "tone": "ok"
            },
            "right": {
              "code": "adjustedClock: 10800 > 10500",
              "result": {
                "text": "false"
              },
              "tone": "failed"
            }
          }
        ]
      },
