    {
      "partTitle": "Fencing Tokens: Monotonically Increasing Storage Guards",
      "codeHash": "16e97137cca897d4d2b91d2fd449211cc85b46233458c484f2c14a16ad2c81da",
      "spec": {
        "template": "sequence",
        "title": "Fencing tokens monotonic counter and storage protection sequence",
        "actors": [
          {
            "id": "client1",
            "label": "Client 1 (Delayed GC)"
          },
          {
            "id": "client2",
            "label": "Client 2 (Newer Lock)"
          },
          {
            "id": "storage",
            "label": "Storage Service Guard"
          }
        ],
        "steps": [
          {
            "at": "say3",
            "caption": "Lock servers increment global counters providing monotonic tokens.",
            "messages": [
              {
                "from": "client2",
                "to": "storage",
                "label": "write(data, token=34)"
              },
              {
                "from": "storage",
                "to": "client2",
                "label": "ACCEPTED (Updated to version 2)"
              }
            ],
            "activeActorId": "storage"
          },
          {
            "at": "say7",
            "caption": "The storage engine rejects delayed writes bearing stale fencing tokens.",
            "messages": [
              {
                "from": "client1",
                "to": "storage",
                "label": "write(staleData, token=33)"
              },
              {
                "from": "storage",
                "to": "client1",
                "label": "REJECTED: Stale token 33 < current 34"
              }
            ],
            "activeActorId": "client1"
          }
        ]
      },
