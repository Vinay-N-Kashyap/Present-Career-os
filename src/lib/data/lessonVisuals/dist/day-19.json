    {
      "partTitle": "Read-Your-Own-Writes (RYOW) Consistency Guarantee",
      "codeHash": "9b3aa7394b6d9b1dc810ff78c3a0a120e22d43dba7d20d29a776109f1fad6ceb",
      "spec": {
        "template": "compare",
        "title": "Read-your-own-writes session isolation versus passive reader pool",
        "left": {
          "title": "Author User Session",
          "items": [
            "Queries routed to primary database during lag window",
            "Sees newly committed mutations immediately",
            "Eliminates vanishing post confusion"
          ]
        },
        "right": {
          "title": "Passive Readers Pool",
          "items": [
            "Load balanced across distributed read replicas",
            "Tolerates slight replication lag",
            "Preserves horizontal read cluster capacity"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Guarantees that a user will observe updates from their own writes.",
            "highlightSide": "left",
            "statusBadge": "active"
