      "partTitle": "Monolithic API Gateways vs Backend-For-Frontend (BFF)",
      "codeHash": "372de87007b22a8fc96669ed96908e22f0331f28d02b8312bbd92f0374a9a427",
      "spec": {
        "template": "compare",
        "title": "Monolithic API gateway versus dedicated backend-for-frontend layers",
        "left": {
          "title": "Monolithic API Gateway",
          "items": [
            "Single shared endpoint schema for all clients",
            "Bloated payloads drain mobile smartphone batteries",
            "Team coupling across mobile and web teams"
          ]
        },
        "right": {
          "title": "Backend-For-Frontend (BFF)",
          "items": [
            "Dedicated gateway per client experience platform",
            "Compact optimized responses for mobile devices",
            "Independent frontend team autonomy and deployments"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "Smartphones on cellular data need compact payloads to save battery.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "The backend for frontend pattern builds specialized gateway layers.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Monolithic API Gateway",
        "rightLabel": "Backend-For-Frontend (BFF)"
      },
