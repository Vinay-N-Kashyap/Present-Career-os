      "partTitle": "Sliding Window Metrics: Count-Based vs Time-Based Windows",
      "codeHash": "e88eeeea2487d43a9674bf01801d051463d2415211f2f752c0a4a97ddc1f17c7",
      "spec": {
        "template": "compare",
        "title": "Count-based sliding window versus time-based sliding window",
        "left": {
          "title": "Count-Based Window",
          "items": [
            "Tracks fixed sample of last N requests",
            "Calculates failure rate across bounded calls",
            "Independent of traffic arrival frequency"
          ]
        },
        "right": {
          "title": "Time-Based Window",
          "items": [
            "Tracks requests over trailing time window",
            "Maintains ring buffer of discrete time buckets",
            "Naturally evicts stale idle periods over time"
          ]
        },
        "steps": [
          {
            "at": "say3",
            "caption": "A count based window records the outcomes of recent service calls.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say5",
            "caption": "A time based window records all calls occurring within recent seconds.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
