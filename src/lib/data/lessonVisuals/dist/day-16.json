      "partTitle": "Vector Clocks: Detecting Concurrent Conflicts & Causality",
      "codeHash": "bc5ff1866878aefaf4cfc047972f510f10ba03917007afa9265e4908e1c4015e",
      "spec": {
        "template": "compare",
        "title": "Comparison of Lamport timestamps versus vector clocks",
        "left": {
          "title": "Lamport Timestamps",
          "items": [
            "Single scalar integer per process",
            "Cannot detect true concurrency",
            "Cannot prove reverse causal implication"
          ]
        },
        "right": {
          "title": "Vector Clocks",
          "items": [
            "Array of integer clocks across all nodes",
            "Element-wise comparison verifies causality",
            "Detects concurrent conflicting edits"
          ]
        },
        "steps": [
          {
            "at": "say2",
            "caption": "Every cluster node maintains an array vector of integers.",
            "highlightSide": "right",
            "statusBadge": "active"
          },
          {
