      "partTitle": "Three-State Circuit Breaker Engine: Closed, Open, Half-Open",
      "codeHash": "f970ddea84e0347e052fe50a56a14f84f9ba22869dc18a8ced7963542622e194",
      "spec": {
        "template": "compare",
        "title": "Closed state healthy flow versus open state fail-fast rejection",
        "left": {
          "title": "CLOSED Circuit State",
          "items": [
            "Requests pass through to upstream service",
            "Failures tracked against error threshold",
            "Upstream microservice operates normally"
          ]
        },
        "right": {
          "title": "OPEN Circuit State",
          "items": [
            "All incoming calls fail fast immediately",
            "Zero network traffic reaches wounded upstream",
            "Sleep cooldown timer awaits canary trial"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "In the closed state all requests pass through to the upstream service.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "In open state all incoming calls fail immediately sparing backends.",
            "highlightSide": "right",
            "statusBadge": "failed"
          }
        ]
      },
