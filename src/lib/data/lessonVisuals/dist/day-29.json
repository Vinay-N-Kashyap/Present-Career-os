    {
      "partTitle": "Multi-Region Topologies: Backup & Restore vs Pilot Light vs Warm Standby",
      "codeHash": "75183716b77969d432ab2996730597e6823d48b3805e7f97358f87bb5fdb321f",
      "spec": {
        "template": "compare",
        "title": "Multi-region disaster recovery deployment topologies comparison",
        "left": {
          "title": "Warm Standby",
          "items": [
            "Scaled-down functional copy running continuously",
            "Minutes to autoscale secondary region",
            "Moderate operational cloud cost"
          ]
        },
        "right": {
          "title": "Active-Active Global",
          "items": [
            "Both regions actively handle live production traffic",
            "Zero downtime failover via DNS routing",
            "Highest infrastructure cost with complex conflict rules"
          ]
        },
        "steps": [
          {
            "at": "say5",
            "caption": "Warm standby runs a scaled down functional copy in secondary regions.",
            "highlightSide": "left",
