    {
      "partTitle": "State-Based (CvRDT) vs Operation-Based (CmRDT) CRDTs",
      "codeHash": "4e2609acf445b5b42e68e213c5cd4690341794a8c08bd9f3199aba472a5d347d",
      "spec": {
        "template": "compare",
        "title": "State-based CvRDT versus operation-based CmRDT trade-offs",
        "left": {
          "title": "State-Based CvRDT",
          "items": [
            "Replicas broadcast entire state payloads",
            "Tolerates message drops and duplicates",
            "High bandwidth consumption over time"
          ]
        },
        "right": {
          "title": "Operation-Based CmRDT",
          "items": [
            "Replicas broadcast incremental mutation diffs",
            "Requires exactly-once or causal transport",
            "Extremely low network bandwidth overhead"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "State based types tolerate packet loss and reordering over networks.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "Operation based types require reliable ordered transport for correct delivery.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ]
      },
