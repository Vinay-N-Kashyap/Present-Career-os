    {
      "partTitle": "The Epidemic Gossip Model: Push-Pull State Propagation",
      "codeHash": "a19d0627b6c7c94d8bc366fb9c32daee17984d611aa0caf9374e85edad4480b6",
      "spec": {
        "template": "compare",
        "title": "Push versus pull epidemic gossip propagation models",
        "left": {
          "title": "Push Dissemination Model",
          "items": [
            "Node with new state pushes to random peers",
            "Extremely fast initial viral spread",
            "Slow tail finish as most peers already know"
          ]
        },
        "right": {
          "title": "Pull Dissemination Model",
          "items": [
            "Node polls random peers for unseen versions",
            "Rapid tail completion for lagging nodes",
            "Higher network overhead during initial phase"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "In push gossip a node pushes new state payload to random peers.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say6",
            "caption": "Push pull combines both models exchanging digests and deltas.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Push Dissemination Model",
        "rightLabel": "Pull Dissemination Model"
      },
