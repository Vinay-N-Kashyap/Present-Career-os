      "spec": {
        "template": "states",
        "title": "SWIM incarnation-based suspicion state machine transitions",
        "states": [
          {
            "id": "stateAlive",
            "label": "ALIVE: Node Participating in Cluster"
          },
          {
            "id": "stateSuspect",
            "label": "SUSPECT: Grace Period Timer Active"
          },
          {
            "id": "refutationThaw",
            "label": "REFUTED: Higher Incarnation Overrides"
          },
          {
            "id": "stateDead",
            "label": "DEAD: Permanently Evicted After Timeout"
          }
        ],
        "steps": [
          {
            "at": "say4",
            "caption": "When probes fail the target is marked suspect rather than dead.",
            "activeStateId": "stateSuspect",
            "statusBadge": "active"
          },
          {
            "at": "say7",
            "caption": "If paused the node thaws and issues an incarnation refutation.",
