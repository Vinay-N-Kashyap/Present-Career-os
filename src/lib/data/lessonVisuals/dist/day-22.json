    {
      "partTitle": "SWIM Protocol Mechanics: Direct Ping & Indirect Ping-Req",
      "codeHash": "1cbf0a27de1fd11700191e27fa45f78d5cfa73426d7698e94d54efb13a1e0ad1",
      "spec": {
        "template": "sequence",
        "title": "SWIM failure detection direct probe and indirect ping-req flow",
        "actors": [
          {
            "id": "prober",
            "label": "Probing Node"
          },
          {
            "id": "helperNode",
            "label": "Helper Peer Node"
          },
          {
            "id": "targetNode",
            "label": "Target Peer Node"
          }
        ],
        "messages": [
          {
            "from": "prober",
            "to": "targetNode",
            "label": "Direct Ping over UDP",
            "tone": "data"
          },
          {
            "from": "prober",
            "to": "helperNode",
            "label": "Send Indirect Ping-Req",
            "tone": "data"
          },
          {
            "from": "helperNode",
            "to": "targetNode",
            "label": "Helper Pings Target",
            "tone": "data"
          },
          {
            "from": "targetNode",
            "to": "helperNode",
            "label": "Return Ack to Helper",
            "tone": "ok"
          },
          {
            "from": "helperNode",
            "to": "prober",
            "label": "Relay Ack Back to Prober",
            "tone": "ok"
          }
        ],
        "steps": [
          {
            "at": "say5",
            "caption": "The node sends a direct ping to the target and waits for an ack.",
            "activeMessageIndex": 0,
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "The node selects random helper peers and sends an indirect ping request.",
            "activeMessageIndex": 1,
            "statusBadge": "completed"
          }
        ]
