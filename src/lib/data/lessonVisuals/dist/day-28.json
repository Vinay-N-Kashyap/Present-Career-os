    {
      "partTitle": "Cache Invalidation Patterns: Purge, Soft-Purge & Surrogate Keys (Tags)",
      "codeHash": "9d070b0ab6370d037e99318262107d3e2245c3afa2caac584e5a36c6ab098254",
      "spec": {
        "template": "compare",
        "title": "Naive URL purging versus tag-based surrogate key cache invalidation",
        "left": {
          "title": "Naive URL Purging",
          "items": [
            "Requires tracking all dependent URL paths",
            "High API volume to purge related carousels",
            "Leads to accidental stale edge pages"
          ]
        },
        "right": {
          "title": "Surrogate Keys (Tags)",
          "items": [
            "Origin tags assets with domain identifiers",
            "Single API call invalidates all matching pages",
            "Instant global purge across edge locations"
          ]
        },
        "steps": [
          {
            "at": "say4",
            "caption": "The naive invalidation method purges individual resource urls.",
            "highlightSide": "left",
            "statusBadge": "active"
          },
          {
            "at": "say8",
            "caption": "The origin attaches a surrogate key header identifying domain tags.",
            "highlightSide": "right",
            "statusBadge": "completed"
          }
        ],
        "leftLabel": "Naive URL Purging",
        "rightLabel": "Surrogate Keys (Tags)"
      },
