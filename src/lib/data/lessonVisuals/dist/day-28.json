          },
          {
            "id": "staleServed",
            "label": "Stale Asset Served Instantly"
          },
          {
            "id": "revalidating",
            "label": "Background Origin Fetch in Progress"
          },
          {
            "id": "refreshed",
            "label": "Cache Refreshed with New Payload"
          }
        ],
        "steps": [
