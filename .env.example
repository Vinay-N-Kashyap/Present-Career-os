# =================================================================
# PinIT Career OS — Environment Configuration Template
# Copy this file to .env.local: cp .env.example .env.local
# =================================================================

# ── 1. Backend & Neural Voice Engine ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TTS_API_URL=http://localhost:8000/api/tts
NEXT_PUBLIC_CDN_VOICE_URL=

# ── 2. Supabase Auth & Database (Optional for Demo Mode) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 3. Razorpay Payments (Optional: Defaults to Sandbox Mode) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_DEV_MOCK_PAYMENT=true

# ── 4. App URL ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 5. Authentication & Security Secrets ──
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
CRON_SECRET=your-cron-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
GEMINI_API_KEY=your-gemini-api-key
# Transcript and evidence HMAC signing (required in production — no fallback)
EVIDENCE_SIGNING_SECRET=your-evidence-signing-secret
EXAM_SECRET=your-exam-secret

# ── 6. Firebase App Hosting ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# ── 7. Demo & Development Auth ──
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
# Password for demo Supabase accounts. Used SERVER-SIDE ONLY via /api/auth/demo.
# Never prefix with NEXT_PUBLIC_. Never commit the real value.
DEMO_AUTH_PASSWORD=your-demo-password

# ⚠️ DANGER — ALLOW_DEV_AUTH_BYPASS ⚠️
# Setting this to "true" disables ALL authentication checks for every
# protected route (middleware, requireAuth, all admin APIs).
# NEVER set in production. For local development ONLY.
# Add a second guard (DEV_AUTH_BYPASS_CONFIRM) to prevent accidental enable.
ALLOW_DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_CONFIRM=no

# ── 8. Avatar Mentor V2 Feature Flags ──
NEXT_PUBLIC_AVATAR_V2_ENABLED=true
AVATAR_V2_SERVER_ENABLED=true
